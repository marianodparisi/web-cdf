# Tina/Astro branch
NEXT_PUBLIC_TINA_BRANCH=dev
GITHUB_BRANCH=dev

# Tina self-hosted runtime
# Do not set TINA_PUBLIC_IS_LOCAL=true in Hostinger.
MONGODB_URI=
MONGODB_DB_NAME=tina_cdf
GITHUB_OWNER=marianodparisi
GITHUB_REPO=web-cdf
GITHUB_PERSONAL_ACCESS_TOKEN=test

# Admin login/session
AUTH_SECRET=test
ADMIN_USERNAME=test
ADMIN_EMAIL=test
ADMIN_PASSWORD=test

# Hostinger MySQL database for admin_users
MYSQL_HOST=test
MYSQL_PORT=3306
MYSQL_DATABASE=test
MYSQL_USER=test
MYSQL_PASSWORD=test

# Tina Cloud values are unused by the self-hosted setup, keep blank unless we switch auth mode.
NEXT_PUBLIC_TINA_CLIENT_ID=test
TINA_TOKEN=test
