# Directorio de datos persistente (contenido, historial e imagenes subidas).
# Ruta absoluta fuera de dist/, que se borra en cada deploy. Como es accesible
# por FTP, el backup del contenido es copiar la carpeta content/.
CDF_DATA_DIR=/home/USUARIO/cdf-data

# Sesiones del panel. Poner un valor largo y aleatorio.
AUTH_SECRET=

# Primer usuario admin. Se crea solo si no existe todavia.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MySQL de Hostinger: usuarios y permisos del panel
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
