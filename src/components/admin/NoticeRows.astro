---
/**
 * Novedades como tarjetas: flyer (o el esfumado del ministerio), estado,
 * vencimiento, dónde se ve y acciones. Cada tarjeta abre su modal de edición
 * (`novedad-{slug}-{id}`), que la pantalla renderiza aparte con NoticeModal.
 * `data-state` (publicada / vencida / oculta) lo usan los filtros de arriba.
 */
import type { MinistryNotice } from '../../data/ministries';
import { formatEndDate, isActive } from '../../lib/content/expiry';
import { ministryColors } from '../../data/ministry-colors';

interface Row {
  notice: MinistryNotice;
  ministry: { slug: string; name: string; image?: string };
  /** Posición dentro de su ministerio (para "subir"). */
  index: number;
}

interface Props {
  rows: Row[];
  volver: string;
  /** En la pantalla Novedades se ve de qué ministerio es cada una. */
  showMinistry?: boolean;
}

const { rows, volver, showMinistry = false }: Props = Astro.props;

const daysLeft = (d?: string) => (d ? Math.ceil((new Date(`${d}T23:59:59-03:00`).getTime() - Date.now()) / 86400000) : null);
const soonClass = (d: number | null) => (d !== null && d <= 3 ? 'adm-pill adm-pill--warn' : 'adm-pill');
---

<div class="adm-ncards">
  {rows.map(({ notice, ministry, index }) => {
    const expired = !isActive(notice.endDate);
    const hidden = !notice.showHome && !notice.showPage;
    const state = expired ? 'vencida' : hidden ? 'oculta' : 'publicada';
    const d = daysLeft(notice.endDate);
    return (
      <article class:list={['adm-ncard', state !== 'publicada' && 'is-off']} data-state={state}>
        <button
          type="button"
          class="adm-ncard__img"
          style={`--m: ${ministryColors[ministry.slug] ?? '#c5a059'}`}
          data-modal-open={`novedad-${ministry.slug}-${notice.id}`}
          aria-label={`Editar ${notice.title}`}
        >
          {notice.image ? <img src={notice.image} alt="" loading="lazy" /> : <span class="material-symbols-outlined">newspaper</span>}
          {showMinistry && <span class="adm-ncard__min">{ministry.name}</span>}
        </button>
        <div class="adm-ncard__body">
          <div class="adm-ncard__chips">
            {state === 'publicada' && <span class="adm-pill adm-pill--ok"><i></i>Publicada</span>}
            {state === 'vencida' && <span class="adm-pill">Vencida · no se ve</span>}
            {state === 'oculta' && <span class="adm-pill">No se ve en ningún lado</span>}
            {notice.endDate && !expired && (
              <span class={soonClass(d)}><span class="material-symbols-outlined">event</span>Hasta el {formatEndDate(notice.endDate)}</span>
            )}
          </div>
          <h3>{notice.title}</h3>
          {notice.text && <p>{notice.text}</p>}
          <div class="adm-ncard__where">
            <span class:list={['adm-where', notice.showHome && 'is-on']}><span class="material-symbols-outlined">home</span>Inicio</span>
            <span class:list={['adm-where', notice.showPage && 'is-on']}><span class="material-symbols-outlined">web</span>Su página</span>
          </div>
        </div>
        <div class="adm-ncard__acts">
          {!showMinistry && index > 0 && (
            <form method="POST" action="/api/admin/novedades">
              <input type="hidden" name="accion" value="subir" />
              <input type="hidden" name="ministerio" value={ministry.slug} />
              <input type="hidden" name="id" value={notice.id} />
              <input type="hidden" name="volver" value={volver} />
              <button type="submit" class="adm-icon-btn" title="Subir" aria-label="Subir"><span class="material-symbols-outlined">arrow_upward</span></button>
            </form>
          )}
          <button type="button" class="adm-icon-btn" title="Editar" aria-label="Editar" data-modal-open={`novedad-${ministry.slug}-${notice.id}`}>
            <span class="material-symbols-outlined">edit</span>
          </button>
          <form method="POST" action="/api/admin/novedades">
            <input type="hidden" name="accion" value="borrar" />
            <input type="hidden" name="ministerio" value={ministry.slug} />
            <input type="hidden" name="id" value={notice.id} />
            <input type="hidden" name="volver" value={volver} />
            <button
              type="submit"
              class="adm-icon-btn adm-icon-btn--danger"
              title="Borrar"
              aria-label="Borrar"
              data-confirm={`¿Borrar la novedad "${notice.title}"?`}
              onclick="return confirm(this.dataset.confirm)"
            ><span class="material-symbols-outlined">delete</span></button>
          </form>
        </div>
      </article>
    );
  })}
  <p class="adm-ncards__empty adm-muted" hidden>No hay novedades en este filtro.</p>
</div>
