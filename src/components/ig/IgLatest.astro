---
/**
 * La última publicación de Instagram, tal como se ve en el feed: cabecera con
 * la cuenta, la foto (carrusel deslizable si son varias, video si es reel),
 * los iconos, el texto y la fecha. Todo lleva al post en Instagram.
 *
 * No sabe de dónde vienen los datos: se los pasa `latestInstagram` (hoy una
 * muestra; con la API conectada, el último post real). `variant` lo viste
 * para cada página.
 */
import type { IgAccount, IgPost } from '../../data/instagram';
import '../../styles/ig.css';

interface Props {
  account: IgAccount;
  post: IgPost;
  variant: 'arde' | 'kids';
}

const { account, post, variant }: Props = Astro.props;

const fecha = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', timeZone: 'America/Argentina/Buenos_Aires' });
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<article class={`ig ig--${variant}`} data-ig>
  <header class="ig-head">
    <a class="ig-avatar" href={account.url} {...ext} aria-hidden="true" tabindex="-1"><img src={account.avatar} alt="" /></a>
    <a class="ig-user" href={account.url} {...ext}>{account.username}</a>
    <a class="ig-follow" href={account.url} {...ext}>Seguir</a>
  </header>

  <div class="ig-media">
    {post.type === 'video' && post.video ? (
      <video src={post.video} poster={post.media[0]} muted loop playsinline controls preload="metadata"></video>
    ) : (
      <div class="ig-track" data-ig-track>
        {post.media.map((src) => <img src={src} alt="" loading="lazy" />)}
      </div>
    )}
    {post.type === 'video' && !post.video && (
      <a class="ig-play" href={post.permalink} {...ext} aria-label="Ver el video en Instagram">
        <svg viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" fill="currentColor" /></svg>
      </a>
    )}
    {post.media.length > 1 && post.type === 'carousel' && (
      <>
        <span class="ig-count" data-ig-count>1/{post.media.length}</span>
        <button type="button" class="ig-nav ig-nav--prev" data-ig-step="-1" aria-label="Foto anterior" hidden>‹</button>
        <button type="button" class="ig-nav ig-nav--next" data-ig-step="1" aria-label="Foto siguiente">›</button>
      </>
    )}
  </div>

  <div class="ig-body">
    <div class="ig-actions">
      <a href={post.permalink} {...ext} aria-label="Me gusta en Instagram">
        <svg viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.3 4.5 6.8 4.5c2.1 0 3.5 1.1 5.2 3 1.7-1.9 3.1-3 5.2-3 3.5 0 5.4 3.5 4.1 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
      </a>
      <a href={post.permalink} {...ext} aria-label="Comentar en Instagram">
        <svg viewBox="0 0 24 24"><path d="M20.6 16.3A9 9 0 1 0 17 19.9L21 21z" /></svg>
      </a>
      <a href={post.permalink} {...ext} aria-label="Compartir">
        <svg viewBox="0 0 24 24"><path d="M21.5 2.5 10.8 13.2M21.5 2.5l-6.8 19-3.9-8.3-8.3-3.9z" /></svg>
      </a>
      {post.media.length > 1 && post.type === 'carousel' && (
        <span class="ig-dots" aria-hidden="true">
          {post.media.map((_, d) => <span class={d === 0 ? 'is-on' : ''}></span>)}
        </span>
      )}
      <a class="ig-save" href={post.permalink} {...ext} aria-label="Guardar en Instagram">
        <svg viewBox="0 0 24 24"><path d="M19 21.5 12 15.6l-7 5.9V2.5h14z" /></svg>
      </a>
    </div>

    <p class="ig-caption">
      <a class="ig-caption__user" href={account.url} {...ext}>{account.username}</a> {post.caption}
    </p>
    <time class="ig-date" datetime={post.date}>{fecha.format(new Date(post.date))}</time>
  </div>

  <a class="ig-cta" href={post.permalink} {...ext}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="1" /></svg>
    Ver en Instagram
  </a>
</article>

<script>
  // Carrusel: scroll-snap nativo (se desliza con el dedo); flechas, contador y
  // puntos lo siguen.
  document.querySelectorAll<HTMLElement>('[data-ig]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-ig-track]');
    if (!track) return;
    const total = track.children.length;
    const count = root.querySelector('[data-ig-count]');
    const dots = [...root.querySelectorAll('.ig-dots span')];
    const prev = root.querySelector<HTMLButtonElement>('[data-ig-step="-1"]');
    const next = root.querySelector<HTMLButtonElement>('[data-ig-step="1"]');

    root.querySelectorAll<HTMLElement>('[data-ig-step]').forEach((btn) =>
      btn.addEventListener('click', () =>
        track.scrollBy({ left: Number(btn.dataset.igStep) * track.clientWidth, behavior: 'smooth' }),
      ),
    );
    track.addEventListener(
      'scroll',
      () => {
        const n = Math.round(track.scrollLeft / track.clientWidth);
        if (count) count.textContent = `${n + 1}/${total}`;
        dots.forEach((d, i) => d.classList.toggle('is-on', i === n));
        if (prev) prev.hidden = n === 0;
        if (next) next.hidden = n === total - 1;
      },
      { passive: true },
    );
  });
</script>
