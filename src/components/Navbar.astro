---
import { ministries } from '../data/ministries';

interface Props {
  sticky?: boolean;
  transparent?: boolean;
  logoImageSrc?: string;
  logoLabel?: string;
  logoMode?: 'image' | 'annex';
  logoPanelClass?: string;
  logoRingClass?: string;
  logoTextClass?: string;
  logoAccentClass?: string;
}

const {
  sticky = false,
  transparent = false,
  logoImageSrc = '/brand/logo.png',
  logoLabel = 'Corazon de Fuego',
  logoMode = 'image',
  logoPanelClass = 'bg-transparent',
  logoRingClass = 'border-primary/20',
  logoTextClass = 'text-charcoal',
  logoAccentClass = 'text-primary',
} = Astro.props as Props;
const navbarMinistries = ministries.filter((ministry) => ministry.slug !== 'evangelismo');
const annexLinks = [
  {
    href: '/anexos/ramos-mejia',
    label: 'Ramos Mejía',
    badgeClass: 'text-[#c5a059]',
  },
  {
    href: '/anexos/rojas',
    label: 'Rojas',
    badgeClass: 'text-[#775a19]',
  },
  {
    href: '/anexos/villa-minetti',
    label: 'Villa Minetti',
    badgeClass: 'text-[#8f6b4f]',
  },
  {
    href: '/anexos/palito',
    label: 'Palito',
    badgeClass: 'text-[#b87a3c]',
  },
  {
    href: '/anexos/santos-vega',
    label: 'Santos Vega',
    badgeClass: 'text-[#87a2a6]',
  },
];
---

<nav
  data-animate="nav"
  data-nav-transparent={transparent ? 'true' : undefined}
  data-nav-surface={transparent ? 'dark' : undefined}
  class:list={[
    'top-0 w-full z-50 border-b transition-[background-color,border-color,box-shadow,backdrop-filter] duration-300',
    transparent ? 'fixed bg-transparent border-transparent shadow-none backdrop-blur-0' : 'bg-white/95 backdrop-blur-sm border-gray-100',
    sticky ? 'sticky' : transparent ? undefined : 'relative',
  ]}
>
  {transparent && <div data-nav-scrim aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-[7.5rem]"></div>}
  <div class:list={[
    'relative z-10 mx-auto',
    transparent ? 'w-full max-w-none pl-3 pr-4 sm:pl-4 sm:pr-6 lg:pl-6 lg:pr-8' : 'max-w-7xl px-4 sm:px-6 lg:px-8',
  ]}>
    <div class="flex justify-between items-center h-20">
      <div class="flex-shrink-0 flex items-center gap-3">
        <a href="/" class="inline-flex items-center gap-3">
          {
            logoMode === 'annex' ? (
              <div data-nav-annex-panel class={`rounded-[1.4rem] border px-4 py-3 shadow-sm ${logoPanelClass} ${logoRingClass}`}>
                <p data-nav-annex-accent class={`text-[0.55rem] font-semibold uppercase tracking-[0.28em] ${logoAccentClass}`}>Corazón de Fuego</p>
                <p data-nav-annex-text class={`font-display text-2xl leading-none tracking-tight sm:text-[2rem] ${logoTextClass}`}>{logoLabel}</p>
              </div>
            ) : (
              <img data-nav-logo src={logoImageSrc} alt="Logo Corazon de Fuego" class="h-12 w-auto object-contain transition-[filter] duration-300 sm:h-14" />
            )
          }
        </a>
      </div>
      <div class="hidden md:absolute md:left-1/2 md:flex md:-translate-x-1/2 md:items-center md:justify-center md:space-x-8">
        <a data-animate="nav-link" data-nav-link class="nav-sweep inline-flex items-center justify-center text-center text-xs font-bold tracking-widest uppercase hover:text-primary transition-colors text-charcoal" href="/nosotros">Nosotros</a>
        <a data-animate="nav-link" data-nav-link class="nav-sweep inline-flex items-center justify-center text-center text-xs font-bold tracking-widest uppercase hover:text-primary transition-colors text-charcoal" href="/misiones">Misiones</a>
        <a data-animate="nav-link" data-nav-link class="nav-sweep inline-flex items-center justify-center text-center text-xs font-bold tracking-widest uppercase hover:text-primary transition-colors text-charcoal" href="/evangelismo">Evangelismo</a>
        <div class="relative group">
          <button
            data-animate="nav-link"
            data-nav-link
            type="button"
            class="nav-sweep inline-flex items-center justify-center gap-1 text-center text-xs font-bold tracking-widest uppercase hover:text-primary transition-colors text-charcoal"
            aria-haspopup="true"
          >
            Nuestras Sedes
            <span class="material-symbols-outlined text-base transition-transform duration-200 group-hover:rotate-180">expand_more</span>
          </button>
          <div class="absolute left-1/2 top-full -translate-x-1/2 pt-2 w-60 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto">
            <div class="rounded-2xl border border-gray-200 bg-white shadow-xl p-2">
            {
              annexLinks.map((annex) => (
                <a
                  class="flex items-center gap-3 rounded-xl px-3 py-2 text-[11px] font-bold tracking-widest uppercase text-charcoal hover:bg-gray-100 hover:text-primary transition-colors"
                  href={annex.href}
                >
                  <span class={`inline-flex h-7 w-7 items-center justify-center ${annex.badgeClass}`}>
                    <span class="material-symbols-outlined text-[0.95rem] leading-none">church</span>
                  </span>
                  <span>{annex.label}</span>
                </a>
              ))
            }
            </div>
          </div>
        </div>
        <div class="relative group">
          <button
            data-animate="nav-link"
            data-nav-link
            type="button"
            class="nav-sweep inline-flex items-center justify-center gap-1 text-center text-xs font-bold tracking-widest uppercase hover:text-primary transition-colors text-charcoal"
            aria-haspopup="true"
          >
            Educativos
            <span class="material-symbols-outlined text-base transition-transform duration-200 group-hover:rotate-180">expand_more</span>
          </button>
          <div class="absolute left-1/2 top-full -translate-x-1/2 pt-2 w-60 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto">
            <div class="rounded-2xl border border-gray-200 bg-white shadow-xl p-2">
            <a class="flex items-center gap-2 rounded-xl px-3 py-2 text-[11px] font-bold tracking-widest uppercase text-charcoal hover:bg-gray-100 hover:text-primary transition-colors" href="/institucional/iete">
              <span class="material-symbols-outlined text-base">school</span>
              <span>IETE</span>
            </a>
            <a class="flex items-center gap-2 rounded-xl px-3 py-2 text-[11px] font-bold tracking-widest uppercase text-charcoal hover:bg-gray-100 hover:text-primary transition-colors" href="/institucional/discipulados">
              <span class="material-symbols-outlined text-base">groups</span>
              <span>Discipulados</span>
            </a>
            </div>
          </div>
        </div>
        <div class="relative group">
          <button
            data-animate="nav-link"
            data-nav-link
            type="button"
            class="nav-sweep inline-flex items-center justify-center gap-1 text-center text-xs font-bold tracking-widest uppercase hover:text-primary transition-colors text-charcoal"
            aria-haspopup="true"
          >
            Ministerios
            <span class="material-symbols-outlined text-base transition-transform duration-200 group-hover:rotate-180">expand_more</span>
          </button>
          <div class="absolute left-1/2 top-full -translate-x-1/2 pt-2 w-60 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto">
            <div class="rounded-2xl border border-gray-200 bg-white shadow-xl p-2">
            {
              navbarMinistries.map((ministry) => (
                <a
                  class="flex items-center gap-2 rounded-xl px-3 py-2 text-[11px] font-bold tracking-widest uppercase text-charcoal hover:bg-gray-100 hover:text-primary transition-colors"
                  href={`/ministerios/${ministry.slug}`}
                >
                  <img src={ministry.image} alt={ministry.name} class="h-5 w-5 rounded-full object-cover bg-white border border-gray-200" />
                  <span>{ministry.name}</span>
                </a>
              ))
            }
            </div>
          </div>
        </div>
      </div>
      <div class="md:hidden">
        <button
          id="mobile-menu-button"
          data-nav-link
          data-nav-menu-icon
          class="text-charcoal hover:text-primary focus:outline-none transition-colors"
          aria-label="Abrir menú"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="material-symbols-outlined text-3xl">menu</span>
        </button>
      </div>
    </div>
    <div
      id="mobile-menu"
      class="md:hidden overflow-hidden bg-transparent opacity-0 pointer-events-none transition-[max-height,opacity] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
      style="max-height: 0"
    >
      <div class="flex flex-col gap-2 border-t border-black/5 px-1 pt-2 pb-3">
        <a class="mobile-link px-4 py-3 text-left text-sm font-bold tracking-[0.18em] uppercase text-charcoal hover:text-primary transition-colors" href="/nosotros">Nosotros</a>
        <a class="mobile-link px-4 py-3 text-left text-sm font-bold tracking-[0.18em] uppercase text-charcoal hover:text-primary transition-colors" href="/misiones">Misiones</a>
        <a class="mobile-link px-4 py-3 text-left text-sm font-bold tracking-[0.18em] uppercase text-charcoal hover:text-primary transition-colors" href="/evangelismo">Evangelismo</a>
        <details id="mobile-anexos-menu" data-nav-accordion="mobile" class="mobile-accordion [&_summary::-webkit-details-marker]:hidden">
          <summary class="list-none px-4 py-3 text-sm font-bold tracking-[0.18em] uppercase text-charcoal hover:text-primary transition-colors inline-flex w-full items-center justify-between gap-3 text-left cursor-pointer">
            Nuestras Sedes
            <span data-accordion-icon class="material-symbols-outlined text-base transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]">expand_more</span>
          </summary>
          <div data-accordion-panel class="mobile-accordion-panel">
            <div class="flex flex-col gap-1 pb-1 pl-6">
              {
                annexLinks.map((annex) => (
                  <a
                    class="mobile-link px-2 py-2 text-[12px] font-bold tracking-[0.16em] uppercase text-charcoal hover:text-primary transition-colors inline-flex items-center gap-3"
                    href={annex.href}
                  >
                    <span class={`inline-flex h-7 w-7 items-center justify-center ${annex.badgeClass}`}>
                      <span class="material-symbols-outlined text-[0.95rem] leading-none">church</span>
                    </span>
                    <span>{annex.label}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </details>
        <details id="mobile-institucional-menu" data-nav-accordion="mobile" class="mobile-accordion [&_summary::-webkit-details-marker]:hidden">
          <summary class="list-none px-4 py-3 text-sm font-bold tracking-[0.18em] uppercase text-charcoal hover:text-primary transition-colors inline-flex w-full items-center justify-between gap-3 text-left cursor-pointer">
            Educativos
            <span data-accordion-icon class="material-symbols-outlined text-base transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]">expand_more</span>
          </summary>
          <div data-accordion-panel class="mobile-accordion-panel">
            <div class="flex flex-col gap-1 pb-1 pl-6">
              <a class="mobile-link px-2 py-2 text-[12px] font-bold tracking-[0.16em] uppercase text-charcoal hover:text-primary transition-colors inline-flex items-center gap-2" href="/institucional/iete"><span class="material-symbols-outlined text-base">school</span><span>IETE</span></a>
              <a class="mobile-link px-2 py-2 text-[12px] font-bold tracking-[0.16em] uppercase text-charcoal hover:text-primary transition-colors inline-flex items-center gap-2" href="/institucional/discipulados"><span class="material-symbols-outlined text-base">groups</span><span>Discipulados</span></a>
            </div>
          </div>
        </details>
        <details id="mobile-ministerios-menu" data-nav-accordion="mobile" class="mobile-accordion [&_summary::-webkit-details-marker]:hidden">
          <summary class="list-none px-4 py-3 text-sm font-bold tracking-[0.18em] uppercase text-charcoal hover:text-primary transition-colors inline-flex w-full items-center justify-between gap-3 text-left cursor-pointer">
            Ministerios
            <span data-accordion-icon class="material-symbols-outlined text-base transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]">expand_more</span>
          </summary>
          <div data-accordion-panel class="mobile-accordion-panel">
            <div class="flex flex-col gap-1 pb-1 pl-6">
              {
                navbarMinistries.map((ministry) => (
                  <a
                    class="mobile-link px-2 py-2 text-[12px] font-bold tracking-[0.16em] uppercase text-charcoal hover:text-primary transition-colors inline-flex items-center gap-2"
                    href={`/ministerios/${ministry.slug}`}
                  >
                    <img src={ministry.image} alt={ministry.name} class="h-5 w-5 rounded-full object-cover bg-white border border-gray-200" />
                    <span>{ministry.name}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</nav>

<style is:inline>
  .nav-sweep {
    position: relative;
    overflow: hidden;
    border-radius: 9999px;
    padding: 0.65rem 0.9rem;
    transition:
      color 220ms ease,
      transform 220ms ease;
    isolation: isolate;
  }

  .nav-sweep::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(197 160 89 / 0.16);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-sweep:hover::before,
  .nav-sweep:focus-visible::before,
  .group:hover .nav-sweep::before,
  .group:focus-within .nav-sweep::before {
    transform: scaleX(1);
  }

  .nav-sweep:hover,
  .nav-sweep:focus-visible,
  .group:hover .nav-sweep,
  .group:focus-within .nav-sweep {
    transform: translateY(-1px);
  }

  /* La barra transparente flota sobre el contenido que scrollea debajo. Sin este
     velo los links se superponen con títulos y fotos y no se lee ninguno. */
  [data-nav-scrim] {
    opacity: 1;
    transition: background 300ms ease;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
  }

  nav[data-nav-transparent='true'][data-nav-surface='dark'] [data-nav-scrim] {
    background: linear-gradient(to bottom, rgba(10, 10, 9, 0.68), rgba(10, 10, 9, 0));
  }

  nav[data-nav-transparent='true'][data-nav-surface='light'] [data-nav-scrim] {
    background: linear-gradient(to bottom, rgba(247, 245, 240, 0.9), rgba(247, 245, 240, 0));
  }

  nav[data-mobile-menu-open='true'] [data-nav-scrim] {
    opacity: 0;
  }

  nav[data-nav-transparent='true'][data-nav-surface='dark'] [data-nav-link] {
    color: white;
  }

  nav[data-nav-transparent='true'][data-nav-surface='light'] [data-nav-link] {
    color: rgb(58 58 58);
  }

  nav[data-nav-transparent='true'][data-nav-surface='dark'] [data-nav-logo] {
    filter: brightness(0) invert(1);
  }

  nav[data-mobile-menu-open='true'][data-nav-transparent='true'] [data-nav-logo],
  nav[data-mobile-menu-open='true'] [data-nav-logo] {
    filter: none;
  }

  nav[data-mobile-menu-open='true'] {
    background: white;
    border-bottom-width: 0;
    border-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  body.mobile-menu-open > *:not(nav[data-animate='nav']) {
    filter: blur(6px) saturate(0.95);
    transition:
      filter 520ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 520ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    user-select: none;
  }

  nav[data-nav-transparent='true'][data-nav-surface='dark'] [data-nav-annex-panel] {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.2);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.18);
    backdrop-filter: blur(12px);
  }

  nav[data-nav-transparent='true'][data-nav-surface='light'] [data-nav-annex-panel] {
    background: rgb(255 255 255 / 0.72);
    border-color: rgb(197 160 89 / 0.18);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.08);
    backdrop-filter: blur(12px);
  }

  nav[data-nav-transparent='true'][data-nav-surface='dark'] [data-nav-annex-text] {
    color: white;
  }

  nav[data-nav-transparent='true'][data-nav-surface='light'] [data-nav-annex-text] {
    color: rgb(58 58 58);
  }

  nav[data-nav-transparent='true'][data-nav-surface='dark'] [data-nav-annex-accent] {
    color: rgb(229 231 235);
  }

  nav[data-nav-transparent='true'][data-nav-surface='light'] [data-nav-annex-accent] {
    color: rgb(197 160 89);
  }

  nav[data-mobile-menu-open='true'][data-nav-transparent='true'] [data-nav-link],
  nav[data-mobile-menu-open='true'] [data-nav-link] {
    color: rgb(58 58 58);
  }

  nav[data-mobile-menu-open='true'][data-nav-transparent='true'] [data-nav-menu-icon],
  nav[data-mobile-menu-open='true'] [data-nav-menu-icon] {
    color: rgb(58 58 58);
  }

  nav[data-mobile-menu-open='true'][data-nav-transparent='true'] .mobile-link,
  nav[data-mobile-menu-open='true'][data-nav-transparent='true'] summary,
  nav[data-mobile-menu-open='true'] .mobile-link,
  nav[data-mobile-menu-open='true'] summary {
    color: rgb(58 58 58);
  }

  .mobile-accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 420ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms ease;
  }

  .mobile-accordion-panel > div {
    overflow: hidden;
  }

  .mobile-accordion.is-open .mobile-accordion-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .mobile-accordion.is-open [data-accordion-icon] {
    transform: rotate(180deg);
  }

  /* Al salir del hero la barra deja de flotar y toma fondo propio. Flotando
     sobre el contenido los links se superponían con títulos y fotos.
     Estas reglas van al final a propósito: comparten especificidad con las de
     [data-nav-surface] y tienen que ganarles por orden. */
  nav[data-nav-transparent='true'][data-nav-pinned='true'] {
    background-color: rgba(255, 255, 255, 0.96);
    border-color: rgb(243 244 246);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 24px rgba(17, 17, 16, 0.06);
  }

  nav[data-nav-transparent='true'][data-nav-pinned='true'] [data-nav-link],
  nav[data-nav-transparent='true'][data-nav-pinned='true'] [data-nav-menu-icon] {
    color: rgb(58 58 58);
  }

  nav[data-nav-transparent='true'][data-nav-pinned='true'] [data-nav-logo] {
    filter: none;
  }

  nav[data-nav-transparent='true'][data-nav-pinned='true'] [data-nav-scrim] {
    opacity: 0;
  }
</style>

<script>
  const transparentNav = document.querySelector('[data-nav-transparent="true"]') as HTMLElement | null;
  const nav = document.querySelector('[data-animate="nav"]') as HTMLElement | null;
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const mobileAccordions = [...document.querySelectorAll('details[data-nav-accordion="mobile"]')] as HTMLDetailsElement[];

  const accordionDuration = 420;

  const closeAccordion = (item: HTMLDetailsElement) => {
    if (!item.open) return;
    item.classList.remove('is-open');
    window.setTimeout(() => {
      if (!item.classList.contains('is-open')) item.open = false;
    }, accordionDuration);
  };

  const openAccordion = (item: HTMLDetailsElement) => {
    item.open = true;
    window.requestAnimationFrame(() => item.classList.add('is-open'));
  };

  const setupAccordion = (items: HTMLDetailsElement[]) => {
    items.forEach((item) => {
      const summary = item.querySelector('summary');
      summary?.addEventListener('click', (event) => {
        event.preventDefault();
        if (item.classList.contains('is-open')) {
          closeAccordion(item);
          return;
        }

        items.forEach((other) => {
          if (other !== item) closeAccordion(other);
        });
        openAccordion(item);
      });
    });
  };

  setupAccordion(mobileAccordions);

  if (transparentNav) {
    const resolveSurface = (element: Element | null) => {
      const surfaceHost = element?.closest('[data-nav-surface-zone]') as HTMLElement | null;
      return surfaceHost?.dataset.navSurfaceZone === 'dark' ? 'dark' : 'light';
    };

    const syncTransparentNavSurface = () => {
      const sampleY = Math.max(transparentNav.offsetHeight - 12, 12);
      const samplePoints = [
        window.innerWidth * 0.2,
        window.innerWidth * 0.5,
        window.innerWidth * 0.8,
      ];

      const darkHits = samplePoints.reduce((count, pointX) => {
        const sampledElement = document
          .elementsFromPoint(pointX, sampleY)
          .find((element) => !transparentNav.contains(element));
        return count + (resolveSurface(sampledElement ?? null) === 'dark' ? 1 : 0);
      }, 0);

      transparentNav.dataset.navSurface = darkHits >= 2 ? 'dark' : 'light';
    };

    // Fija la barra recién al terminar el hero. Sin hero (por si alguna página
    // usa transparent sin uno) alcanza con haber scrolleado su propia altura.
    const heroSection = document.querySelector('[data-animate="hero"]') as HTMLElement | null;

    const syncPinnedState = () => {
      const navHeight = transparentNav.offsetHeight;
      const threshold = heroSection
        ? heroSection.getBoundingClientRect().bottom + window.scrollY - navHeight
        : navHeight;
      transparentNav.dataset.navPinned = window.scrollY >= threshold ? 'true' : 'false';
    };

    const syncTransparentNav = () => {
      syncTransparentNavSurface();
      syncPinnedState();
    };

    syncTransparentNav();
    window.addEventListener('scroll', syncTransparentNav, { passive: true });
    window.addEventListener('resize', syncTransparentNav);
  }

  if (button && menu) {
    const closedClasses = ['opacity-0', 'pointer-events-none'];
    const openClasses = ['opacity-100', 'pointer-events-auto'];
    const syncMenuHeight = () => {
      if (button.getAttribute('aria-expanded') === 'true') {
        menu.style.maxHeight = menu.scrollHeight + 'px';
      }
    };
    let menuHeightAnimationFrame = 0;

    const animateMenuHeight = () => {
      window.cancelAnimationFrame(menuHeightAnimationFrame);

      const tick = () => {
        syncMenuHeight();
        if (button.getAttribute('aria-expanded') === 'true') {
          menuHeightAnimationFrame = window.requestAnimationFrame(tick);
        }
      };

      menuHeightAnimationFrame = window.requestAnimationFrame(tick);
      window.setTimeout(() => window.cancelAnimationFrame(menuHeightAnimationFrame), accordionDuration + 120);
    };

    const closeAllAccordions = () => {
      mobileAccordions.forEach(closeAccordion);
    };

    const closeMenu = () => {
      if (nav) nav.dataset.mobileMenuOpen = 'false';
      document.body.classList.remove('mobile-menu-open');
      menu.style.maxHeight = '0px';
      menu.classList.remove(...openClasses);
      menu.classList.add(...closedClasses);
      closeAllAccordions();
    };

    const toggleMenu = () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        closeMenu();
      } else {
        if (nav) nav.dataset.mobileMenuOpen = 'true';
        document.body.classList.add('mobile-menu-open');
        menu.classList.remove(...closedClasses);
        menu.classList.add(...openClasses);
        syncMenuHeight();
      }
    };

    button.addEventListener('click', toggleMenu);
    mobileAccordions.forEach((accordion) => {
      accordion.addEventListener('click', () => {
        animateMenuHeight();
      });
    });
    window.addEventListener('resize', syncMenuHeight);
    menu.querySelectorAll('.mobile-link').forEach((link) => {
      link.addEventListener('click', () => {
        button.setAttribute('aria-expanded', 'false');
        closeMenu();
      });
    });
  }
</script>
