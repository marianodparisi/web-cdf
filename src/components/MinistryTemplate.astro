---
import type { Ministry } from '../data/ministries';
import {
  externalHref,
  hasNotice,
  hasSchedule,
  instagramHref,
  whatsappHref,
} from '../lib/content/ministry-details';

interface Props {
  title: string;
  tagline: string;
  heroImage: string;
  badge: string;
  themeClass?: string;
  intro: string;
  focusTitle: string;
  focusText: string;
  participationTitle: string;
  participationText: string;
  scheduleTitle: string;
  scheduleText: string;
  /** Los datos prácticos que carga quien lidera el ministerio. */
  ministry?: Ministry;
}

const {
  title,
  tagline,
  heroImage,
  badge,
  themeClass = 'bg-[#151514]',
  intro,
  focusTitle,
  focusText,
  participationTitle,
  participationText,
  scheduleTitle,
  scheduleText,
  ministry,
} = Astro.props as Props;

const pillars = [
  { label: focusTitle, text: focusText, index: '01' },
  { label: participationTitle, text: participationText, index: '02' },
  { label: scheduleTitle, text: scheduleText, index: '03' },
];

const mapHref = externalHref(ministry?.mapUrl);
const whatsapp = whatsappHref(ministry?.whatsapp);
const instagram = instagramHref(ministry?.instagram);
const meetingText = [ministry?.meetingDay, ministry?.meetingHours].filter(Boolean).join(' · ');

// La banda de datos prácticos existe sólo si hay algo que mostrar. Un
// ministerio que todavía no cargó nada se ve igual que antes, sin huecos.
const showDetails = Boolean(
  ministry &&
    (hasSchedule(ministry) || ministry.place || mapHref || whatsapp || instagram)
);
const showNotice = Boolean(ministry && hasNotice(ministry));
---

<main data-cinematic-page="ministerio" class="bg-[#11110f]">
  <section data-animate="reveal" data-nav-surface-zone="dark" class={`relative overflow-hidden py-16 text-white md:py-24 ${themeClass}`}>
    <div aria-hidden="true" class="cinematic-orb cinematic-orb--right"></div>
    <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
      <a href="/ministerios" class="editorial-link text-white/70">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Volver a ministerios
      </a>

      <p class="mb-5 mt-10 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
        <span class="h-px w-8 bg-primary/60"></span>
        {badge}
      </p>
      <h1 data-cinematic-heading class="max-w-4xl font-display text-4xl font-semibold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
        {title}
      </h1>
      <p data-cinematic-copy class="mt-7 max-w-2xl text-base leading-relaxed text-white/70 sm:text-lg">{tagline}</p>

      <div data-animate="card" data-cinematic-card class="mt-12 overflow-hidden rounded-smooth">
        <img
          data-cinematic="image"
          src={heroImage}
          alt={`Ministerio ${title}`}
          class="h-[18rem] w-full object-cover [filter:brightness(0.74)_saturate(0.72)_contrast(1.1)] sm:h-[24rem] lg:h-[30rem]"
        />
      </div>
    </div>
  </section>

  {
    showNotice && (
      <section data-animate="reveal" class="border-y border-primary/25 bg-[#f3ede1] py-10 md:py-14">
        <div class="mx-auto grid max-w-[90rem] grid-cols-1 items-center gap-8 px-5 sm:px-6 lg:grid-cols-[1.4fr_0.6fr] lg:px-8">
          <div data-cinematic-copy>
            <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Novedad</p>
            <p class="mt-4 font-display text-2xl font-semibold leading-tight tracking-tight text-charcoal sm:text-3xl">
              {ministry?.noticeTitle}
            </p>
            {ministry?.noticeText && (
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-charcoal/70">{ministry.noticeText}</p>
            )}
          </div>

          {ministry?.photo && (
            <div data-animate="card" data-cinematic-card class="overflow-hidden rounded-smooth">
              <img
                src={ministry.photo}
                alt=""
                class="h-48 w-full object-cover sm:h-56"
              />
            </div>
          )}
        </div>
      </section>
    )
  }

  <section data-animate="reveal" class="cinematic-light-section relative bg-[#e9e4da] py-20 md:py-28">
    <div class="mx-auto grid max-w-[90rem] grid-cols-1 gap-12 px-5 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-20 lg:px-8">
      <div class="border-l-2 border-primary pl-6 sm:pl-8">
        <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Sobre el ministerio</p>
        <h2 data-cinematic-heading class="mt-5 font-display text-3xl font-semibold leading-[1.06] tracking-tight text-charcoal sm:text-4xl">
          {title}
        </h2>
      </div>
      <div data-cinematic-copy class="space-y-6 border-t border-charcoal/15 pt-8 text-base leading-relaxed text-charcoal/75 sm:text-lg">
        <p>{intro}</p>
        <a class="editorial-link text-charcoal" href="/contact">
          Quiero sumarme
          <span class="material-symbols-outlined text-sm">arrow_outward</span>
        </a>
      </div>
    </div>
  </section>

  <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#1a1a18] py-20 text-white md:py-28">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/70 to-transparent"></div>
    <div class="relative mx-auto grid max-w-[90rem] grid-cols-1 gap-5 px-5 sm:px-6 md:grid-cols-3 lg:px-8">
      {
        pillars.map((pillar) => (
          <article data-animate="card" data-cinematic-card class="cinematic-dark-card group flex min-h-64 flex-col border border-white/10 bg-white/[0.035] p-7 transition-colors hover:border-primary/50 hover:bg-white/[0.07] sm:p-9">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-primary">{pillar.label}</p>
            <p class="mt-5 text-sm leading-relaxed text-white/70">{pillar.text}</p>
            <span aria-hidden="true" class="mt-auto pt-10 font-display text-6xl font-bold leading-none tracking-[-0.08em] text-white/[0.045]">
              {pillar.index}
            </span>
          </article>
        ))
      }
    </div>
  </section>

  {
    showDetails && (
      <section data-animate="reveal" class="cinematic-light-section bg-[#e9e4da] py-20 md:py-24">
        <div class="mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">En concreto</p>

          <div
            data-cinematic-copy
            class="mt-10 grid grid-cols-1 gap-10 border-t border-charcoal/15 pt-10 sm:grid-cols-2 lg:grid-cols-3"
          >
            {meetingText && (
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-charcoal/45">Cuándo</p>
                <p class="mt-3 font-display text-xl font-semibold text-charcoal">{meetingText}</p>
              </div>
            )}

            {(ministry?.place || mapHref) && (
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-charcoal/45">Dónde</p>
                {ministry?.place && (
                  <p class="mt-3 whitespace-pre-line text-base leading-relaxed text-charcoal/75">
                    {ministry.place}
                  </p>
                )}
                {mapHref && (
                  <a class="editorial-link mt-4 text-charcoal" href={mapHref} target="_blank" rel="noopener noreferrer">
                    Ver en el mapa
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </a>
                )}
              </div>
            )}

            {(whatsapp || instagram) && (
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-charcoal/45">Contacto</p>
                <div class="mt-3 flex flex-col items-start gap-3">
                  {whatsapp && (
                    <a class="editorial-link text-charcoal" href={whatsapp} target="_blank" rel="noopener noreferrer">
                      Escribir por WhatsApp
                      <span class="material-symbols-outlined text-sm">arrow_outward</span>
                    </a>
                  )}
                  {instagram && (
                    <a class="editorial-link text-charcoal" href={instagram} target="_blank" rel="noopener noreferrer">
                      Instagram
                      <span class="material-symbols-outlined text-sm">arrow_outward</span>
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }
</main>
