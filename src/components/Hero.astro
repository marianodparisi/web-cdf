<header data-animate="hero" data-nav-surface-zone="dark" class="relative isolate h-screen overflow-hidden bg-charcoal [clip-path:inset(0)]">
  <div class="fixed inset-0 z-0 h-screen">
    <video
      class="block h-full w-full object-cover object-center"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      <source src="/home/hero-v1-compressed.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <div class="relative z-10 mx-auto flex h-screen max-w-7xl items-center justify-center px-5 py-0 text-center sm:px-6 lg:px-8">
    <div class="w-full space-y-4 sm:space-y-5">
      <p
        data-animate="hero-late"
        class="text-primary text-[11px] font-semibold uppercase tracking-[0.24em] sm:text-xs"
      >
        iglesia cristiana
      </p>
      <h1
        data-animate="hero-item"
        class="font-display text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl md:text-6xl"
        style="font-family: 'Inter', sans-serif;"
      >
        CORAZÓN DE FUEGO
      </h1>
      <p data-animate="hero-late" class="mx-auto max-w-[18rem] text-sm font-medium leading-relaxed text-white/85 sm:max-w-none sm:text-base">
        <span class="block sm:inline">Horario de Reuniones<span class="hidden sm:inline">:</span></span>
        <span class="hidden sm:inline">&nbsp;</span>
        <span class="block sm:inline">Viernes 20 hs</span>
        <span class="hidden sm:inline">&nbsp;·&nbsp;</span>
        <span class="block sm:inline">Sábados 20 hs</span>
        <span class="hidden sm:inline">&nbsp;·&nbsp;</span>
        <span class="block sm:inline">Domingos 9:30 y 11:00 hs</span>
      </p>
    </div>
  </div>
</header>
