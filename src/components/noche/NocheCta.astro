---
/**
 * Cierre de página: placa de degradé con el título, una línea y los botones
 * (slot default).
 */
interface Props {
  title: string;
  text?: string;
}

const { title, text } = Astro.props;
---

<section class="lz-plate lz-cta">
  <div class="lz-mesh" aria-hidden="true"></div>
  <div class="lz-wrap lz-cta__inner">
    <h2 class="lz-statement__text" data-r>{title}</h2>
    {text && <p class="lz-cta__text" data-r>{text}</p>}
    {Astro.slots.has('default') && (
      <div class="lz-actions lz-actions--center" data-r><slot /></div>
    )}
  </div>
</section>
