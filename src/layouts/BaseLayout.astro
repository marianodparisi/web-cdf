---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Iglesia Corazón de Fuego' } = Astro.props;
---

<!doctype html>
<html class="scroll-smooth" lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/brand/favico.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style is:inline>
      html.js [data-animate='nav'],
      html.js [data-animate='nav-link'],
      html.js [data-animate='hero-item'],
      html.js [data-animate='hero-late'],
      html.js [data-animate='hero-media'],
      html.js [data-animate='reveal'],
      html.js [data-animate='card'],
      html.js [data-animate='footer'],
      html.js [data-animate='social'] {
        opacity: 0;
        visibility: hidden;
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Poppins:wght@400;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="bg-white text-charcoal font-body antialiased selection:bg-primary selection:text-white">
    <slot />
    <script type="module" is:inline>
      const initGsap = async () => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducedMotion) {
          document.documentElement.classList.remove('js');
          return;
        }

        try {
          // El contenido arranca oculto por CSS hasta que GSAP corre. Si el CDN
          // tarda o queda colgado la página se queda en blanco, así que cortamos
          // y mostramos todo sin animar.
          const [{ gsap }, { ScrollTrigger }] = await Promise.race([
            Promise.all([
              import('https://cdn.jsdelivr.net/npm/gsap@3.12.5/index.js'),
              import('https://cdn.jsdelivr.net/npm/gsap@3.12.5/ScrollTrigger.js'),
            ]),
            new Promise((_, reject) => setTimeout(() => reject(new Error('GSAP tardó demasiado')), 2500)),
          ]);

          gsap.registerPlugin(ScrollTrigger);
          gsap.defaults({ duration: 0.9, ease: 'power3.out' });

          const nav = document.querySelector('[data-animate="nav"]');
          if (nav) {
            gsap.fromTo(nav, { y: -24, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.8, ease: 'power2.out' });
          }

          const navLinks = gsap.utils.toArray('[data-animate="nav-link"]');
          if (navLinks.length > 0) {
            gsap.fromTo(navLinks, { y: -12, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.6, stagger: 0.06, delay: 0.2 });
          }

          const heroItems = gsap.utils.toArray('[data-animate="hero-item"]');
          if (heroItems.length > 0) {
            gsap.fromTo(heroItems, { y: 32, autoAlpha: 0 }, { y: 0, autoAlpha: 1, stagger: 0.12, delay: 0.15 });
          }

          const heroLate = gsap.utils.toArray('[data-animate="hero-late"]');
          if (heroLate.length > 0) {
            gsap.fromTo(
              heroLate,
              { y: 14, autoAlpha: 0 },
              {
                y: 0,
                autoAlpha: 1,
                duration: 0.8,
                stagger: 0.12,
                delay: 0.45,
                ease: 'power2.out',
              }
            );
          }

          const heroMedia = document.querySelector('[data-animate="hero-media"]');
          if (heroMedia) {
            gsap.fromTo(heroMedia, { y: 24, scale: 0.96, autoAlpha: 0 }, { y: 0, scale: 1, autoAlpha: 1, duration: 1, delay: 0.25 });
            gsap.to(heroMedia, {
              yPercent: -2,
              scale: 1.04,
              transformOrigin: 'center center',
              ease: 'none',
              scrollTrigger: {
                trigger: heroMedia,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            });
          }

          const sections = gsap.utils.toArray('[data-animate="reveal"]');
          sections.forEach((section) => {
            const isCinematicSection = section.closest('[data-cinematic-page]');
            if (isCinematicSection) {
              gsap.set(section, { y: 0, autoAlpha: 1 });
            } else {
              gsap.fromTo(
                section,
                { y: 52, autoAlpha: 0 },
                {
                  y: 0,
                  autoAlpha: 1,
                  duration: 1,
                  ease: 'power3.out',
                  immediateRender: false,
                  scrollTrigger: {
                    trigger: section,
                    start: 'top 82%',
                    once: true,
                  },
                }
              );
            }

            const cards = section.querySelectorAll('[data-animate="card"]');
            cards.forEach((card) => {
              gsap.fromTo(
                card,
                { y: isCinematicSection ? 40 : 44, autoAlpha: 0, scale: isCinematicSection ? 1 : 0.98 },
                {
                  y: 0,
                  autoAlpha: 1,
                  scale: 1,
                  duration: isCinematicSection ? 0.85 : 0.8,
                  ease: 'power3.out',
                  immediateRender: false,
                  scrollTrigger: {
                    trigger: card,
                    start: 'top 88%',
                    once: true,
                  },
                }
              );
            });
          });

          const seriesCarousel = document.querySelector('[data-series-carousel]');
          if (seriesCarousel) {
            gsap.fromTo(
              seriesCarousel,
              { y: 70, autoAlpha: 0 },
              {
                y: 0,
                autoAlpha: 1,
                duration: 0.9,
                ease: 'power3.out',
                immediateRender: false,
                scrollTrigger: {
                  trigger: seriesCarousel,
                  start: 'top 90%',
                  once: true,
                },
              }
            );

            gsap.to(seriesCarousel, {
              yPercent: -4,
              ease: 'none',
              scrollTrigger: {
                trigger: seriesCarousel,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            });
          }

          const footer = document.querySelector('[data-animate="footer"]');
          if (footer) {
            gsap.fromTo(
              footer,
              { y: 28, autoAlpha: 0 },
              {
                y: 0,
                autoAlpha: 1,
                scrollTrigger: {
                  trigger: footer,
                  start: 'top 90%',
                },
              }
            );
          }

          const socialIcons = gsap.utils.toArray('[data-animate="social"]');
          if (socialIcons.length > 0) {
            gsap.fromTo(socialIcons, { scale: 0.8, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, stagger: 0.08, duration: 0.5, delay: 0.15 });

            socialIcons.forEach((icon) => {
              icon.addEventListener('mouseenter', () => {
                gsap.to(icon, { y: -4, duration: 0.2, ease: 'power2.out' });
              });
              icon.addEventListener('mouseleave', () => {
                gsap.to(icon, { y: 0, duration: 0.25, ease: 'power2.out' });
              });
            });
          }

          const cinematicPage = document.querySelector('[data-cinematic-page]');
          if (cinematicPage) {
            const cinematicHero = cinematicPage.querySelector('[data-animate="hero"]');
            const heroImage = cinematicPage.querySelector('[data-cinematic="hero-image"]');
            const heroGlow = cinematicPage.querySelector('[data-cinematic="hero-glow"]');
            const heroCopy = cinematicPage.querySelector('[data-cinematic="hero-copy"]');
            const heroAside = cinematicPage.querySelector('[data-cinematic="hero-aside"]');
            const heroFooter = cinematicPage.querySelector('[data-cinematic="hero-footer"]');

            if (heroImage) {
              gsap.fromTo(heroImage, { scale: 1.16, autoAlpha: 0.55 }, { scale: 1.05, autoAlpha: 1, duration: 2.1, ease: 'power2.out' });
            }

            const heroTimeline = gsap.timeline({ delay: 0.18 });
            if (heroCopy) heroTimeline.fromTo(heroCopy, { y: 52, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 1.25, ease: 'power4.out' });
            if (heroAside) heroTimeline.fromTo(heroAside, { x: 26, autoAlpha: 0 }, { x: 0, autoAlpha: 1, duration: 0.9, ease: 'power3.out' }, '-=0.65');
            if (heroFooter) heroTimeline.fromTo(heroFooter, { y: 12, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.75, ease: 'power2.out' }, '-=0.42');

            if (cinematicHero && heroImage) {
              gsap.to(heroImage, {
                yPercent: 7,
                ease: 'none',
                scrollTrigger: {
                  trigger: cinematicHero,
                  start: 'top top',
                  end: 'bottom top',
                  scrub: 1,
                },
              });
            }

            if (cinematicHero && heroGlow) {
              gsap.to(heroGlow, {
                xPercent: -22,
                yPercent: 16,
                ease: 'none',
                scrollTrigger: {
                  trigger: cinematicHero,
                  start: 'top top',
                  end: 'bottom top',
                  scrub: 1.4,
                },
              });
            }

            cinematicPage.querySelectorAll('[data-cinematic="image"]').forEach((image) => {
              const frame = image.parentElement;
              if (!frame) return;
              gsap.fromTo(
                image,
                { yPercent: -7, scale: 1.12 },
                {
                  yPercent: 7,
                  scale: 1.04,
                  ease: 'none',
                  scrollTrigger: {
                    trigger: frame,
                    start: 'top bottom',
                    end: 'bottom top',
                    scrub: 1.1,
                  },
                }
              );
            });

            cinematicPage.querySelectorAll('[data-cinematic-heading]').forEach((heading) => {
              gsap.fromTo(
                heading,
                { y: 44, clipPath: 'inset(0 0 100% 0)' },
                {
                  y: 0,
                  clipPath: 'inset(0 0 0% 0)',
                  duration: 1.1,
                  ease: 'power3.out',
                  scrollTrigger: {
                    trigger: heading,
                    start: 'top 85%',
                    once: true,
                  },
                }
              );
            });

            cinematicPage.querySelectorAll('[data-cinematic-copy]').forEach((copyBlock) => {
              const copyItems = [...copyBlock.children];
              if (copyItems.length === 0) return;
              gsap.fromTo(
                copyItems,
                { y: 30, autoAlpha: 0 },
                {
                  y: 0,
                  autoAlpha: 1,
                  stagger: 0.08,
                  duration: 0.8,
                  ease: 'power3.out',
                  scrollTrigger: {
                    trigger: copyBlock,
                    start: 'top 88%',
                    once: true,
                  },
                }
              );
            });

            cinematicPage.querySelectorAll('.mission-media-frame').forEach((mediaFrame) => {
              gsap.fromTo(
                mediaFrame,
                { y: 54, clipPath: 'inset(0 0 100% 0)' },
                {
                  y: 0,
                  clipPath: 'inset(0 0 0% 0)',
                  duration: 1.05,
                  ease: 'power3.out',
                  scrollTrigger: {
                    trigger: mediaFrame,
                    start: 'top 88%',
                    once: true,
                  },
                }
              );
            });

            if (window.matchMedia('(hover: hover)').matches) {
              cinematicPage.querySelectorAll('[data-cinematic-card][data-cinematic-tilt]').forEach((card) => {
                card.addEventListener('pointermove', (event) => {
                  const bounds = card.getBoundingClientRect();
                  const pointerX = (event.clientX - bounds.left) / bounds.width - 0.5;
                  const pointerY = (event.clientY - bounds.top) / bounds.height - 0.5;
                  gsap.to(card, {
                    x: pointerX * 5,
                    y: pointerY * 5 - 3,
                    rotationY: pointerX * 2.2,
                    rotationX: pointerY * -2.2,
                    transformPerspective: 1100,
                    duration: 0.45,
                    ease: 'power2.out',
                    overwrite: 'auto',
                  });
                });

                card.addEventListener('pointerleave', () => {
                  gsap.to(card, {
                    x: 0,
                    y: 0,
                    rotationX: 0,
                    rotationY: 0,
                    duration: 0.75,
                    ease: 'elastic.out(1, 0.52)',
                    overwrite: 'auto',
                  });
                });
              });
            }
          }
        } catch (error) {
          console.warn('GSAP no se pudo cargar:', error);
          document.documentElement.classList.remove('js');
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGsap, { once: true });
      } else {
        initGsap();
      }
    </script>
  </body>
</html>
