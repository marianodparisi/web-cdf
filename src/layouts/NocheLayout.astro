---
/**
 * Layout "noche": el lenguaje del Instagram de la iglesia (degradés difusos
 * oscuros, lockup en minúscula, cita en cursiva, logo con serifa).
 *
 * Arrancó como la maqueta `/maqueta-luz` y pasó a ser el layout de todo el
 * sitio público. Kids y Arde lo usan con `solidNav` y un cuerpo propio.
 *
 * No pasa por BaseLayout: no carga global.css ni GSAP. El movimiento (entradas
 * por tipo, scroll suave y transición entre páginas) vive en scripts/motion.ts
 * y en la sección "Movimiento" de noche.css.
 */
import '../styles/tailwind.css';
import '../styles/noche.css';
import { getMinistries } from '../lib/content/collections';
import DropCard, { type DropCardData } from '../components/noche/DropCard.astro';
import { maquetaAnexos } from '../data/maqueta-anexos';
import { educativos } from '../data/educativos';
import { ministryColors } from '../data/ministry-colors';

interface Props {
  title?: string;
  /** Barra con fondo desde el primer píxel: para páginas de fondo claro
      (Kids, Arde), donde el menú transparente con texto blanco no se lee. */
  solidNav?: boolean;
  /** Tema de la página: agrega `lz--{theme}` al body para que su hoja propia
      tiña el menú, el panel mobile y la letra (Kids, Arde). */
  theme?: string;
}

const { title = 'Iglesia Corazón de Fuego', solidNav = false, theme }: Props = Astro.props;

const ministries = await getMinistries();
const mapsUrl = 'https://maps.app.goo.gl/mEVMgoTXbV3BULVq8';

const sedes = [
  { name: 'Sede Central', href: '/anexos', where: '' },
  { name: 'Ramos Mejía', href: '/anexos/ramos-mejia', where: 'Buenos Aires' },
  { name: 'Rojas', href: '/anexos/rojas', where: 'Buenos Aires' },
  { name: 'Santos Vega', href: '/anexos/santos-vega', where: 'Santa Fe' },
  { name: 'Villa Minetti', href: '/anexos/villa-minetti', where: 'Santa Fe' },
  { name: 'El Palito', href: '/anexos/palito', where: 'Santa Fe' },
];

interface MenuItem {
  title: string;
  sub?: string;
  href: string;
  /** Su tarjeta: se muestra a la derecha al pasar el mouse por el ítem. */
  card?: DropCardData;
}
interface MenuGroup {
  label: string;
  href?: string;
  items?: MenuItem[];
  /** Columnas de la lista dentro del panel. */
  cols?: number;
  all?: { label: string; href: string };
  /** Tarjeta general del menú, la que se ve al abrirlo. */
  feature?: DropCardData;
  /** O, en lugar de una general, la de un ítem (Sedes: Ramos Mejía). */
  defaultItem?: number;
}

const HORARIO_CENTRAL = 'Vie y Sáb 20 hs · Dom 9:30 y 11 hs';
const sedeCard = (sede: (typeof sedes)[number]): DropCardData => {
  const slug = sede.href.split('/').pop();
  const anexo = maquetaAnexos.find((a) => a.slug === slug);
  if (slug === 'ramos-mejia') {
    return { kicker: 'Sede central', title: sede.name, text: HORARIO_CENTRAL, cta: 'Cómo llegar', href: mapsUrl, external: true, color: anexo?.color };
  }
  return {
    kicker: `Anexo · ${sede.where}`,
    title: sede.name,
    text: anexo?.meetingsLines[0] ?? sede.where,
    cta: 'Conocé la sede',
    href: sede.href,
    color: anexo?.color,
  };
};

/* Mismos nombres y destinos que tenía el menú del sitio anterior. Cada
   desplegable es un panel que cuelga de su ítem (con la puntita apuntándolo):
   lista a la izquierda y una tarjeta destacada a la derecha. */
const menu: MenuGroup[] = [
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Misiones', href: '/misiones' },
  { label: 'Evangelismo', href: '/evangelismo' },
  {
    label: 'Nuestras Sedes',
    items: sedes.slice(1).map((sede) => ({ title: sede.name, sub: sede.where, href: sede.href, card: sedeCard(sede) })),
    all: { label: 'Ver todas las sedes', href: '/anexos' },
    defaultItem: 0,
  },
  {
    label: 'Educativos',
    items: [
      {
        title: 'IETE',
        sub: 'Instituto de formación ministerial',
        href: '/institucional/iete',
        card: { kicker: 'Formación ministerial', title: 'IETE', text: educativos.iete.lead, cta: 'Conocé IETE', href: '/institucional/iete', color: educativos.iete.color },
      },
      {
        title: 'Discipulados',
        sub: 'Tus primeros pasos en la fe',
        href: '/institucional/discipulados',
        card: { kicker: 'Formación inicial', title: 'Discipulados', text: educativos.discipulados.lead, cta: 'Conocé Discipulados', href: '/institucional/discipulados', color: educativos.discipulados.color },
      },
    ],
    feature: {
      kicker: '¿Por dónde empiezo?',
      title: 'Discipulados',
      text: 'El primer paso para crecer en la fe, cerca y en grupo.',
      cta: 'Conocé más',
      href: '/institucional/discipulados',
    },
  },
  {
    label: 'Ministerios',
    items: ministries
      .filter((ministry) => ministry.slug !== 'evangelismo')
      .map((ministry) => ({
        title: ministry.name,
        sub: ministry.area,
        href: `/ministerios/${ministry.slug}`,
        card: {
          kicker: ministry.area,
          title: ministry.name,
          text: ministry.excerpt,
          cta: 'Ver ministerio',
          href: `/ministerios/${ministry.slug}`,
          color: ministryColors[ministry.slug],
        },
      })),
    cols: 2,
    all: { label: 'Ver todos los ministerios', href: '/ministerios' },
    feature: {
      kicker: 'Ministerios',
      title: 'Encontrá tu lugar',
      text: 'Hay un espacio para cada etapa: niños, adolescentes, parejas y más.',
      cta: 'Ver todos',
      href: '/ministerios',
    },
  },
];

const footerColumns = [
  {
    header: 'Iglesia',
    links: [
      { label: 'Nosotros', href: '/nosotros' },
      { label: 'Contacto', href: '/contact' },
    ],
  },
  { header: 'Sedes', links: sedes.map((sede) => ({ label: sede.name, href: sede.href })) },
  {
    header: 'Participar',
    links: [
      { label: 'Discipulados', href: '/institucional/discipulados' },
      { label: 'Misiones', href: '/misiones' },
      { label: 'Evangelismo', href: '/evangelismo' },
    ],
  },
  {
    header: 'Contenido',
    links: [
      { label: 'Series', href: '/#series' },
      { label: 'Devocional', href: '/devocional' },
      { label: 'Radio Corazón', href: '/#radio' },
    ],
  },
  {
    header: 'Ministerios',
    links: ministries.map((ministry) => ({ label: ministry.name, href: `/ministerios/${ministry.slug}` })),
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/brand/favico.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;0,700;0,800;0,900;1,500;1,800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>

  <body class={theme ? `lz lz--${theme}` : 'lz'}>
    <div class="lz-grain" aria-hidden="true"></div>

    <header class={`lz-nav${solidNav ? ' lz-nav--solid' : ''}`}>
      <a class="lz-logo lz-logo--nav" href="/" aria-label="Corazón de Fuego, inicio">
        <img src="/brand/logowhite.png" alt="" />
      </a>

      <nav class="lz-nav__links" aria-label="Principal">
        {menu.map((group) =>
          group.items ? (
            <div class="lz-nav__group" data-drop>
              <button type="button" class="lz-nav__item" aria-haspopup="true" aria-expanded="false">
                {group.label}
                <span class="lz-nav__caret" aria-hidden="true"></span>
              </button>
              <div class={`lz-drop${group.feature || group.defaultItem !== undefined ? ' lz-drop--feature' : ''}`}>
                <span class="lz-drop__tip" aria-hidden="true"></span>
                <div class="lz-drop__list">
                  <p class="lz-spaced lz-drop__head">{group.label}</p>
                  <div class="lz-drop__rows" style={`--cols: ${group.cols ?? 1}`}>
                    {group.items.map((item, i) => (
                      <a class={`lz-drop__link${i === group.defaultItem ? ' is-active' : ''}`} href={item.href} data-show={item.card ? String(i) : undefined}>
                        <span class="lz-drop__txt">
                          <span class="lz-drop__title">{item.title}</span>
                          {item.sub && <span class="lz-drop__sub">{item.sub}</span>}
                        </span>
                        <svg class="lz-drop__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                      </a>
                    ))}
                  </div>
                  {group.all && <a class="lz-drop__all" href={group.all.href}>{group.all.label} →</a>}
                </div>
                {(group.feature || group.defaultItem !== undefined) && (
                  <div class="lz-drop__cards" data-cards data-default={group.defaultItem !== undefined ? String(group.defaultItem) : 'default'}>
                    {group.feature && <DropCard card={group.feature} cardKey="default" on={group.defaultItem === undefined} />}
                    {group.items.map((item, i) => item.card && <DropCard card={item.card} cardKey={String(i)} on={i === group.defaultItem} />)}
                  </div>
                )}
              </div>
            </div>
          ) : (
            <a class="lz-nav__item" href={group.href}>{group.label}</a>
          )
        )}
      </nav>

      <div class="lz-nav__utils">
        <a class="lz-btn lz-visit" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          <span class="lz-visit__pin" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          </span>
          <span class="lz-visit__txt"><strong>Visitanos</strong><small>Dom 9:30 y 11 hs</small></span>
        </a>
        <button class="lz-burger" type="button" aria-label="Menú" aria-expanded="false" data-burger>
          <span></span><span></span>
        </button>
      </div>
    </header>

    <!-- Velo: con un desplegable abierto, la página queda tapada detrás. -->
    <div class="lz-scrim" aria-hidden="true"></div>

    <div class="lz-mobile" data-mobile>
      {menu.map((group) =>
        group.items ? (
          <div class="lz-mobile__group">
            <p class="lz-spaced">{group.label}</p>
            {group.items.map((item) => (
              <a href={item.href}>{item.title}</a>
            ))}
          </div>
        ) : (
          <a class="lz-mobile__top" href={group.href}>{group.label}</a>
        )
      )}
    </div>

    <slot />

    <footer class="lz-footer">
      <div class="lz-wrap lz-footer__inner">
        <div class="lz-logo lz-logo--footer" aria-hidden="true"><img src="/brand/logowhite.png" alt="" /></div>
        <div class="lz-footer__grid">
          {footerColumns.map((column) => (
            <div>
              <p class="lz-spaced">{column.header}</p>
              {column.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          ))}
        </div>
        <p class="lz-spaced lz-footer__legal">
          © {new Date().getFullYear()} Iglesia Corazón de Fuego · Ramos Mejía · Buenos Aires
        </p>
      </div>
    </footer>

    <script>
      import { initMotion } from '../scripts/motion';

      // Al bajar el menú se esconde y al subir vuelve: el contenido ocupa la
      // pantalla entera y la navegación sigue a un gesto de distancia. Arriba
      // de todo y con el menú mobile abierto queda siempre visible.
      const nav = document.querySelector('.lz-nav');
      let lastY = window.scrollY;
      const onScroll = () => {
        const y = window.scrollY;
        nav?.classList.toggle('is-scrolled', y > 40);
        if (!document.body.classList.contains('lz-menu-open') && Math.abs(y - lastY) > 6) {
          nav?.classList.toggle('is-hidden', y > lastY && y > 120);
          lastY = y;
        }
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      /* Desplegables: hover en escritorio, y además clic/teclado (y tap en
         tablets). El panel se centra bajo su ítem; si se sale de la pantalla
         se corre, y la puntita se corre al revés para seguir apuntando. */
      const groups = [...document.querySelectorAll<HTMLElement>('[data-drop]')];
      const place = (group: HTMLElement) => {
        const drop = group.querySelector<HTMLElement>('.lz-drop');
        if (!drop) return;
        drop.style.setProperty('--shift', '0px');
        const rect = drop.getBoundingClientRect();
        const margin = 16;
        let shift = 0;
        if (rect.right > innerWidth - margin) shift = innerWidth - margin - rect.right;
        if (rect.left + shift < margin) shift = margin - rect.left;
        drop.style.setProperty('--shift', `${Math.round(shift)}px`);
      };
      /* Al pasar de un menú a otro, el panel nuevo entra desde el lado hacia
         el que se movió el mouse y el anterior sale hacia el otro lado. Se
         detecta porque el anterior se cerró hace un instante. */
      let lastClosed: { group: HTMLElement; at: number } | null = null;
      const clearSlide = (g: HTMLElement) => g.classList.remove('from-left', 'from-right', 'to-left', 'to-right');
      /* Tarjeta de la derecha: al pasar por un ítem entra la suya con un
         barrido diagonal; la anterior queda debajo hasta que termina. Al
         cerrar el menú vuelve la predeterminada, sin animación. */
      const cardTimers = new WeakMap<HTMLElement, number>();
      const showCard = (group: HTMLElement, key: string, instant = false) => {
        const box = group.querySelector<HTMLElement>('[data-cards]');
        if (!box) return;
        const cards = [...box.querySelectorAll<HTMLElement>('[data-card]')];
        const next = cards.find((c) => c.dataset.card === key);
        const cur = cards.find((c) => c.classList.contains('is-on'));
        group.querySelectorAll<HTMLElement>('[data-show]').forEach((l) => l.classList.toggle('is-active', l.dataset.show === key));
        if (!next || next === cur) return;
        window.clearTimeout(cardTimers.get(box));
        cards.forEach((c) => c.classList.remove('is-prev', 'no-anim'));
        if (instant) {
          cur?.classList.remove('is-on');
          next.classList.add('no-anim', 'is-on');
        } else {
          cur?.classList.replace('is-on', 'is-prev');
          void next.offsetWidth;
          next.classList.add('is-on');
          cardTimers.set(box, window.setTimeout(() => cur?.classList.remove('is-prev'), 700));
        }
        cards.forEach((c) => c.setAttribute('tabindex', c === next ? '0' : '-1'));
      };
      groups.forEach((group) => {
        group.querySelectorAll<HTMLElement>('[data-show]').forEach((link) => {
          const go = () => showCard(group, link.dataset.show!);
          link.addEventListener('mouseenter', go);
          link.addEventListener('focus', go);
        });
      });

      const setOpen = (group: HTMLElement, open: boolean) => {
        if (!open && group.classList.contains('is-open')) {
          const box = group.querySelector<HTMLElement>('[data-cards]');
          if (box) window.setTimeout(() => !group.classList.contains('is-open') && showCard(group, box.dataset.default!, true), 300);
        }
        if (open && !group.classList.contains('is-open')) {
          const prev = lastClosed && performance.now() - lastClosed.at < 250 ? lastClosed.group : groups.find((g) => g !== group && g.classList.contains('is-open'));
          groups.forEach(clearSlide);
          if (prev && prev !== group) {
            const right = groups.indexOf(group) > groups.indexOf(prev);
            group.classList.add(right ? 'from-right' : 'from-left');
            prev.classList.add(right ? 'to-left' : 'to-right');
            if (prev.classList.contains('is-open')) setOpen(prev, false);
            setTimeout(() => groups.forEach(clearSlide), 450);
          }
        }
        if (!open && group.classList.contains('is-open')) lastClosed = { group, at: performance.now() };
        group.classList.toggle('is-open', open);
        group.querySelector('.lz-nav__item')?.setAttribute('aria-expanded', String(open));
        if (open) place(group);
        const anyOpen = groups.some((g) => g.classList.contains('is-open'));
        if (anyOpen) document.body.classList.add('lz-drop-open');
        else setTimeout(() => {
          if (!groups.some((g) => g.classList.contains('is-open'))) document.body.classList.remove('lz-drop-open');
        }, 120);
      };
      groups.forEach((group) => {
        group.addEventListener('mouseenter', () => setOpen(group, true));
        group.addEventListener('mouseleave', () => setOpen(group, false));
        group.addEventListener('focusin', () => setOpen(group, true));
        group.addEventListener('focusout', (e) => {
          if (!group.contains(e.relatedTarget as Node)) setOpen(group, false);
        });
        group.querySelector('.lz-nav__item')?.addEventListener('click', () => {
          const open = !group.classList.contains('is-open');
          groups.forEach((g) => g !== group && setOpen(g, false));
          setOpen(group, open);
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') groups.forEach((g) => setOpen(g, false));
      });
      // Si la barra se esconde al bajar, el menú abierto (y el velo) se van con ella.
      window.addEventListener(
        'scroll',
        () => {
          if (nav?.classList.contains('is-hidden')) groups.forEach((g) => g.classList.contains('is-open') && setOpen(g, false));
        },
        { passive: true },
      );
      document.addEventListener('click', (e) => {
        groups.forEach((g) => !g.contains(e.target as Node) && setOpen(g, false));
      });

      const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
      burger?.addEventListener('click', () => {
        const open = document.body.classList.toggle('lz-menu-open');
        burger.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('[data-mobile] a').forEach((link) =>
        link.addEventListener('click', () => document.body.classList.remove('lz-menu-open')),
      );

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      initMotion();

      // Pestañas: cada bloque se resuelve dentro de sí mismo. Los paneles
      // dormidos están en display:none y el observer nunca los vio, así que al
      // abrirlos se revelan a mano.
      document.querySelectorAll('[data-tabs]').forEach((tabs) => {
        tabs.querySelectorAll<HTMLElement>('[data-tab]').forEach((button) => {
          button.addEventListener('click', () => {
            const target = button.dataset.tab;
            tabs.querySelectorAll('[data-tab]').forEach((b) => b.classList.toggle('is-active', b === button));
            tabs.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
              const open = panel.dataset.panel === target;
              panel.classList.toggle('is-active', open);
              if (open) panel.querySelectorAll('[data-r]').forEach((el) => el.classList.add('is-in'));
            });
          });
        });
      });

      // Mapa de destinos: un solo destino activo; hover, foco y tap.
      document.querySelectorAll('[data-mapa]').forEach((mapa) => {
        const puntos = [...mapa.querySelectorAll<HTMLElement>('[data-destino]')];
        const fichas = [...mapa.querySelectorAll<HTMLElement>('[data-ficha]')];
        const activar = (slug?: string) => {
          puntos.forEach((p) => p.classList.toggle('is-active', p.dataset.destino === slug));
          fichas.forEach((f) => f.classList.toggle('is-active', f.dataset.ficha === slug));
        };
        puntos.forEach((punto) =>
          ['mouseenter', 'focus', 'click'].forEach((evt) =>
            punto.addEventListener(evt, () => activar(punto.dataset.destino)),
          ),
        );
      });

      const words = document.querySelectorAll('.lz-rotator__word');
      if (words.length > 1 && !reduce) {
        let current = 0;
        setInterval(() => {
          words[current].classList.remove('is-on');
          current = (current + 1) % words.length;
          words[current].classList.add('is-on');
        }, 2800);
      }
    </script>
  </body>
</html>
