---
/**
 * Cascarón del panel: menú lateral oscuro con "Crear", lo que esa persona
 * puede editar (con cuántas cosas hay publicadas), barra superior con el
 * título y, en celular, barra de abajo con el botón "+". Más los avisos de
 * guardado y los comportamientos compartidos de los formularios.
 *
 * El menú sale de los mismos permisos que protegen cada endpoint: un editor
 * de Kids ve sólo Kids. La estructura vive en `admin.css`.
 */
import '../styles/global.css';
import MinistryLogo from '../components/admin/MinistryLogo.astro';
import '../styles/admin.css';
import type { AdminSession } from '../lib/admin-auth';
import { canEdit } from '../lib/admin-guard';
import { getAnnouncements, getMinistries } from '../lib/content/collections';
import { isActive as isLive } from '../lib/content/expiry';
import { isNoticeLive, noticesOf } from '../lib/content/notices';
import { ministrySectionKey } from '../lib/content/sections';

interface Props {
  title: string;
  /** Vuelve a la pantalla anterior. Sin esto la gente se pierde y cierra sesión. */
  backHref?: string;
  backLabel?: string;
  session: AdminSession;
}

const { title, backHref, backLabel = 'Volver', session } = Astro.props;

const feedback = Astro.url.searchParams.get('ok');
const errorMessage = Astro.url.searchParams.get('error');
const path = Astro.url.pathname;

const [allMinistries, announcements] = await Promise.all([getMinistries(), getAnnouncements()]);
const ministries = allMinistries.filter((m) => canEdit(session, ministrySectionKey(m.slug)));
const liveNotices = (m: (typeof ministries)[number]) => noticesOf(m).filter(isNoticeLive).length;

/* Cada sección muestra cuántas cosas tiene publicadas ahora. */
const contenido: { section: string; href: string; icon: string; label: string; count?: number }[] = [
  { section: 'devocionales', href: '/admin/devocionales', icon: 'menu_book', label: 'Devocionales' },
  { section: 'anuncios', href: '/admin/anuncios', icon: 'campaign', label: 'Anuncios', count: announcements.filter((a) => isLive(a.endDate)).length },
  { section: 'series', href: '/admin/series', icon: 'video_library', label: 'Series' },
].filter((item) => canEdit(session, item.section));
// Novedades: la ve quien tenga al menos un ministerio.
if (ministries.length > 0) {
  contenido.splice(Math.min(2, contenido.length), 0, {
    section: 'novedades',
    href: '/admin/novedades',
    icon: 'newspaper',
    label: 'Novedades',
    count: ministries.reduce((sum, m) => sum + liveNotices(m), 0),
  });
}

/* "Crear": abre directo el modal de alta de cada pantalla. */
const crear = [
  canEdit(session, 'devocionales') && { href: '/admin/devocionales#nuevo-devocional', icon: 'edit_note', label: 'Devocional', color: '#c5a059' },
  ministries.length > 0 && { href: '/admin/novedades#nueva-novedad', icon: 'newspaper', label: 'Novedad', color: '#e8642b' },
  canEdit(session, 'anuncios') && { href: '/admin/anuncios#nuevo', icon: 'campaign', label: 'Anuncio', color: '#48a9ad' },
  canEdit(session, 'series') && { href: '/admin/series#nueva-serie', icon: 'add_photo_alternate', label: 'Serie', color: '#c43b46' },
  session.role === 'admin' && { href: '/admin/usuarios#nueva-persona', icon: 'person_add', label: 'Persona con acceso', color: '#5b6fb5' },
].filter(Boolean) as { href: string; icon: string; label: string; color: string }[];

/* Celular: barra de abajo con Inicio, las dos primeras secciones, "+" y "Más". */
const tabbar = contenido.slice(0, 2);

const isActive = (href: string) => (href === '/admin' ? path === '/admin' || path === '/admin/' : path.startsWith(href));

/* La pestaña del navegador dice dónde estás, sin el saludo: "Panel · CDF" en
   el inicio y "Anuncios · Panel CDF" adentro. */
const isHome = path === '/admin' || path === '/admin/';
const tabTitle = isHome ? 'Panel · CDF' : `${title} · Panel CDF`;


/** Iniciales y un tono estable por nombre, para el avatar. */
const initials = session.username.slice(0, 2).toUpperCase();
const hue = [...session.username].reduce((sum, c) => sum + c.charCodeAt(0), 0) % 360;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tabTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/brand/favico.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
  </head>
  <body class="adm">
    <div class="adm-shell">
      <aside class="adm-side" id="adm-side">
        <a class="adm-brand" href="/admin" aria-label="Inicio del panel">
          <span class="adm-brand__logo"><img src="/brand/logowhite.png" alt="" /></span>
          <span class="adm-brand__tag">Panel</span>
        </a>

        {crear.length > 0 && (
          <details class="adm-create">
            <summary class="adm-create__btn"><span class="material-symbols-outlined">add</span> Crear <span class="material-symbols-outlined adm-create__chev">expand_more</span></summary>
            <div class="adm-create__menu">
              {crear.map((item) => (
                <a href={item.href} style={`--q: ${item.color}`}>
                  <span class="material-symbols-outlined">{item.icon}</span>{item.label}
                </a>
              ))}
            </div>
          </details>
        )}

        <nav class="adm-nav" aria-label="Secciones del panel">
          <a class:list={['adm-nav__link', isActive('/admin') && 'is-active']} href="/admin">
            <span class="material-symbols-outlined">space_dashboard</span> Inicio
          </a>

          {contenido.length > 0 && <p class="adm-nav__label">Contenido</p>}
          {contenido.map((item) => (
            <a class:list={['adm-nav__link', isActive(item.href) && 'is-active']} href={item.href}>
              <span class="material-symbols-outlined">{item.icon}</span> {item.label}
              {item.count ? <em class="adm-nav__count">{item.count}</em> : null}
            </a>
          ))}

          {ministries.length > 0 && <p class="adm-nav__label">Ministerios</p>}
          {ministries.map((m) => (
            <a class:list={['adm-nav__link', isActive(`/admin/ministerios/${m.slug}`) && 'is-active']} href={`/admin/ministerios/${m.slug}`}>
              <MinistryLogo class="adm-nav__logo" slug={m.slug} image={m.image} /> {m.name}
              {liveNotices(m) > 0 && <em class="adm-nav__dot" title="Tiene novedades publicadas"></em>}
            </a>
          ))}

          {session.role === 'admin' && (
            <>
              <p class="adm-nav__label">Administración</p>
              <a class:list={['adm-nav__link', isActive('/admin/usuarios') && 'is-active']} href="/admin/usuarios">
                <span class="material-symbols-outlined">group</span> Personas con acceso
              </a>
            </>
          )}
        </nav>

        <div class="adm-side__foot">
          <a class="adm-user" href="/admin/mi-cuenta" title="Mi cuenta">
            <span class="adm-avatar" style={`--h: ${hue}`}>{initials}</span>
            <span>
              <span class="adm-user__name">{session.username}</span>
              <span class="adm-user__role">{session.role === 'admin' ? 'Administrador' : 'Editor'} · Mi cuenta</span>
            </span>
          </a>
          <div class="adm-side__actions">
            <a href="/" target="_blank" rel="noopener"><span class="material-symbols-outlined">open_in_new</span> Ver el sitio</a>
            <a href="/api/admin/logout"><span class="material-symbols-outlined">logout</span> Salir</a>
          </div>
        </div>
      </aside>

      <div class="adm-main">
        <!-- Celular: marca y avatar arriba; la navegación va en la barra de abajo. -->
        <header class="adm-top">
          <a class="adm-brand__logo" href="/admin" aria-label="Inicio del panel"><img src="/brand/logowhite.png" alt="" /></a>
          <a href="/admin/mi-cuenta" aria-label="Mi cuenta"><span class="adm-avatar" style={`--h: ${hue}`}>{initials}</span></a>
        </header>

        <main class="adm-content">
          <header class="adm-head">
            <div class="adm-head__text">
              {backHref ? (
                <a href={backHref} class="adm-back"><span class="material-symbols-outlined">arrow_back</span>{backLabel}</a>
              ) : (
                <p class="adm-crumb">Panel</p>
              )}
              <h1 class="adm-title">{title}</h1>
            </div>
            <a class="adm-btn adm-btn--ghost adm-head__site" href="/" target="_blank" rel="noopener">
              <span class="material-symbols-outlined">open_in_new</span> Ver el sitio
            </a>
          </header>

          <div class="adm-body">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <nav class="adm-tabbar" aria-label="Navegación">
      <a class:list={[isActive('/admin') && 'is-on']} href="/admin"><span class="material-symbols-outlined">space_dashboard</span>Inicio</a>
      {tabbar.map((item) => (
        <a class:list={[isActive(item.href) && 'is-on']} href={item.href}><span class="material-symbols-outlined">{item.icon}</span>{item.label}</a>
      ))}
      {crear.length > 0 && (
        <button type="button" class="adm-tabbar__add" aria-label="Crear" data-modal-open="adm-crear"><span class="material-symbols-outlined">add</span></button>
      )}
      <button type="button" data-adm-menu aria-controls="adm-side" aria-expanded="false"><span class="material-symbols-outlined">menu</span>Más</button>
    </nav>

    {/* "Crear" en celular: hoja con las mismas opciones que el menú. */}
    {crear.length > 0 && (
      <dialog class="adm-modal adm-sheet-create" id="adm-crear" aria-label="Crear">
        <div class="adm-modal__panel">
          <header class="adm-modal__head">
            <div><h2>Crear</h2><p>Elegí qué querés cargar.</p></div>
            <button type="button" class="adm-modal__x" data-modal-close aria-label="Cerrar"><span class="material-symbols-outlined">close</span></button>
          </header>
          <div class="adm-modal__body adm-create-grid">
            {crear.map((item) => (
              <a href={item.href} style={`--q: ${item.color}`}><span class="material-symbols-outlined">{item.icon}</span>{item.label}</a>
            ))}
          </div>
        </div>
      </dialog>
    )}

    {feedback && (
      <p role="status" class="adm-toast adm-toast--ok" data-adm-toast>
        <span class="material-symbols-outlined">check_circle</span>
        <span>{feedback}</span>
        <button class="adm-toast__close" type="button" aria-label="Cerrar" data-adm-toast-close>
          <span class="material-symbols-outlined">close</span>
        </button>
      </p>
    )}
    {errorMessage && (
      <p role="alert" class="adm-toast adm-toast--err">
        <span class="material-symbols-outlined">error</span>
        <span>{errorMessage}</span>
        <button class="adm-toast__close" type="button" aria-label="Cerrar" data-adm-toast-close>
          <span class="material-symbols-outlined">close</span>
        </button>
      </p>
    )}

    <script>
      // Menú en celular
      const menuButton = document.querySelector<HTMLButtonElement>('[data-adm-menu]');
      menuButton?.addEventListener('click', () => {
        const open = document.body.classList.toggle('adm-menu-open');
        menuButton.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (event) => {
        if (!document.body.classList.contains('adm-menu-open')) return;
        const target = event.target as HTMLElement;
        if (!target.closest('#adm-side') && !target.closest('[data-adm-menu]')) {
          document.body.classList.remove('adm-menu-open');
          menuButton?.setAttribute('aria-expanded', 'false');
        }
      });

      // Avisos: el de éxito se va solo; el de error queda hasta que lo cierren.
      // Se limpia el ?ok= de la URL para que no reaparezca al recargar.
      const closeToast = (toast: Element) => {
        toast.classList.add('is-out');
        window.setTimeout(() => toast.remove(), 300);
      };
      document.querySelectorAll('[data-adm-toast-close]').forEach((button) =>
        button.addEventListener('click', () => closeToast(button.closest('.adm-toast')!)),
      );
      const okToast = document.querySelector('[data-adm-toast]');
      if (okToast) window.setTimeout(() => closeToast(okToast), 4500);
      if (location.search.includes('ok=') || location.search.includes('error=')) {
        history.replaceState(null, '', location.pathname + location.hash);
      }

      // Avisar antes de perder lo escrito. El caso real es alguien que edita un
      // devocional largo en el celular y toca "atrás" sin querer.
      const form = document.querySelector<HTMLFormElement>('form[data-warn-unsaved]');
      if (form) {
        let dirty = false;
        let saving = false;

        form.addEventListener('input', () => {
          dirty = true;
        });
        form.addEventListener('submit', () => {
          saving = true;
        });

        window.addEventListener('beforeunload', (event) => {
          if (!dirty || saving) return;
          event.preventDefault();
          event.returnValue = '';
        });
      }

      // Vista previa inmediata de la foto elegida, antes de guardar.
      document.querySelectorAll<HTMLInputElement>('input[type="file"][data-preview]').forEach((input) => {
        input.addEventListener('change', () => {
          const file = input.files?.[0];
          const previewId = input.dataset.preview;
          if (!file || !previewId) return;

          const preview = document.getElementById(previewId) as HTMLImageElement | null;
          if (!preview) return;

          preview.src = URL.createObjectURL(file);
          preview.classList.remove('hidden');
          preview.previousElementSibling?.classList.add('hidden');
        });
      });

      // Doble submit = dos devocionales iguales. Pasa seguido con conexiones lentas.
      document.querySelectorAll<HTMLFormElement>('form').forEach((element) => {
        element.addEventListener('submit', () => {
          // El setTimeout no es decorativo: varios formularios mandan la acción
          // en el `value` del botón, y si se deshabilita dentro del handler el
          // navegador lo excluye del envío. Recién en el próximo tick el form
          // ya se serializó.
          window.setTimeout(() => {
            element.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach((button) => {
              button.disabled = true;
            });
          }, 0);
        });
      });

      // Selector de secciones: "Todos" / "Ninguno" por grupo.
      document.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((button) => {
        button.addEventListener('click', () => {
          const group = button.closest('.adm-picker__group');
          group?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
            box.checked = button.dataset.pick === 'all';
          });
          group?.closest('form')?.dispatchEvent(new Event('input', { bubbles: true }));
        });
      });

      // Generar contraseña: legible (sin 0/O ni 1/l) para dictarla por teléfono.
      document.querySelectorAll<HTMLButtonElement>('[data-gen-pass]').forEach((button) => {
        button.addEventListener('click', () => {
          const input = document.getElementById(button.dataset.genPass!) as HTMLInputElement | null;
          if (!input) return;
          const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';
          const values = crypto.getRandomValues(new Uint32Array(12));
          input.value = [...values].map((v) => chars[v % chars.length]).join('');
          input.focus();
          input.select();
        });
      });

      // Modales: abrir, cerrar con animación, cerrar tocando afuera. Si el
      // formulario tiene cambios, pregunta antes de descartarlos.
      const isDirty = (dialog: HTMLDialogElement) =>
        [...dialog.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type=hidden]), textarea')].some(
          (el) =>
            el.type === 'checkbox' || el.type === 'radio'
              ? (el as HTMLInputElement).checked !== (el as HTMLInputElement).defaultChecked
              : el.type === 'file'
                ? Boolean((el as HTMLInputElement).files?.length)
                : el.value !== el.defaultValue,
        );
      const closeModal = (dialog: HTMLDialogElement, force = false) => {
        if (!force && isDirty(dialog) && !confirm('¿Cerrar sin guardar? Se pierde lo que escribiste.')) return;
        dialog.querySelector('form')?.reset();
        dialog.classList.add('is-closing');
        window.setTimeout(() => {
          dialog.classList.remove('is-closing');
          dialog.close();
        }, 190);
      };
      document.querySelectorAll<HTMLButtonElement>('[data-modal-open]').forEach((button) => {
        button.addEventListener('click', () => {
          const dialog = document.getElementById(button.dataset.modalOpen!) as HTMLDialogElement | null;
          if (!dialog) return;
          dialog.showModal();
          // preventScroll: sin esto el foco movía el contenido mientras el
          // modal todavía estaba animando la entrada.
          dialog.querySelector<HTMLElement>('input:not([type=hidden]), textarea')?.focus({ preventScroll: true });
        });
      });
      document.querySelectorAll<HTMLDialogElement>('dialog.adm-modal').forEach((dialog) => {
        dialog.querySelectorAll('[data-modal-close]').forEach((b) => b.addEventListener('click', () => closeModal(dialog)));
        // El clic en el fondo oscuro llega al <dialog> mismo, no al panel.
        dialog.addEventListener('mousedown', (event) => {
          if (event.target === dialog) closeModal(dialog);
        });
        // Esc: misma regla que el botón de cerrar.
        dialog.addEventListener('cancel', (event) => {
          event.preventDefault();
          closeModal(dialog);
        });
      });

      // Barra de progreso fina arriba mientras se envía un formulario.
      const progress = document.createElement('div');
      progress.className = 'adm-progress';
      document.body.append(progress);
      document.querySelectorAll('form').forEach((f) =>
        f.addEventListener('submit', () => requestAnimationFrame(() => progress.classList.add('is-on'))),
      );
      window.addEventListener('pageshow', () => progress.classList.remove('is-on'));

      // Abrir un modal desde un link ("Crear" y acciones rápidas: #nueva-serie).
      // También cuando ya estás en esa pantalla y sólo cambia el #.
      const openFromHash = () => {
        const target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
        if (!(target instanceof HTMLDialogElement)) return;
        document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d !== target && d.close());
        if (!target.open) target.showModal();
        history.replaceState(null, '', location.pathname);
      };
      openFromHash();
      window.addEventListener('hashchange', openFromHash);

      // El menú "Crear" se cierra al tocar afuera o elegir una opción.
      const create = document.querySelector<HTMLDetailsElement>('.adm-create');
      document.addEventListener('click', (event) => {
        if (create?.open && !create.contains(event.target as Node)) create.open = false;
      });
      create?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (create.open = false)));

      // Pestañas dentro de un formulario: sólo muestran u ocultan partes; el
      // formulario se manda entero. La pestaña elegida queda en el hash para
      // volver a ella después de guardar.
      document.querySelectorAll<HTMLElement>('[data-admin-tabs]').forEach((tabs) => {
        const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[data-tab-btn]')];
        const panels = [...tabs.querySelectorAll<HTMLElement>('[data-tab-panel]')];
        const show = (name: string, remember = true) => {
          if (!buttons.some((b) => b.dataset.tabBtn === name)) name = buttons[0]?.dataset.tabBtn ?? '';
          buttons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tabBtn === name)));
          panels.forEach((p) => p.classList.toggle('is-on', p.dataset.tabPanel === name));
          if (remember) history.replaceState(null, '', `${location.pathname}#${name}`);
        };
        buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.tabBtn!)));
        show(location.hash.slice(1), false);
        tabs.classList.add('is-ready');
        // Un campo obligatorio vacío en una pestaña oculta bloquea el envío sin
        // que se vea por qué: se abre esa pestaña para que aparezca el aviso.
        tabs.addEventListener(
          'invalid',
          (event) => {
            const panel = (event.target as HTMLElement).closest<HTMLElement>('[data-tab-panel]');
            if (panel && !panel.classList.contains('is-on')) show(panel.dataset.tabPanel!);
          },
          true,
        );
      });

      // "Ver todas" en listas largas
      document.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((button) => {
        button.addEventListener('click', () => {
          button.parentElement?.querySelector('[data-more-list]')?.classList.add('is-all');
          button.remove();
        });
      });

      // Filtro por tipo + buscador (devocionales). Mientras se filtra se ve
      // todo lo que coincide, sin el corte de "Ver más".
      document.querySelectorAll<HTMLElement>('[data-filter-scope]').forEach((scope) => {
        let type = '';
        const searchInput = scope.querySelector<HTMLInputElement>('[data-filter-search]');
        const list = scope.querySelector('[data-more-list]');
        const apply = () => {
          const q = searchInput?.value.trim().toLowerCase() ?? '';
          const filtering = Boolean(type || q);
          scope.classList.toggle('is-filtering', filtering);
          if (filtering) list?.classList.add('is-all');
          else if (scope.querySelector('[data-more]')) list?.classList.remove('is-all');
          let shown = 0;
          scope.querySelectorAll<HTMLElement>('[data-type]').forEach((row) => {
            const ok = (!type || row.dataset.type === type) && (!q || row.dataset.text!.includes(q));
            row.hidden = !ok;
            if (ok) shown++;
          });
          const none = scope.querySelector<HTMLElement>('[data-filter-none]');
          if (none) none.hidden = shown > 0;
        };
        scope.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
          button.addEventListener('click', () => {
            type = button.dataset.filter ?? '';
            scope.querySelectorAll('[data-filter]').forEach((b) => b.classList.toggle('is-on', b === button));
            apply();
          });
        });
        searchInput?.addEventListener('input', apply);
      });

      // Buscador de personas
      const search = document.querySelector<HTMLInputElement>('[data-people-search]');
      search?.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>('[data-person]').forEach((row) => {
          row.classList.toggle('is-hidden', Boolean(q) && !row.dataset.person!.includes(q));
        });
      });
    </script>
  </body>
</html>
