---
/**
 * Cascarón del panel: menú lateral con lo que esa persona puede editar,
 * avisos de guardado y los comportamientos compartidos de los formularios.
 *
 * El menú sale de los mismos permisos que protegen cada endpoint: un editor
 * de Kids ve sólo Kids. Tailwind sigue cargado porque las pantallas lo usan
 * para su contenido; la estructura vive en `admin.css`.
 */
import '../styles/global.css';
import '../styles/admin.css';
import type { AdminSession } from '../lib/admin-auth';
import { canEdit } from '../lib/admin-guard';
import { getMinistries } from '../lib/content/collections';
import { ministrySectionKey } from '../lib/content/sections';

interface Props {
  title: string;
  /** Vuelve a la pantalla anterior. Sin esto la gente se pierde y cierra sesión. */
  backHref?: string;
  backLabel?: string;
  session: AdminSession;
}

const { title, backHref, backLabel = 'Volver', session } = Astro.props;

const feedback = Astro.url.searchParams.get('ok');
const errorMessage = Astro.url.searchParams.get('error');
const path = Astro.url.pathname;

const ministries = (await getMinistries()).filter((m) => canEdit(session, ministrySectionKey(m.slug)));
const contenido = [
  { section: 'devocionales', href: '/admin/devocionales', icon: 'menu_book', label: 'Devocionales' },
  { section: 'anuncios', href: '/admin/anuncios', icon: 'campaign', label: 'Anuncios' },
  { section: 'series', href: '/admin/series', icon: 'video_library', label: 'Series' },
].filter((item) => canEdit(session, item.section));

const isActive = (href: string) => (href === '/admin' ? path === '/admin' || path === '/admin/' : path.startsWith(href));

/** Iniciales y un tono estable por nombre, para el avatar. */
const initials = session.username.slice(0, 2).toUpperCase();
const hue = [...session.username].reduce((sum, c) => sum + c.charCodeAt(0), 0) % 360;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Panel Corazón de Fuego</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/brand/favico.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
  </head>
  <body class="adm">
    <div class="adm-shell">
      <aside class="adm-side" id="adm-side">
        <a class="adm-brand" href="/admin" aria-label="Inicio del panel">
          <span class="adm-brand__logo"><img src="/brand/logowhite.png" alt="" /></span>
          <span class="adm-brand__tag">Panel</span>
        </a>

        <nav class="adm-nav" aria-label="Secciones del panel">
          <a class:list={['adm-nav__link', isActive('/admin') && 'is-active']} href="/admin">
            <span class="material-symbols-outlined">space_dashboard</span> Inicio
          </a>

          {contenido.length > 0 && <p class="adm-nav__label">Contenido</p>}
          {contenido.map((item) => (
            <a class:list={['adm-nav__link', isActive(item.href) && 'is-active']} href={item.href}>
              <span class="material-symbols-outlined">{item.icon}</span> {item.label}
            </a>
          ))}

          {ministries.length > 0 && <p class="adm-nav__label">Ministerios</p>}
          {ministries.map((m) => (
            <a class:list={['adm-nav__link', isActive(`/admin/ministerios/${m.slug}`) && 'is-active']} href={`/admin/ministerios/${m.slug}`}>
              <img class="adm-nav__logo" src={m.image} alt="" /> {m.name}
            </a>
          ))}

          {session.role === 'admin' && (
            <>
              <p class="adm-nav__label">Administración</p>
              <a class:list={['adm-nav__link', isActive('/admin/usuarios') && 'is-active']} href="/admin/usuarios">
                <span class="material-symbols-outlined">group</span> Personas con acceso
              </a>
            </>
          )}
        </nav>

        <div class="adm-side__foot">
          <a class="adm-user" href="/admin/mi-cuenta" title="Mi cuenta">
            <span class="adm-avatar" style={`--h: ${hue}`}>{initials}</span>
            <span>
              <span class="adm-user__name">{session.username}</span>
              <span class="adm-user__role">{session.role === 'admin' ? 'Administrador' : 'Editor'} · Mi cuenta</span>
            </span>
          </a>
          <div class="adm-side__actions">
            <a href="/" target="_blank" rel="noopener"><span class="material-symbols-outlined">open_in_new</span> Ver el sitio</a>
            <a href="/api/admin/logout"><span class="material-symbols-outlined">logout</span> Salir</a>
          </div>
        </div>
      </aside>

      <div class="adm-main">
        <header class="adm-top">
          <button class="adm-top__menu" type="button" aria-label="Abrir el menú" aria-controls="adm-side" aria-expanded="false" data-adm-menu>
            <span class="material-symbols-outlined">menu</span>
          </button>
          <a class="adm-brand__logo" href="/admin" aria-label="Inicio del panel"><img src="/brand/logowhite.png" alt="" /></a>
          <a href="/admin/mi-cuenta" aria-label="Mi cuenta"><span class="adm-avatar" style={`--h: ${hue}`}>{initials}</span></a>
        </header>

        <main class="adm-content">
          {backHref && (
            <a href={backHref} class="adm-back">
              <span class="material-symbols-outlined">arrow_back</span>
              {backLabel}
            </a>
          )}

          <h1 class="adm-title">{title}</h1>

          <div class="adm-body">
            <slot />
          </div>
        </main>
      </div>
    </div>

    {feedback && (
      <p role="status" class="adm-toast adm-toast--ok" data-adm-toast>
        <span class="material-symbols-outlined">check_circle</span>
        <span>{feedback}</span>
        <button class="adm-toast__close" type="button" aria-label="Cerrar" data-adm-toast-close>
          <span class="material-symbols-outlined">close</span>
        </button>
      </p>
    )}
    {errorMessage && (
      <p role="alert" class="adm-toast adm-toast--err">
        <span class="material-symbols-outlined">error</span>
        <span>{errorMessage}</span>
        <button class="adm-toast__close" type="button" aria-label="Cerrar" data-adm-toast-close>
          <span class="material-symbols-outlined">close</span>
        </button>
      </p>
    )}

    <script>
      // Menú en celular
      const menuButton = document.querySelector<HTMLButtonElement>('[data-adm-menu]');
      menuButton?.addEventListener('click', () => {
        const open = document.body.classList.toggle('adm-menu-open');
        menuButton.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (event) => {
        if (!document.body.classList.contains('adm-menu-open')) return;
        const target = event.target as HTMLElement;
        if (!target.closest('#adm-side') && !target.closest('[data-adm-menu]')) {
          document.body.classList.remove('adm-menu-open');
          menuButton?.setAttribute('aria-expanded', 'false');
        }
      });

      // Avisos: el de éxito se va solo; el de error queda hasta que lo cierren.
      // Se limpia el ?ok= de la URL para que no reaparezca al recargar.
      const closeToast = (toast: Element) => {
        toast.classList.add('is-out');
        window.setTimeout(() => toast.remove(), 300);
      };
      document.querySelectorAll('[data-adm-toast-close]').forEach((button) =>
        button.addEventListener('click', () => closeToast(button.closest('.adm-toast')!)),
      );
      const okToast = document.querySelector('[data-adm-toast]');
      if (okToast) window.setTimeout(() => closeToast(okToast), 4500);
      if (location.search.includes('ok=') || location.search.includes('error=')) {
        history.replaceState(null, '', location.pathname);
      }

      // Avisar antes de perder lo escrito. El caso real es alguien que edita un
      // devocional largo en el celular y toca "atrás" sin querer.
      const form = document.querySelector<HTMLFormElement>('form[data-warn-unsaved]');
      if (form) {
        let dirty = false;
        let saving = false;

        form.addEventListener('input', () => {
          dirty = true;
        });
        form.addEventListener('submit', () => {
          saving = true;
        });

        window.addEventListener('beforeunload', (event) => {
          if (!dirty || saving) return;
          event.preventDefault();
          event.returnValue = '';
        });
      }

      // Vista previa inmediata de la foto elegida, antes de guardar.
      document.querySelectorAll<HTMLInputElement>('input[type="file"][data-preview]').forEach((input) => {
        input.addEventListener('change', () => {
          const file = input.files?.[0];
          const previewId = input.dataset.preview;
          if (!file || !previewId) return;

          const preview = document.getElementById(previewId) as HTMLImageElement | null;
          if (!preview) return;

          preview.src = URL.createObjectURL(file);
          preview.classList.remove('hidden');
          preview.previousElementSibling?.classList.add('hidden');
        });
      });

      // Doble submit = dos devocionales iguales. Pasa seguido con conexiones lentas.
      document.querySelectorAll<HTMLFormElement>('form').forEach((element) => {
        element.addEventListener('submit', () => {
          // El setTimeout no es decorativo: varios formularios mandan la acción
          // en el `value` del botón, y si se deshabilita dentro del handler el
          // navegador lo excluye del envío. Recién en el próximo tick el form
          // ya se serializó.
          window.setTimeout(() => {
            element.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach((button) => {
              button.disabled = true;
            });
          }, 0);
        });
      });

      // Selector de secciones: "Todos" / "Ninguno" por grupo.
      document.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((button) => {
        button.addEventListener('click', () => {
          const group = button.closest('.adm-picker__group');
          group?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
            box.checked = button.dataset.pick === 'all';
          });
          group?.closest('form')?.dispatchEvent(new Event('input', { bubbles: true }));
        });
      });

      // Generar contraseña: legible (sin 0/O ni 1/l) para dictarla por teléfono.
      document.querySelectorAll<HTMLButtonElement>('[data-gen-pass]').forEach((button) => {
        button.addEventListener('click', () => {
          const input = document.getElementById(button.dataset.genPass!) as HTMLInputElement | null;
          if (!input) return;
          const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';
          const values = crypto.getRandomValues(new Uint32Array(12));
          input.value = [...values].map((v) => chars[v % chars.length]).join('');
          input.focus();
          input.select();
        });
      });

      // Buscador de personas
      const search = document.querySelector<HTMLInputElement>('[data-people-search]');
      search?.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>('[data-person]').forEach((row) => {
          row.classList.toggle('is-hidden', Boolean(q) && !row.dataset.person!.includes(q));
        });
      });
    </script>
  </body>
</html>
