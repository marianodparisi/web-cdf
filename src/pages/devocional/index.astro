---
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDevotionals } from '../../lib/content/collections';

const devotionalPosts = await getDevotionals();
const currentPost = devotionalPosts[0];
const previousPosts = devotionalPosts.slice(1);

const getYouTubeEmbedUrl = (videoUrl?: string) => {
  if (!videoUrl) return null;
  try {
    const url = new URL(videoUrl);
    const idFromPath = url.pathname.startsWith('/live/') ? url.pathname.split('/live/')[1] : null;
    const idFromQuery = url.searchParams.get('v');
    const videoId = idFromQuery || idFromPath;
    return videoId ? `https://www.youtube.com/embed/${videoId}` : videoUrl;
  } catch {
    return videoUrl;
  }
};

const currentEmbedUrl = getYouTubeEmbedUrl(currentPost?.videoUrl);
---

<BaseLayout title="Devocional y Testimonios | Iglesia Corazon de Fuego">
  <Navbar />

  <main data-cinematic-page="devocional" class="bg-[#11110f]">
    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#151514] py-20 text-white md:py-28">
      <div aria-hidden="true" class="cinematic-orb cinematic-orb--left"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
          <span class="h-px w-8 bg-primary/60"></span>
          Contenido semanal
        </p>
        <h1 data-cinematic-heading class="max-w-4xl font-display text-4xl font-semibold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Una palabra para caminar la semana.
        </h1>
        <p data-cinematic-copy class="mt-7 max-w-2xl text-base leading-relaxed text-white/70 sm:text-lg">
          Video y palabra escrita para acompañar el devocional diario.
        </p>
      </div>
    </section>

    {currentPost && (
      <section data-animate="reveal" class="cinematic-light-section relative bg-[#e9e4da] py-20 md:py-28">
        <div class="mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
          <div class="mb-10 flex flex-wrap items-center gap-4 border-b border-charcoal/15 pb-6">
            <span class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Devocional actual</span>
            <span class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-charcoal/45">{currentPost.weekLabel}</span>
          </div>

          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
            <div>
              <div data-animate="card" data-cinematic-card class="overflow-hidden rounded-smooth">
                {currentEmbedUrl ? (
                  <iframe
                    class="aspect-video w-full"
                    src={currentEmbedUrl}
                    title={currentPost.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                ) : (
                  <img src={currentPost.image} alt={currentPost.title} class="aspect-video w-full object-cover [filter:saturate(0.8)_contrast(1.04)]" />
                )}
              </div>
              <h2 data-cinematic-heading class="mt-8 font-display text-3xl font-semibold leading-tight tracking-tight text-charcoal sm:text-4xl">
                {currentPost.title}
              </h2>
              <p class="mt-4 text-base leading-relaxed text-charcoal/70">{currentPost.excerpt}</p>
            </div>

            <article data-animate="card" data-cinematic-card class="cinematic-paper-card bg-[#faf8f3] p-7 sm:p-10">
              <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Devocional escrito</p>
              <div data-cinematic-copy class="mt-7 space-y-5 text-base leading-relaxed text-charcoal/75">
                {currentPost.content.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          </div>
        </div>
      </section>
    )}

    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#1a1a18] py-20 text-white md:py-28">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/70 to-transparent"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <h2 data-cinematic-heading class="mb-12 font-display text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl md:mb-16">
          Devocionales anteriores
        </h2>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
          {
            previousPosts.map((post) => (
              <a
                data-animate="card"
                data-cinematic-card
                href={`/devocional/${post.slug}`}
                class="group flex flex-col"
              >
                <div class="relative aspect-[16/10] overflow-hidden rounded-soft">
                  <img
                    src={post.image}
                    alt={post.title}
                    class="h-full w-full object-cover transition-[filter,transform] duration-700 ease-out [filter:brightness(0.68)_saturate(0.55)_contrast(1.08)] group-hover:scale-[1.03] group-hover:[filter:brightness(0.9)_saturate(0.9)_contrast(1.04)]"
                  />
                </div>
                <div class="flex flex-1 flex-col pt-6">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">{post.type}</span>
                    {post.videoUrl && <span class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-white/40">Video</span>}
                  </div>
                  <h3 class="mt-3 font-display text-2xl leading-tight text-white transition-colors group-hover:text-primary">{post.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-white/60">{post.excerpt}</p>
                  <span class="editorial-link mt-6 text-white/80">
                    Ver historia
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
