---
/**
 * Listado de devocional, en el lenguaje noche. Arriba la placa de la semana,
 * como la del feed; abajo los anteriores con pestañas por tipo.
 */
import NocheLayout from '../../layouts/NocheLayout.astro';
import NocheCta from '../../components/noche/NocheCta.astro';
import { getDevotionals } from '../../lib/content/collections';

const posts = await getDevotionals();
const [destacado, ...resto] = posts;

// Las pestañas salen de los tipos que realmente hay cargados.
const tipos = [...new Set(posts.map((p) => p.type))];
const tabs = [
  { id: 'todos', label: 'Todos', items: resto },
  // "Devocional" → "Devocionales": el plural en -s daba "Devocionals".
  ...tipos.map((t) => ({
    id: t.toLowerCase(),
    label: /[aeiou]$/i.test(t) ? `${t}s` : `${t}es`,
    items: resto.filter((p) => p.type === t),
  })),
];

const getYouTubeEmbedUrl = (videoUrl?: string) => {
  if (!videoUrl) return null;
  try {
    const url = new URL(videoUrl);
    const idFromPath = url.pathname.startsWith('/live/') ? url.pathname.split('/live/')[1] : null;
    const videoId = url.searchParams.get('v') || idFromPath;
    return videoId ? `https://www.youtube.com/embed/${videoId}` : videoUrl;
  } catch {
    return videoUrl;
  }
};
const embed = getYouTubeEmbedUrl(destacado?.videoUrl);
---

<NocheLayout title="Devocional · Iglesia Corazón de Fuego">
  <!-- La placa de la semana a sangre: es la pieza del feed hecha portada. -->
  <header class="lz-plate lz-phero">
    <div class="lz-mesh" aria-hidden="true"></div>
    <div>
      <p class="lz-quote" data-r>
        Una palabra para la semana.
        {' '}<strong>Textos y testimonios para sostener el caminar de todos los días.</strong>
      </p>
    </div>
    <div class="lz-phero__center">
      <span class="lz-spaced lz-phero__kicker" data-r>Contenido</span>
      <h1 class="lz-lockup lz-lockup--xl" data-r>
        <span>devocional</span>
        <span class="lz-lockup__shift">semanal</span>
      </h1>
    </div>
    <div class="lz-logo lz-logo--foot" aria-hidden="true"><img src="/brand/logowhite.png" alt="" /></div>
  </header>

  {destacado && (
    <section class="lz-section lz-dark">
      <div class="lz-wrap lz-split">
        <div>
          <span class="lz-spaced lz-kicker" data-r>Esta semana</span>
          <h2 class="lz-title" data-r>{destacado.title}</h2>
          <span class="lz-spaced" style="display:block; margin-top: 16px; color: var(--soft)" data-r>
            {destacado.type} · {destacado.weekLabel}
          </span>
          <p class="lz-body" style="margin-top: 22px" data-r>{destacado.excerpt}</p>
          <div class="lz-actions" style="margin-top: 28px" data-r>
            <a class="lz-btn" href={`/devocional/${destacado.slug}`}>Leer completo</a>
          </div>
        </div>
        <div data-r>
          {embed ? (
            <div class="lz-embed">
              <iframe
                src={embed}
                title={destacado.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          ) : (
            <a class="lz-card__img" href={`/devocional/${destacado.slug}`} style="display:block; aspect-ratio: 16/10">
              <img src={destacado.image} alt={destacado.title} loading="lazy" />
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="lz-section lz-dark lz-dark--2">
    <div class="lz-wrap">
      <h2 class="lz-lockup lz-lockup--md" style="margin-bottom: 40px" data-r><span>anteriores</span></h2>
      <div data-tabs>
        <div class="lz-tabs__menu">
          {tabs.map((t, i) => (
            <button class={`lz-tabs__link${i === 0 ? ' is-active' : ''}`} type="button" data-tab={t.id}>
              {t.label}
            </button>
          ))}
        </div>
        {tabs.map((t, i) => (
          <div class={`lz-tabs__panel${i === 0 ? ' is-active' : ''}`} data-panel={t.id}>
            {t.items.length === 0 ? (
              <p class="lz-body">Todavía no hay contenido en esta categoría.</p>
            ) : (
              <div class="lz-cards">
                {t.items.map((p) => (
                  <a class="lz-card" href={`/devocional/${p.slug}`} data-r>
                    <div class="lz-card__img"><img src={p.image} alt={p.title} loading="lazy" /></div>
                    <span class="lz-spaced">{p.type} · {p.weekLabel}</span>
                    <h3>{p.title}</h3>
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <NocheCta title="Nos vemos el fin de semana." text="Viernes y sábados 20 hs · Domingos 9:30 y 11:00 hs.">
    <a class="lz-btn" href="https://maps.app.goo.gl/mEVMgoTXbV3BULVq8" target="_blank" rel="noopener noreferrer">Tu primera vez</a>
    <a class="lz-btn lz-btn--ghost" href="/contact">Escribinos</a>
  </NocheCta>
</NocheLayout>
