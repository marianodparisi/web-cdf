---
/**
 * Artículo de devocional, en el lenguaje noche: encabezado sobre el degradé,
 * cuerpo en columna angosta y relacionados al pie.
 */
import NocheLayout from '../../layouts/NocheLayout.astro';
import NocheCta from '../../components/noche/NocheCta.astro';
import { getDevotionals } from '../../lib/content/collections';

const { slug } = Astro.params;
const posts = await getDevotionals();

const index = posts.findIndex((p) => p.slug === slug);
const post = posts[index];
if (!post) return Astro.redirect('/devocional');

const next = posts[(index + 1) % posts.length];
const relacionados = posts.filter((p) => p.slug !== slug).slice(0, 3);

const getYouTubeEmbedUrl = (videoUrl?: string) => {
  if (!videoUrl) return null;
  try {
    const url = new URL(videoUrl);
    const idFromPath = url.pathname.startsWith('/live/') ? url.pathname.split('/live/')[1] : null;
    const videoId = url.searchParams.get('v') || idFromPath;
    return videoId ? `https://www.youtube.com/embed/${videoId}` : videoUrl;
  } catch {
    return videoUrl;
  }
};
const embed = getYouTubeEmbedUrl(post.videoUrl);
---

<NocheLayout title={`${post.title} · Iglesia Corazón de Fuego`}>
  <header class="lz-plate lz-phero lz-phero--short">
    <div class="lz-mesh" aria-hidden="true"></div>
    <div>
      <a class="lz-back" href="/devocional">← Devocional</a>
    </div>
    <div class="lz-phero__center">
      <span class="lz-spaced lz-phero__kicker" data-r>{post.type} · {post.weekLabel}</span>
      <h1 class="lz-statement__text" style="max-width: 18ch" data-r>{post.title}</h1>
      <p class="lz-quote" style="text-align: left" data-r>{post.excerpt}</p>
    </div>
    <div class="lz-logo lz-logo--foot" aria-hidden="true"><img src="/brand/logowhite.png" alt="" /></div>
  </header>

  <div class="lz-dark" style="padding-top: clamp(56px, 7vw, 96px)">
    <div class="lz-article-media" data-r>
      {embed ? (
        <div class="lz-embed">
          <iframe
            src={embed}
            title={post.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        <img src={post.image} alt={post.title} />
      )}
    </div>

    {/* Columna de ~68 caracteres: el ancho donde el ojo no se pierde al
        saltar de renglón. */}
    <article class="lz-article">
      {post.content.map((parrafo) => <p>{parrafo}</p>)}
    </article>
  </div>

  <section class="lz-section lz-dark">
    <div class="lz-wrap">
      <div class="lz-head">
        <h2 class="lz-lockup lz-lockup--md" data-r>
          <span>seguir</span>
          <span class="lz-lockup__shift">leyendo</span>
        </h2>
        <div class="lz-actions" data-r>
          <a class="lz-btn lz-btn--ghost" href="/devocional">Ver todos</a>
        </div>
      </div>
      <div class="lz-cards">
        {relacionados.map((p) => (
          <a class="lz-card" href={`/devocional/${p.slug}`} data-r>
            <div class="lz-card__img"><img src={p.image} alt={p.title} loading="lazy" /></div>
            <span class="lz-spaced">{p.type} · {p.weekLabel}</span>
            <h3>{p.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <NocheCta
    title="Te esperamos."
    text="Viernes y sábados 20 hs · Domingos 9:30 y 11:00 hs."
    next={{ label: 'Siguiente', title: next.title, href: `/devocional/${next.slug}` }}
  >
    <a class="lz-btn" href="https://maps.app.goo.gl/mEVMgoTXbV3BULVq8" target="_blank" rel="noopener noreferrer">Tu primera vez</a>
  </NocheCta>
</NocheLayout>
