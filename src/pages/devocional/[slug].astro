---
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import { devotionalPosts } from '../../data/devotionals';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Se mantiene para cuando la ruta se prerenderice. Con salida `server` Astro lo
// ignora y `Astro.props` llega vacío, así que el post se resuelve desde el
// parámetro: de lo contrario toda la sección devuelve 500.
export function getStaticPaths() {
  return devotionalPosts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const post = devotionalPosts.find((item) => item.slug === Astro.params.slug);

if (!post) {
  return new Response(null, { status: 404, statusText: 'Devocional no encontrado' });
}

const relatedPosts = devotionalPosts.filter((item) => item.slug !== post.slug).slice(0, 3);
const pageTitle = `${post.title} | Devocional CDF`;
---

<BaseLayout title={pageTitle}>
  <Navbar />

  <main data-cinematic-page="devocional-detalle" class="bg-[#11110f]">
    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#151514] py-16 text-white md:py-24">
      <div aria-hidden="true" class="cinematic-orb cinematic-orb--right"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <a href="/devocional" class="editorial-link text-white/70">
          <span class="material-symbols-outlined text-sm">arrow_back</span>
          Volver a devocional
        </a>

        <p class="mb-5 mt-10 flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
          <span class="h-px w-8 bg-primary/60"></span>
          {post.type}
          <span class="text-white/35">{post.weekLabel}</span>
        </p>
        <h1 data-cinematic-heading class="max-w-4xl font-display text-4xl font-semibold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
          {post.title}
        </h1>

        <div data-animate="card" data-cinematic-card class="mt-12 overflow-hidden rounded-smooth">
          <img
            data-cinematic="image"
            src={post.image}
            alt={post.title}
            class="h-[18rem] w-full object-cover [filter:brightness(0.74)_saturate(0.72)_contrast(1.1)] sm:h-[24rem] lg:h-[30rem]"
          />
        </div>
      </div>
    </section>

    <section data-animate="reveal" class="cinematic-light-section relative bg-[#e9e4da] py-20 md:py-28">
      <div class="mx-auto grid max-w-[90rem] grid-cols-1 gap-12 px-5 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20 lg:px-8">
        <div class="border-l-2 border-primary pl-6 sm:pl-8">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">En resumen</p>
          <p class="mt-5 font-display text-2xl leading-snug text-charcoal sm:text-3xl">{post.excerpt}</p>
          {post.videoUrl && (
            <a
              href={post.videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="editorial-link mt-8 text-charcoal"
            >
              Ver video
              <span class="material-symbols-outlined text-sm">arrow_outward</span>
            </a>
          )}
        </div>
        <div data-cinematic-copy class="space-y-6 border-t border-charcoal/15 pt-8 text-base leading-relaxed text-charcoal/75 sm:text-lg">
          {post.content.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#1a1a18] py-20 text-white md:py-28">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/70 to-transparent"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <div class="mb-12 flex flex-wrap items-end justify-between gap-6 md:mb-16">
          <h2 data-cinematic-heading class="font-display text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl">
            Más contenido semanal
          </h2>
          <a href="/devocional" class="editorial-link text-white/70">
            Ver todos
            <span class="material-symbols-outlined text-sm">arrow_outward</span>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 lg:gap-6">
          {
            relatedPosts.map((item) => (
              <a
                data-animate="card"
                data-cinematic-card
                href={`/devocional/${item.slug}`}
                class="group flex flex-col"
              >
                <div class="relative aspect-[16/10] overflow-hidden rounded-soft">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="h-full w-full object-cover transition-[filter,transform] duration-700 ease-out [filter:brightness(0.68)_saturate(0.55)_contrast(1.08)] group-hover:scale-[1.03] group-hover:[filter:brightness(0.9)_saturate(0.9)_contrast(1.04)]"
                  />
                </div>
                <div class="flex flex-1 flex-col pt-6">
                  <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">{item.weekLabel}</p>
                  <h3 class="mt-3 font-display text-xl leading-tight text-white transition-colors group-hover:text-primary">{item.title}</h3>
                  <p class="mt-3 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-white/40">{item.type}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
