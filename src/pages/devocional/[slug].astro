---
/**
 * MAQUETA — artículo de devocional. Estructura de sus páginas de artículo:
 * encabezado con metadatos, cuerpo en columna angosta y relacionados al pie.
 */
import MaquetaLayout from '../../layouts/MaquetaLayout.astro';
import { getDevotionals } from '../../lib/content/collections';

const { slug } = Astro.params;
const posts = await getDevotionals();

const index = posts.findIndex((p) => p.slug === slug);
const post = posts[index];
if (!post) return Astro.redirect('/devocional');

const next = posts[(index + 1) % posts.length];
const relacionados = posts.filter((p) => p.slug !== slug).slice(0, 3);

const getYouTubeEmbedUrl = (videoUrl?: string) => {
  if (!videoUrl) return null;
  try {
    const url = new URL(videoUrl);
    const idFromPath = url.pathname.startsWith('/live/') ? url.pathname.split('/live/')[1] : null;
    const videoId = url.searchParams.get('v') || idFromPath;
    return videoId ? `https://www.youtube.com/embed/${videoId}` : videoUrl;
  } catch {
    return videoUrl;
  }
};
const embed = getYouTubeEmbedUrl(post.videoUrl);
---

<MaquetaLayout title={`${post.title} · Iglesia Corazón de Fuego`}>
  <div class="as-ministry" style="--m: #c5a059">
    <!-- ══════════ ENCABEZADO ══════════ Columna angosta, centrada. -->
    <header class="as-article-head">
      <a class="as-back" href="/devocional">
        <span class="material-symbols-outlined">arrow_back</span>
        Devocional
      </a>
      <p class="as-item__meta" data-reveal>{post.type} · {post.weekLabel}</p>
      <h1 class="as-article-title" data-reveal="words">{post.title}</h1>
      <p class="as-lead" data-reveal>{post.excerpt}</p>
    </header>

    <div class="as-article-media" data-reveal>
      {embed ? (
        <div class="as-embed">
          <iframe
            src={embed}
            title={post.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        <div class="as-image as-image--wide">
          <img src={post.image} alt={post.title} />
        </div>
      )}
    </div>

    <!-- ══════════ CUERPO ══════════
         Columna de ~68 caracteres: es el ancho donde el ojo no se pierde al
         saltar de renglón. Más ancho cansa, más angosto corta el ritmo. -->
    <article class="as-article">
      {post.content.map((parrafo) => <p>{parrafo}</p>)}
    </article>

    <section class="as-section as-section--light">
      <div class="as-wrap">
        <div class="as-head">
          <div>
            <p class="as-eyebrow" data-reveal>Seguir leyendo</p>
            <h2 class="as-h1" data-reveal="words">Otros devocionales</h2>
          </div>
          <a class="as-button as-button--small" href="/devocional">Ver todos</a>
        </div>
        <div class="as-collection">
          {relacionados.map((p) => (
            <a class="as-item" href={`/devocional/${p.slug}`}>
              <div class="as-image as-image--square">
                <img src={p.image} alt={p.title} loading="lazy" />
              </div>
              <p class="as-item__meta">{p.type} · {p.weekLabel}</p>
              <h3 class="as-item__title">{p.title}</h3>
              <span class="as-item__view">Leer</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="as-section as-section--dark as-cta">
      <div class="as-wrap">
        <h2 class="as-display" data-reveal="words">Te esperamos.</h2>
        <p data-reveal>Viernes y sábados 20 hs · Domingos 9:30 y 11:00 hs.</p>
        <div class="as-button-group" data-reveal data-reveal-delay="120">
          <a class="as-button as-button--white" href="https://maps.app.goo.gl/mEVMgoTXbV3BULVq8" target="_blank" rel="noopener noreferrer">Tu primera vez</a>
        </div>

        <a class="as-next" href={`/devocional/${next.slug}`}>
          <span>Siguiente</span>
          <strong>{next.title}</strong>
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
    </section>
  </div>
</MaquetaLayout>
