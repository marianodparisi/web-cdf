---
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import { missions } from '../../data/missions';
import BaseLayout from '../../layouts/BaseLayout.astro';

const missionsChronological = [...missions].sort((a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime());

const dateFormatter = new Intl.DateTimeFormat('es-AR', {
  month: 'long',
  year: 'numeric',
});

const getLocalMissionDate = (date: string) => new Date(`${date}T12:00:00`);
---

<BaseLayout title="Misiones | Iglesia Corazon de Fuego">
  <Navbar transparent />

  <main data-cinematic-page="misiones" class="missions-cinematic overflow-hidden bg-white">
  <section data-animate="hero" data-nav-surface-zone="dark" class="missions-hero relative isolate flex min-h-[42rem] items-center overflow-hidden bg-[#11110f] py-28 text-white sm:min-h-[46rem] lg:min-h-screen">
    <div aria-hidden="true" class="cinematic-grain absolute inset-0 -z-10 opacity-25 mix-blend-soft-light"></div>
    <div aria-hidden="true" class="missions-hero-glow absolute -right-40 top-1/4 -z-10 h-[34rem] w-[34rem] rounded-full bg-primary/10 blur-3xl"></div>
    <div class="relative mx-auto w-full max-w-[90rem] px-5 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
        <div data-cinematic="hero-copy">
          <span class="text-primary text-xs uppercase tracking-[0.22em] font-semibold">Misiones</span>
          <h1 class="mt-5 max-w-4xl font-display text-5xl font-semibold leading-[0.96] tracking-[-0.045em] text-white sm:text-6xl md:text-7xl lg:text-[5.7rem]">
            Alcanzar, servir y llevar el mensaje de Jesús.
          </h1>
        </div>
        <div data-cinematic="hero-aside" class="space-y-5 border-l border-primary/70 pl-6 text-base leading-relaxed text-white/70 sm:text-lg lg:max-w-xl lg:justify-self-end">
          <p>
            Misiones expresa el corazón evangelístico de la iglesia: salir de nuestra comodidad para acompañar, predicar, servir y fortalecer personas, familias y comunidades.
          </p>
          <p>
            Cada destino representa una respuesta concreta al llamado de Dios. Oramos, preparamos equipos y caminamos con iglesias locales para que el amor de Cristo llegue a más lugares.
          </p>
        </div>
      </div>
      <div data-cinematic="hero-footer" class="mt-14 flex items-center gap-3 text-[0.62rem] font-bold uppercase tracking-[0.26em] text-white/50 sm:mt-20">
        <span class="h-px w-10 bg-primary"></span>
        Una iglesia en movimiento
      </div>
    </div>
  </section>

  <section data-animate="reveal" data-nav-surface-zone="dark" class="missions-values relative flex min-h-screen items-center overflow-hidden bg-[#181816] py-20 text-white md:py-28">
    <div aria-hidden="true" class="cinematic-orb cinematic-orb--left"></div>
    <div class="relative mx-auto w-full max-w-[90rem] px-5 sm:px-6 lg:px-8">
      <div class="missions-values-grid grid grid-cols-1 md:grid-cols-3">
        <article data-animate="card" data-cinematic-card data-scene-index="01" class="mission-value-card p-6 sm:p-8">
          <p class="text-primary text-xs uppercase tracking-[0.2em] font-semibold">Propósito</p>
          <h2 class="mt-4 font-display text-3xl text-white">Una iglesia en movimiento.</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/60">
            Creemos que la misión nace en la adoración y se expresa en servicio. Por eso formamos equipos que anuncian el evangelio, acompañan procesos y responden a necesidades reales.
          </p>
        </article>
        <article data-animate="card" data-cinematic-card data-scene-index="02" class="mission-value-card p-6 sm:p-8">
          <p class="text-primary text-xs uppercase tracking-[0.2em] font-semibold">Equipo</p>
          <h2 class="mt-4 font-display text-3xl text-white">Servimos juntos.</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/60">
            Cada salida se sostiene con oración, preparación, generosidad y personas dispuestas a poner sus dones al servicio de otros.
          </p>
        </article>
        <article data-animate="card" data-cinematic-card data-scene-index="03" class="mission-value-card p-6 sm:p-8">
          <p class="text-primary text-xs uppercase tracking-[0.2em] font-semibold">Alcance</p>
          <h2 class="mt-4 font-display text-3xl text-white">Cerca y lejos.</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/60">
            La visión alcanza barrios, provincias y naciones. Donde Dios abre una puerta, buscamos responder con obediencia y amor.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section data-animate="reveal" class="missions-destinations relative bg-[#eee9df] py-20 md:py-28">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
      <div class="mb-10 border-b border-charcoal/15 pb-8 md:mb-0 md:pb-10">
        <span class="text-primary text-xs uppercase tracking-[0.22em] font-semibold">Lugares</span>
        <h2 data-cinematic-heading class="mt-3 font-display text-4xl font-semibold tracking-tight text-charcoal sm:text-5xl lg:text-6xl">Destinos misioneros</h2>
      </div>
      <div>
        {
          missionsChronological.map((mission, index) => (
            <article
              data-animate="card"
              data-mission-scene
              data-scene-index={`0${index + 1}`}
              class="mission-card relative grid min-h-screen grid-cols-1 items-center gap-8 border-b border-charcoal/15 py-16 md:grid-cols-[0.68fr_1.32fr] md:gap-14 md:py-24"
            >
              <div data-cinematic-copy class="mission-copy relative z-10">
                <div class="mb-3 flex flex-wrap items-center gap-2">
                  <span class="inline-flex border border-charcoal/15 bg-white/40 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-charcoal">
                    {dateFormatter.format(getLocalMissionDate(mission.startDate))}
                  </span>
                </div>
                <p class="text-[11px] uppercase tracking-[0.18em] text-gray-500">{mission.country}</p>
                <h3 class="font-display text-4xl text-charcoal mt-2">{mission.place}</h3>
                <p class="mt-5 text-gray-600 text-base leading-relaxed">{mission.summary}</p>
                <p class="mt-4 text-sm leading-relaxed text-gray-600">
                  En este destino enfocamos los esfuerzos en {mission.focus.toLowerCase()}, acompañando lo que Dios ya está haciendo y fortaleciendo el trabajo local.
                </p>
                <p class="mt-5 text-xs uppercase tracking-[0.18em] text-charcoal">{mission.focus}</p>
              </div>
              <div class="mission-media-wrap relative">
                <div class="mission-media-frame overflow-hidden bg-charcoal">
                  {
                    mission.video ? (
                      <video
                        class="mission-video aspect-video w-full object-cover"
                        data-cinematic="image"
                        data-src={mission.video}
                        poster={mission.image}
                        muted
                        loop
                        playsinline
                        preload="none"
                        aria-label={`Video mision ${mission.place}`}
                      />
                    ) : (
                      <img data-cinematic="image" src={mission.image} alt={`Mision ${mission.place}`} class="aspect-video w-full object-cover" />
                    )
                  }
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  </main>

  <Footer />

  <script>
    interface MissionVideoState {
      card: Element;
      hovered: boolean;
      focused: boolean;
      pinned: boolean;
    }

    const missionVideos = [...document.querySelectorAll<HTMLVideoElement>('.mission-video')];
    const videoStates = new WeakMap<HTMLVideoElement, MissionVideoState>();
    let pointerPosition: { x: number; y: number } | null = null;

    const loadMissionVideo = (video: HTMLVideoElement) => {
      if (!video.dataset.src || video.dataset.loaded === 'true') return;

      const source = document.createElement('source');
      source.src = video.dataset.src;
      source.type = 'video/mp4';
      video.append(source);
      video.dataset.loaded = 'true';
      video.load();
    };

    const playMissionVideo = (video: HTMLVideoElement) => {
      loadMissionVideo(video);
      video.play().catch(() => {});
    };

    const pauseMissionVideo = (video: HTMLVideoElement) => {
      video.pause();
    };

    const updateMissionVideo = (video: HTMLVideoElement) => {
      const state = videoStates.get(video);
      if (!state) return;

      if (state.hovered || state.focused || state.pinned) {
        playMissionVideo(video);
        return;
      }

      pauseMissionVideo(video);
    };

    const refreshHoverFromPointer = () => {
      if (!pointerPosition) return;

      const hoveredElement = document.elementFromPoint(pointerPosition.x, pointerPosition.y);
      missionVideos.forEach((video) => {
        const state = videoStates.get(video);
        if (!state) return;

        state.hovered = hoveredElement ? state.card.contains(hoveredElement) : false;
        updateMissionVideo(video);
      });
    };

    missionVideos.forEach((video) => {
      const card = video.closest('.mission-card');
      if (!card) return;
      const state: MissionVideoState = { card, hovered: false, focused: false, pinned: false };
      videoStates.set(video, state);

      card.addEventListener('mouseenter', () => {
        state.hovered = true;
        updateMissionVideo(video);
      });
      card.addEventListener('mouseleave', () => {
        state.hovered = false;
        updateMissionVideo(video);
      });
      card.addEventListener('focusin', () => {
        state.focused = true;
        updateMissionVideo(video);
      });
      card.addEventListener('focusout', () => {
        state.focused = false;
        updateMissionVideo(video);
      });
    });

    window.addEventListener(
      'pointermove',
      (event) => {
        pointerPosition = { x: event.clientX, y: event.clientY };
      },
      { passive: true }
    );
    window.addEventListener('scroll', refreshHoverFromPointer, { passive: true });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target.querySelector<HTMLVideoElement>('.mission-video');
            if (!video) return;
            const state = videoStates.get(video);
            if (!state) return;

            state.pinned = entry.isIntersecting && entry.intersectionRatio >= 0.72;
            updateMissionVideo(video);
          });
        },
        { threshold: [0, 0.72] }
      );

      document.querySelectorAll('.mission-card').forEach((card) => observer.observe(card));
    }
  </script>
</BaseLayout>
