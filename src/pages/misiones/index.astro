---
/**
 * Misiones, en el lenguaje noche. Los destinos salen de `src/data/missions.ts`
 * y el mapa es el SVG estático de `maqueta-mapa.ts` (sin librería ni tiles).
 */
import NocheLayout from '../../layouts/NocheLayout.astro';
import NocheHero from '../../components/noche/NocheHero.astro';
import NocheCta from '../../components/noche/NocheCta.astro';
import { missions } from '../../data/missions';
import { mapaMundi, coordenadas, proyectar } from '../../data/maqueta-mapa';

/* Sólo las misiones con coordenada cargada entran al mapa. */
const destinos = missions
  .filter((m) => coordenadas[m.slug])
  .map((m) => ({
    ...m,
    ...proyectar(coordenadas[m.slug][0], coordenadas[m.slug][1]),
    year: new Date(m.startDate).getFullYear(),
  }));

const columnas = [
  { n: '01', title: 'Ir', text: 'Salidas cortas para servir junto a iglesias locales que ya están sembrando en la región.' },
  { n: '02', title: 'Sostener', text: 'Acompañamos con oración y con recursos a quienes están en el campo todo el año.' },
  { n: '03', title: 'Enviar', text: 'Formamos y enviamos equipos de la casa, con respaldo pastoral antes, durante y después.' },
];

const destacada = missions[0];
---

<NocheLayout title="Misiones · Iglesia Corazón de Fuego">
  <div class="lz-tint" style="--m: #35b887">
    <NocheHero
      lines={['misiones']}
      lead="Hasta lo último de la tierra."
      video={destacada?.video}
      image={destacada?.image}
    >
      <Fragment slot="quote">
        Salimos a servir, anunciar y acompañar
        {' '}<strong>junto a iglesias que ya están trabajando en cada región.</strong>
      </Fragment>
      <a class="lz-btn" href="#destinos">Ver destinos</a>
      <a class="lz-btn lz-btn--ghost" href="#participar">Quiero ir</a>
    </NocheHero>

    <section class="lz-plate lz-statement" id="sobre">
      <div class="lz-mesh" aria-hidden="true"></div>
      <div class="lz-wrap">
        <span class="lz-spaced lz-kicker" data-r>Nuestra visión</span>
        <h2 class="lz-statement__text" data-r>Una iglesia que alcanza, forma y envía.</h2>
      </div>
    </section>

    <section class="lz-section lz-dark" id="participar">
      <div class="lz-wrap">
        <div class="lz-head">
          <h2 class="lz-lockup lz-lockup--md" data-r>
            <span>tres formas</span>
            <span class="lz-lockup__shift">de sumarte</span>
          </h2>
          <div class="lz-actions" data-r>
            <a class="lz-btn lz-btn--ghost" href="/contact">Escribinos</a>
          </div>
        </div>
        <span class="lz-spaced lz-kicker" data-r>Cómo participamos</span>
        <div class="lz-cols">
          {columnas.map((c) => (
            <div class="lz-col" data-r>
              <span class="lz-col__n">{c.n}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="lz-section lz-dark lz-dark--2" id="destinos">
      <div class="lz-wrap">
        <h2 class="lz-lockup lz-lockup--md" data-r><span>destinos</span></h2>

        {destinos.length > 0 && (
          <div class="lz-mapa" data-mapa data-r>
            <div class="lz-mapa__lienzo">
              <svg
                class="lz-mapa__svg"
                viewBox={`0 0 ${mapaMundi.width} ${mapaMundi.height}`}
                role="img"
                aria-label="Mapa con los destinos de misiones"
              >
                <path d={mapaMundi.path} />
              </svg>
              {destinos.map((d, i) => (
                <button
                  type="button"
                  class={`lz-mapa__punto${i === 0 ? ' is-active' : ''}`}
                  style={`left: ${d.x}%; top: ${d.y}%`}
                  data-destino={d.slug}
                  aria-label={`${d.place}, ${d.country}, ${d.year}`}
                >
                  <span class="lz-mapa__pulso"></span>
                  <span class="lz-mapa__rotulo">{d.place}</span>
                </button>
              ))}
            </div>

            {/* Las fichas son hermanas del lienzo, no hijas: si entraran en su
                flujo lo estirarían y los puntos, en %, saldrían del mapa. */}
            {destinos.map((d, i) => (
              <article
                class={`lz-mapa__ficha${i === 0 ? ' is-active' : ''}`}
                style={`--x: ${d.x}%; --y: ${d.y}%`}
                data-ficha={d.slug}
              >
                <img src={d.image} alt={d.place} loading="lazy" />
                <div class="lz-mapa__cuerpo">
                  <span class="lz-spaced">{d.country} · {d.year} · {d.stage}</span>
                  <h3 class="lz-mapa__lugar">{d.place}</h3>
                  <p class="lz-mapa__foco">{d.focus}</p>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <NocheCta title="¿Querés ir?" text="Escribinos y te contamos cómo prepararte para la próxima salida.">
      <a class="lz-btn" href="/contact">Escribinos</a>
      <a class="lz-btn lz-btn--ghost" href="/evangelismo">Ver Evangelismo</a>
    </NocheCta>
  </div>
</NocheLayout>
