---
/**
 * Contacto, en el lenguaje noche. Formulario a la izquierda y datos de la casa
 * a la derecha; los datos son los de la página anterior.
 */
import NocheLayout from '../layouts/NocheLayout.astro';
import NocheHero from '../components/noche/NocheHero.astro';
import NocheCta from '../components/noche/NocheCta.astro';
import { maquetaAnexos } from '../data/maqueta-anexos';

const direccion = ['Leandro N. Alem 467', 'Ramos Mejía, Buenos Aires'];
const email = 'info@corazondefuego.com';

const horarios = [
  { day: 'Viernes', time: '20:00' },
  { day: 'Sábados', time: '20:00' },
  { day: 'Domingos', time: '09:30 y 11:00' },
];

const mapsHref = `https://www.google.com/maps/search/${encodeURIComponent(direccion.join(' '))}`;
---

<NocheLayout title="Contacto · Iglesia Corazón de Fuego">
  <NocheHero lines={['hablemos']} kicker="Contacto" short>
    <Fragment slot="quote">
      Escribinos por lo que necesites: una consulta, un pedido de oración o
      <strong>simplemente para saber cómo venir por primera vez.</strong>
    </Fragment>
  </NocheHero>

  <section class="lz-section lz-dark">
    <div class="lz-wrap lz-split">
      <div>
        <span class="lz-spaced lz-kicker" data-r>Formulario</span>
        <h2 class="lz-title" data-r>Completá tus datos.</h2>
        <p class="lz-body" style="margin-top: 14px" data-r>Nos contactamos con vos a la brevedad.</p>

        {/* `action="#"` igual que la página anterior: todavía no hay endpoint. */}
        <form class="lz-form" action="#" method="post" data-r>
          <label class="lz-field">
            <span>Nombre</span>
            <input type="text" name="nombre" placeholder="Tu nombre" required />
          </label>
          <label class="lz-field">
            <span>Correo electrónico</span>
            <input type="email" name="email" placeholder="tuemail@ejemplo.com" required />
          </label>
          <label class="lz-field">
            <span>Mensaje</span>
            <textarea name="mensaje" rows="5" placeholder="Contanos cómo podemos ayudarte" required></textarea>
          </label>
          <button class="lz-btn" type="submit">Enviar mensaje</button>
        </form>
      </div>

      <div>
        <span class="lz-spaced lz-kicker" data-r>Dónde estamos</span>
        <h2 class="lz-title" data-r>Sede central.</h2>

        <div class="lz-data" data-r>
          <span class="lz-spaced">Dirección</span>
          {direccion.map((l) => <p>{l}</p>)}
        </div>
        <div class="lz-data" data-r>
          <span class="lz-spaced">Correo</span>
          <a href={`mailto:${email}`}>{email}</a>
        </div>
        <div class="lz-actions" style="margin-top: 24px" data-r>
          <a class="lz-btn lz-btn--ghost lz-btn--small" href={mapsHref} target="_blank" rel="noopener noreferrer">Abrir en Maps</a>
        </div>

        <span class="lz-spaced lz-kicker" style="margin-top: 48px" data-r>Reuniones</span>
        <div class="lz-times" data-r>
          {horarios.map((h) => (
            <div class="lz-time">
              <span class="lz-time__day">{h.day}</span>
              <span class="lz-time__hour">{h.time}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="lz-section lz-dark lz-dark--2">
    <div class="lz-wrap">
      <div class="lz-head">
        <h2 class="lz-lockup lz-lockup--md" data-r>
          <span>también</span>
          <span class="lz-lockup__shift">estamos acá</span>
        </h2>
        <p class="lz-quote lz-quote--side" data-r>Otras sedes. <strong>También estamos acá.</strong></p>
      </div>
      <div class="lz-tiles">
        {maquetaAnexos.map((a) => (
          <a class="lz-tile" href={`/anexos/${a.slug}`} data-r>
            <span class="lz-tile__name">{a.name}</span>
            <span class="lz-spaced">{a.addressLines[0] ?? a.yearsLabel}</span>
            <span class="lz-tile__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <NocheCta title="Vení este fin de semana." text="No hace falta avisar. Te esperamos en la puerta.">
    <a class="lz-btn" href="https://maps.app.goo.gl/mEVMgoTXbV3BULVq8" target="_blank" rel="noopener noreferrer">Tu primera vez</a>
    <a class="lz-btn lz-btn--ghost" href="/nosotros">Conocenos</a>
  </NocheCta>
</NocheLayout>
