---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const fieldClass =
  'w-full rounded-soft border border-charcoal/15 bg-white px-4 py-3 text-sm text-charcoal outline-none transition-colors placeholder:text-charcoal/35 hover:border-primary/50 focus:border-primary';
const labelClass = 'mb-2 block text-[0.62rem] font-bold uppercase tracking-[0.22em] text-charcoal/60';
---

<BaseLayout title="Contacto | Corazón de Fuego">
  <Navbar />

  <main data-cinematic-page="contacto" class="bg-[#11110f]">
    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#151514] py-20 text-white md:py-28">
      <div aria-hidden="true" class="cinematic-orb cinematic-orb--right"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
          <span class="h-px w-8 bg-primary/60"></span>
          Estamos para ayudarte
        </p>
        <h1 data-cinematic-heading class="max-w-4xl font-display text-4xl font-semibold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Contacto
        </h1>
        <p data-cinematic-copy class="mt-7 max-w-2xl text-base leading-relaxed text-white/70 sm:text-lg">
          Escribinos y te respondemos pronto. Si querés una visita o más información sobre reuniones y ministerios, este es el lugar correcto.
        </p>
      </div>
    </section>

    <section data-animate="reveal" class="cinematic-light-section relative bg-[#e9e4da] py-20 md:py-28">
      <div class="mx-auto grid max-w-[90rem] grid-cols-1 gap-10 px-5 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:px-8">
        <div data-animate="card" data-cinematic-card>
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Formulario</p>
          <h2 class="mt-4 font-display text-3xl leading-tight text-charcoal">Completá tus datos.</h2>
          <p class="mt-3 text-sm leading-relaxed text-charcoal/65">Nos contactamos con vos a la brevedad.</p>

          <form class="mt-9 space-y-6" action="#" method="post">
            <div>
              <label class={labelClass} for="nombre">Nombre</label>
              <input id="nombre" name="nombre" type="text" required class={fieldClass} placeholder="Tu nombre" />
            </div>

            <div>
              <label class={labelClass} for="email">Correo electrónico</label>
              <input id="email" name="email" type="email" required class={fieldClass} placeholder="tuemail@ejemplo.com" />
            </div>

            <div>
              <label class={labelClass} for="mensaje">Mensaje</label>
              <textarea id="mensaje" name="mensaje" rows="6" required class={fieldClass} placeholder="Contanos cómo podemos ayudarte"></textarea>
            </div>

            <button
              type="submit"
              class="editorial-button w-full bg-charcoal text-white sm:w-auto"
            >
              <span>Enviar mensaje</span>
              <span class="material-symbols-outlined">arrow_outward</span>
            </button>
          </form>
        </div>

        <aside data-cinematic-copy class="border-l-2 border-primary pl-6 sm:pl-8">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Hablemos</p>
          <h2 class="mt-5 font-display text-3xl font-semibold leading-[1.06] tracking-tight text-charcoal sm:text-4xl">
            También podés escribirnos directo.
          </h2>

          <dl class="mt-10 space-y-8 border-t border-charcoal/15 pt-8">
            <div>
              <dt class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-charcoal/45">Correo</dt>
              <dd class="mt-2 break-words text-base text-charcoal/80">info@corazondefuego.com</dd>
            </div>
            <div>
              <dt class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-charcoal/45">Dirección</dt>
              <dd class="mt-2 text-base leading-relaxed text-charcoal/80">Leandro N. Alem 467<br />Ramos Mejía</dd>
            </div>
            <div>
              <dt class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-charcoal/45">Reuniones</dt>
              <dd class="mt-2 text-base leading-relaxed text-charcoal/80">
                Viernes 20 hs · Sábados 20 hs<br />Domingos 9:30 y 11:00 hs
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
