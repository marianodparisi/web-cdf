---
/**
 * Página no encontrada: sólo el hero noche con "página no encontrada" en
 * grande, un botón para volver y el footer. Sin barra de navegación (pedido
 * del usuario). Astro la sirve con estado 404 para cualquier ruta que no exista.
 */
import NocheLayout from '../layouts/NocheLayout.astro';
import NocheHero from '../components/noche/NocheHero.astro';

Astro.response.status = 404;
---

<NocheLayout title="Página no encontrada · Iglesia Corazón de Fuego" hideNav>
  <NocheHero lines={['página', 'no encontrada']} kicker="Error 404" lead="La página que buscás no existe o cambió de lugar.">
    <a class="lz-btn" href="/">Volver al inicio</a>
  </NocheHero>
</NocheLayout>
