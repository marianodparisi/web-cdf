---
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import { evangelismFronts } from '../../data/evangelism';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Evangelismo | Iglesia Corazon de Fuego">
  <Navbar transparent />

  <main data-cinematic-page="evangelismo" class="evangelism-cinematic overflow-hidden bg-white">
  <section data-animate="hero" data-nav-surface-zone="dark" class="evangelism-hero relative isolate flex min-h-[42rem] items-center overflow-hidden bg-[#11110f] py-28 text-white sm:min-h-[46rem] lg:min-h-screen">
    <div aria-hidden="true" class="cinematic-grain absolute inset-0 -z-10 opacity-25 mix-blend-soft-light"></div>
    <div class="relative mx-auto w-full max-w-[90rem] px-5 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
        <div data-cinematic="hero-copy">
          <span class="text-primary text-xs uppercase tracking-[0.22em] font-semibold">Evangelismo</span>
          <h1 class="mt-5 max-w-4xl font-display text-5xl font-semibold leading-[0.96] tracking-[-0.045em] text-white sm:text-6xl md:text-7xl lg:text-[5.7rem]">
            Anunciar a Jesús donde la gente está.
          </h1>
        </div>
        <div data-cinematic="hero-aside" class="space-y-5 border-l border-primary/70 pl-6 text-base leading-relaxed text-white/70 sm:text-lg lg:max-w-xl lg:justify-self-end">
          <p>
            Evangelismo es la respuesta de la iglesia al mandato de compartir las buenas noticias de salvación con amor, claridad y cercanía.
          </p>
          <p>
            Salimos a hospitales, plazas y espacios abiertos para orar, acompañar, servir y presentar a Cristo en medio de realidades concretas.
          </p>
        </div>
      </div>
      <div data-cinematic="hero-footer" class="mt-14 flex items-center gap-3 text-[0.62rem] font-bold uppercase tracking-[0.26em] text-white/50 sm:mt-20">
        <span class="h-px w-10 bg-primary"></span>
        Llevar esperanza real
      </div>
    </div>
  </section>

  <section data-animate="reveal" data-nav-surface-zone="dark" class="evangelism-values relative flex min-h-screen items-center overflow-hidden bg-[#181816] py-20 text-white md:py-28">
    <div aria-hidden="true" class="cinematic-orb cinematic-orb--right"></div>
    <div class="relative mx-auto w-full max-w-[90rem] px-5 sm:px-6 lg:px-8">
      <div class="evangelism-values-grid grid grid-cols-1 md:grid-cols-3">
        <article data-animate="card" data-cinematic-card data-scene-index="01" class="evangelism-value-card p-6 sm:p-8">
          <p class="text-primary text-xs uppercase tracking-[0.2em] font-semibold">Propósito</p>
          <h2 class="mt-4 font-display text-3xl text-white">Llevar esperanza real.</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/60">
            Creemos que el evangelio no se guarda puertas adentro. La iglesia sale para anunciar salvación, consuelo y restauración.
          </p>
        </article>
        <article data-animate="card" data-cinematic-card data-scene-index="02" class="evangelism-value-card p-6 sm:p-8">
          <p class="text-primary text-xs uppercase tracking-[0.2em] font-semibold">Presencia</p>
          <h2 class="mt-4 font-display text-3xl text-white">Estar cerca de las personas.</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/60">
            Cada frente busca escuchar, orar y acompañar con sensibilidad, entendiendo que muchas veces una presencia fiel abre camino al mensaje.
          </p>
        </article>
        <article data-animate="card" data-cinematic-card data-scene-index="03" class="evangelism-value-card p-6 sm:p-8">
          <p class="text-primary text-xs uppercase tracking-[0.2em] font-semibold">Servicio</p>
          <h2 class="mt-4 font-display text-3xl text-white">Predicar también con acciones.</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/60">
            Evangelizamos sirviendo. Cada oración, visita, actividad y conversación apunta a revelar el amor de Jesús.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section data-animate="reveal" class="evangelism-fronts relative bg-[#eee9df] py-20 md:py-28">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
      <div class="mb-10 border-b border-charcoal/15 pb-8 md:mb-0 md:pb-10">
        <span class="text-primary text-xs uppercase tracking-[0.22em] font-semibold">Frentes</span>
        <h2 data-cinematic-heading class="mt-3 font-display text-4xl font-semibold tracking-tight text-charcoal sm:text-5xl lg:text-6xl">Dónde servimos</h2>
      </div>
      <div>
        {
          evangelismFronts.map((front, index) => (
            <article
              data-animate="card"
              data-evangelism-scene
              data-scene-index={`0${index + 1}`}
              class="evangelism-scene relative grid min-h-screen grid-cols-1 items-center gap-8 border-b border-charcoal/15 py-16 md:grid-cols-[0.72fr_1.28fr] md:gap-14 md:py-24"
            >
              <div data-cinematic-copy class="evangelism-copy relative z-10">
                <span class="inline-flex border border-charcoal/15 bg-white/40 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-charcoal">{front.subtitle}</span>
                <h3 data-cinematic-heading class="mt-5 font-display text-4xl font-semibold tracking-tight text-charcoal sm:text-5xl">{front.title}</h3>
                <p class="mt-6 text-base leading-relaxed text-gray-600">{front.description}</p>
                <p class="mt-4 text-sm leading-relaxed text-gray-600">
                  Este frente nos permite acercarnos con una palabra de fe, oración y acompañamiento, respondiendo a necesidades concretas con el amor de Cristo.
                </p>
                <p class="mt-5 text-xs uppercase tracking-[0.18em] text-charcoal">{front.subtitle}</p>
              </div>
              <div class="evangelism-media-wrap relative">
                <div class="mission-media-frame overflow-hidden bg-charcoal">
                  <img data-cinematic="image" src={front.image} alt={`Evangelismo ${front.title}`} class="aspect-[4/3] w-full object-cover" />
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  </main>

  <Footer />
</BaseLayout>
