---
/**
 * MAQUETA — "Evangelismo", con la estructura de sus páginas de iniciativa
 * (For the City). Los frentes salen de `src/data/evangelism.ts`.
 */
import MaquetaLayout from '../../layouts/MaquetaLayout.astro';
import { evangelismFronts } from '../../data/evangelism';

const columnas = [
  { n: '01', title: 'Salir', text: 'Vamos donde está la gente: hospitales, plazas, barrios y cárceles.' },
  { n: '02', title: 'Acompañar', text: 'No es una visita suelta: sostenemos el vínculo y volvemos.' },
  { n: '03', title: 'Integrar', text: 'Quien se acerca encuentra una casa esperándolo, no sólo un evento.' },
];
---

<MaquetaLayout title="Evangelismo · Iglesia Corazón de Fuego">
  <div class="as-ministry" style="--m: #c43b46">
    <header class="as-hero as-hero--inner">
      <div class="as-hero__bg">
        <img src={evangelismFronts[0]?.image} alt="" />
        <div class="as-hero__veil"></div>
      </div>
      <div class="as-hero__grid">
        <div class="as-hero__content">
          <p class="as-eyebrow as-eyebrow--light" data-reveal>Evangelismo</p>
          <h1 class="as-display" data-reveal="words">Para la ciudad.</h1>
          <p class="as-hero__lead" data-reveal>
            Salimos a cada rincón con oración, palabra de ánimo y presencia concreta.
          </p>
          <div class="as-hero__actions" data-reveal data-reveal-delay="140">
            <a class="as-button as-button--white" href="#frentes">Ver frentes</a>
            <a class="as-button as-button--ghost-white" href="#participar">Quiero servir</a>
          </div>
        </div>
      </div>
    </header>

    <section class="as-section as-section--dark as-statement" id="sobre">
      <div class="as-wrap">
        <p class="as-eyebrow as-eyebrow--light" data-reveal>Nuestra convicción</p>
        <h2 class="as-statement__text" data-reveal="words">
          El Evangelio se anuncia y también se sirve.
        </h2>
      </div>
    </section>

    <section class="as-section as-section--light" id="participar">
      <div class="as-wrap">
        <div class="as-head">
          <div>
            <p class="as-eyebrow" data-reveal>Cómo trabajamos</p>
            <h2 class="as-h1" data-reveal="words">Salir, acompañar, integrar.</h2>
          </div>
          <a class="as-button as-button--small as-button--ministry" href="/contact">Sumarme</a>
        </div>
        <div class="as-cols">
          {columnas.map((c, i) => (
            <div class="as-col" data-reveal data-reveal-delay={i * 110}>
              <span class="as-col__n">{c.n}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="as-section" id="frentes">
      <div class="as-wrap">
        <div class="as-head">
          <div>
            <p class="as-eyebrow" data-reveal>Frentes</p>
            <h2 class="as-h1" data-reveal="words">Dónde estamos hoy.</h2>
          </div>
        </div>
        <div class="as-scenes">
          {evangelismFronts.map((f, i) => (
            <article class="as-scene" data-reveal data-reveal-delay={i * 90}>
              <div class="as-scene__media">
                <img src={f.image} alt={f.title} loading="lazy" />
              </div>
              <div class="as-scene__copy">
                <p class="as-eyebrow">{f.subtitle}</p>
                <h3>{f.title}</h3>
                <p>{f.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="as-section as-section--dark as-cta">
      <div class="as-wrap">
        <h2 class="as-display" data-reveal="words">Sumate a salir.</h2>
        <p data-reveal>No hace falta experiencia. Se empieza acompañando una salida.</p>
        <div class="as-button-group" data-reveal data-reveal-delay="120">
          <a class="as-button as-button--white" href="/contact">Escribinos</a>
          <a class="as-button as-button--ghost-white" href="/misiones">Ver Misiones</a>
        </div>
      </div>
    </section>
  </div>
</MaquetaLayout>
