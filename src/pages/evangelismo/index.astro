---
/**
 * Evangelismo, en el lenguaje noche. Los frentes salen de
 * `src/data/evangelism.ts`.
 */
import NocheLayout from '../../layouts/NocheLayout.astro';
import NocheHero from '../../components/noche/NocheHero.astro';
import NocheCta from '../../components/noche/NocheCta.astro';
import { evangelismFronts } from '../../data/evangelism';

const columnas = [
  { n: '01', title: 'Salir', text: 'Vamos donde está la gente: hospitales, plazas, barrios y cárceles.' },
  { n: '02', title: 'Acompañar', text: 'No es una visita suelta: sostenemos el vínculo y volvemos.' },
  { n: '03', title: 'Integrar', text: 'Quien se acerca encuentra una casa esperándolo, no sólo un evento.' },
];
---

<NocheLayout title="Evangelismo · Iglesia Corazón de Fuego">
  <div class="lz-tint" style="--m: #c43b46">
    <NocheHero lines={['evangelismo']} lead="Para la ciudad." image={evangelismFronts[0]?.image}>
      <Fragment slot="quote">
        Salimos a cada rincón con oración,
        <strong>palabra de ánimo y presencia concreta.</strong>
      </Fragment>
      <a class="lz-btn" href="#frentes">Ver frentes</a>
      <a class="lz-btn lz-btn--ghost" href="#participar">Quiero servir</a>
    </NocheHero>

    <section class="lz-plate lz-statement" id="sobre">
      <div class="lz-mesh" aria-hidden="true"></div>
      <div class="lz-wrap">
        <span class="lz-spaced lz-kicker" data-r>Nuestra convicción</span>
        <h2 class="lz-statement__text" data-r>El Evangelio se anuncia y también se sirve.</h2>
      </div>
    </section>

    <section class="lz-section lz-dark" id="participar">
      <div class="lz-wrap">
        <div class="lz-head">
          <h2 class="lz-lockup lz-lockup--md" data-r>
            <span>salir, acompañar,</span>
            <span class="lz-lockup__shift">integrar</span>
          </h2>
          <div class="lz-actions" data-r>
            <a class="lz-btn lz-btn--ghost" href="/contact">Sumarme</a>
          </div>
        </div>
        <span class="lz-spaced lz-kicker" data-r>Cómo trabajamos</span>
        <div class="lz-cols">
          {columnas.map((c) => (
            <div class="lz-col" data-r>
              <span class="lz-col__n">{c.n}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="lz-section lz-dark lz-dark--2" id="frentes">
      <div class="lz-wrap">
        <div class="lz-head">
          <h2 class="lz-lockup lz-lockup--md" data-r>
            <span>dónde estamos</span>
            <span class="lz-lockup__shift">hoy</span>
          </h2>
          <p class="lz-quote lz-quote--side" data-r>Frentes. <strong>Dónde estamos hoy.</strong></p>
        </div>
        <div class="lz-scenes">
          {evangelismFronts.map((f) => (
            <article class="lz-scene" data-r>
              <div class="lz-scene__media">
                <img src={f.image} alt={f.title} loading="lazy" />
              </div>
              <div>
                <span class="lz-spaced">{f.subtitle}</span>
                <h3>{f.title}</h3>
                <p class="lz-body">{f.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <NocheCta title="Sumate a salir." text="No hace falta experiencia. Se empieza acompañando una salida.">
      <a class="lz-btn" href="/contact">Escribinos</a>
      <a class="lz-btn lz-btn--ghost" href="/misiones">Ver Misiones</a>
    </NocheCta>
  </div>
</NocheLayout>
