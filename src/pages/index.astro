---

<BaseLayout title="Corazón de Fuego - Próximamente">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap"
  />

  <main class="soon">
    <div class="soon__bg">
      {/* Silencioso y en loop, igual que el hero de la maqueta. El fondo sólido
          va debajo para que no haya un rectángulo negro mientras carga, y en
          móviles donde el autoplay queda bloqueado tampoco se ve un hueco. */}
      <video autoplay muted loop playsinline preload="metadata">
        <source src="/home/hero-v1-compressed.mp4" type="video/mp4" />
      </video>
      <div class="soon__veil"></div>
    </div>

    <section class="soon__content">
      <img class="soon__logo" src="/logowhite.png" alt="Corazón de Fuego" width="180" height="112" />
      <p class="soon__eyebrow">Corazón de Fuego</p>
      <h1 class="soon__title">Próximamente</h1>
      <p class="soon__lead">Un lugar de oración, Palabra y comunión.</p>

      <div class="soon__social">
        {
          redes.map((red) => (
            <a href={red.href} target="_blank" rel="noopener noreferrer" aria-label={red.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={red.path} /></svg>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="soon__foot">© 2026 Corazón de Fuego</footer>
  </main>
</BaseLayout>

<style>
  /* Tokens tomados de la maqueta: tinta #282828, dorado de la casa y el velo
     del hero a #28282840. */
  .soon {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* `svh` usa el alto chico del viewport: en móviles la barra del navegador
       no recorta el pie. `vh` queda de reserva para navegadores viejos. */
    min-height: 100vh;
    min-height: 100svh;
    padding: 4rem 1.5rem 2rem;
    background: #282828;
    color: #fff;
    font-family: 'Nunito Sans', Arial, sans-serif;
    text-align: center;
  }

  .soon__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .soon__bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .soon__veil {
    position: absolute;
    inset: 0;
    background: #28282840;
  }

  .soon__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 60rem;
  }

  .soon__logo {
    width: auto;
    height: 7rem;
    object-fit: contain;
  }

  /* Todo lo que lleva texto declara la familia: el CSS global de la casa pisa
     la herencia en varios elementos. */
  .soon__eyebrow,
  .soon__lead,
  .soon__foot {
    font-family: 'Nunito Sans', Arial, sans-serif;
  }

  .soon__eyebrow {
    margin-top: 1.75rem;
    font-size: 0.95rem;
    line-height: 2rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #c5a059;
  }

  /* Escala display de la maqueta: 7rem/7.6rem en desktop. El mínimo es 2.75rem
     y no 4rem porque "Próximamente" es una sola palabra de doce letras: a 4rem
     no entra en 390px y empuja scroll horizontal. */
  .soon__title {
    margin-top: 0.5rem;
    /* Explícita y no heredada: el CSS global de la casa le pone su propia
       familia a los `h1`, y una regla directa le gana a lo que hereda. */
    font-family: 'Nunito Sans', Arial, sans-serif;
    font-size: clamp(2.75rem, 9vw, 7rem);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -1px;
    overflow-wrap: anywhere;
  }

  .soon__lead {
    margin-top: 1.5rem;
    font-size: 1.15rem;
    line-height: 1.9rem;
    color: rgb(255 255 255 / 0.72);
  }

  .soon__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 3rem;
  }
  /* Pastillas redondas con el hairline de la maqueta, en vez del borde cuadrado
     que tenía la versión anterior. */
  .soon__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 100px;
    color: #fff;
    transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .soon__social a:hover {
    border-color: #c5a059;
    background: #c5a059;
    color: #282828;
  }
  .soon__social svg {
    width: 18px;
    height: 18px;
  }

  .soon__foot {
    margin-top: auto;
    padding-top: 3rem;
    font-size: 0.72rem;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  /* Entrada escalonada, la misma idea que los `data-reveal` de la maqueta pero
     sin JS: acá no hay nada que esperar a que entre en viewport. */
  .soon__logo,
  .soon__eyebrow,
  .soon__title,
  .soon__lead,
  .soon__social {
    animation: soon-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .soon__eyebrow { animation-delay: 0.08s; }
  .soon__title { animation-delay: 0.16s; }
  .soon__lead { animation-delay: 0.26s; }
  .soon__social { animation-delay: 0.36s; }

  @keyframes soon-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .soon__logo,
    .soon__eyebrow,
    .soon__title,
    .soon__lead,
    .soon__social {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .soon { padding: 3rem 1.25rem 1.5rem; }
    .soon__logo { height: 5.5rem; }
    .soon__lead { font-size: 1rem; }
  }
</style>
