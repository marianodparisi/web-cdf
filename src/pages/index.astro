---
/**
 * MAQUETA "CLIMA" — el lenguaje del Instagram de la iglesia llevado al inicio.
 *
 * Sale de mirar el feed de @corazondefuegoiglesia, no las portadas de serie:
 *   - fondos de degradé difuso (naranja brasa, aurora turquesa, hielo, noche)
 *     con grano fuerte;
 *   - "devocional / semanal": palo seco negrísimo en minúscula, interletra muy
 *     cerrada y la segunda línea corrida a la derecha;
 *   - arriba a la izquierda una cita chiquita en cursiva, con partes en negrita
 *     y una raya corta debajo;
 *   - el logo con serifa "Corazón de fuego" centrado abajo;
 *   - fotos de gente en el auditorio, cálidas y con viñeta;
 *   - títulos en mayúscula pesada sobre foto ("PAPÁ", "REUNIÓN DE OBREROS")
 *     con mezcla de pesos.
 *
 * Se compararon cuatro climas de degradé (brasa, aurora, hielo, noche) y se
 * eligió noche: el fondo más oscuro de los cuatro.
 *
 * Nació como la maqueta `/maqueta-luz` y pasó a ser el inicio. Nav, footer y
 * reveals viven en NocheLayout; los estilos, prefijados `.lz`, en noche.css.
 * El inicio anterior (estilo austinstone) quedó en el historial de git.
 */
import NocheLayout from '../layouts/NocheLayout.astro';
import { seriesPlaylistUrl } from '../data/series';
import { getAnnouncements, getDevotionals, getMinistries, getSeries } from '../lib/content/collections';
import { getEstadoVivos } from '../lib/youtube';

const [devotionalPosts, ministries, sermonSeries, announcements, vivos] = await Promise.all([
  getDevotionals(),
  getMinistries(),
  getSeries(),
  getAnnouncements(),
  /* Va en el mismo `Promise.all` para que su latencia se solape con la del
     contenido. Devuelve null si falla: el botón cae a la serie actual. */
  getEstadoVivos(),
]);

const visibleSeries = sermonSeries.filter((series) => series.image && series.href);
const [currentSeries] = visibleSeries;
const pastSeries = visibleSeries.slice(1, 4);
const [devotional] = devotionalPosts;

/* El botón del hero lleva al último vivo de YouTube; si YouTube no responde,
   a la serie actual, y si tampoco hay serie, a las playlists. */
const ultimoVivo = vivos?.ultima;
const mensajeHref = ultimoVivo?.url ?? currentSeries?.href ?? seriesPlaylistUrl;
const mensajeLabel = ultimoVivo?.isLive ? 'Ver la transmisión' : 'Ver el último mensaje';

/* "Qué está pasando": primero los avisos que cada ministerio carga en su
   página (son lo más puntual: un campa, un encuentro) y después los anuncios
   generales. Un aviso entra sólo si tiene título; si no trae imagen, la pieza
   va con el degradé del color del ministerio y su logo. */
const agenda = [
  ...ministries
    .filter((m) => m.noticeTitle?.trim())
    .map((m) => ({
      href: `/ministerios/${m.slug}`,
      eyebrow: m.name,
      title: m.noticeTitle!.trim(),
      image: m.noticeImage,
      alt: m.noticeTitle!.trim(),
      logo: m.image,
      slug: m.slug,
    })),
  ...announcements.map((a) => ({ ...a, logo: undefined, slug: undefined })),
];

/** "Encuentro GOLD" → ["Encuentro", "GOLD"]: liviano arriba, pesado abajo,
    como "REUNIÓN DE / OBREROS" en el feed. */
function splitTitle(title: string): [string, string] {
  const words = title.trim().split(/\s+/);
  if (words.length < 2) return ['', title];
  return [words.slice(0, -1).join(' '), words[words.length - 1]];
}

const heroWords =['iglesia', 'familia', 'casa'];
const mapsUrl = 'https://maps.app.goo.gl/mEVMgoTXbV3BULVq8';

const ministryColors: Record<string, string> = {
  life: '#48c2c5',
  gold: '#c5a059',
  kids: '#e31b48',
  arde: '#e8642b',
  carcelario: '#487a7c',
  'firmes-y-adelante': '#c43b46',
};
const logoSlugs = new Set(['life', 'gold', 'kids', 'arde']);
---

<NocheLayout title="Iglesia Corazón de Fuego">
    <!-- ══════════ HERO ══════════
         Como los videos de testimonio: la casa de fondo, cálida y con viñeta,
         la cita arriba a la izquierda y el logo abajo al centro. -->
    <header class="lz-hero">
      <video class="lz-hero__video" autoplay muted loop playsinline preload="metadata" poster={currentSeries?.image}>
        <source src="/home/hero-v1-compressed.mp4" type="video/mp4" />
      </video>
      <div class="lz-hero__veil" aria-hidden="true"></div>

      <p class="lz-quote lz-hero__quote" data-r>
        Te esperamos este fin de semana. <strong>Viernes y sábados 20 hs · Domingos 9:30 y 11 hs.</strong>
      </p>

      <div class="lz-hero__center">
        <h1 class="lz-lockup lz-lockup--xl">
          <span data-r>somos una</span>
          <span class="lz-lockup__shift lz-rotator" data-rotator aria-live="polite">
            {heroWords.map((word, i) => (
              <span class={`lz-rotator__word${i === 0 ? ' is-on' : ''}`}>{word}</span>
            ))}
          </span>
        </h1>
        <div class="lz-actions lz-actions--center" data-r>
          <a class="lz-btn" href={mapsUrl} target="_blank" rel="noopener noreferrer">Visitanos</a>
          <a class="lz-btn lz-btn--ghost" href={mensajeHref} target="_blank" rel="noopener noreferrer">
            {mensajeLabel}
          </a>
        </div>
      </div>

      <div class="lz-logo lz-logo--foot" aria-hidden="true"><img src="/brand/logowhite.png" alt="" /></div>
    </header>

    <!-- ══════════ BIENVENIDA ══════════ Una placa de "devocional semanal" a sangre. -->
    <section class="lz-plate lz-plate--full">
      <div class="lz-mesh" aria-hidden="true"></div>
      <div class="lz-wrap lz-welcome">
        <p class="lz-quote" data-r>
          Creemos que la iglesia es una familia espiritual llamada a revelar a Cristo con
          {' '}<strong>palabras, obras y una vida rendida a Dios.</strong>
        </p>
        <h2 class="lz-lockup lz-lockup--lg" data-r>
          <span>bienvenido a</span>
          <span class="lz-lockup__shift">corazón de fuego</span>
        </h2>
        <div class="lz-welcome__foot" data-r>
          <p class="lz-lead">Una comunidad para encontrarte con Dios, crecer y servir.</p>
          <div class="lz-actions">
            <a class="lz-btn" href={mapsUrl} target="_blank" rel="noopener noreferrer">Visitanos</a>
            <a class="lz-btn lz-btn--ghost" href="/nosotros">Sobre nosotros</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ SERIE ACTUAL ══════════ -->
    {currentSeries && (
      <section class="lz-section lz-dark" id="series">
        <div class="lz-wrap">
          <div class="lz-head">
            <h2 class="lz-lockup lz-lockup--md" data-r>
              <span>serie</span>
              <span class="lz-lockup__shift">actual</span>
            </h2>
            <p class="lz-quote lz-quote--side" data-r>
              Cada mes abrimos una serie nueva: varias semanas seguidas sobre un mismo tema o un libro
              de la Biblia. <strong>Todas quedan grabadas y ordenadas por serie en YouTube.</strong>
            </p>
          </div>

          {/* El arte va limpio y entero, y el texto debajo: la portada ya trae
              su propio título, y encima de ella lo tapaba y lo duplicaba. Si la
              serie tiene versión vertical, el celular usa esa. */}
          <a class="lz-serie" href={seriesPlaylistUrl} target="_blank" rel="noopener noreferrer" data-r>
            <span class="lz-serie__art">
              <picture>
                {currentSeries.mobileImage && <source media="(max-width: 767px)" srcset={currentSeries.mobileImage} />}
                <img src={currentSeries.image} alt={currentSeries.title} loading="lazy" />
              </picture>
            </span>
            <span class="lz-serie__bar">
              <span class="lz-serie__info">
                <span class="lz-spaced">{currentSeries.subtitle}</span>
                <span class="lz-serie__title">{currentSeries.title}</span>
              </span>
              <span class="lz-btn">Explorar la serie</span>
            </span>
          </a>

          {pastSeries.length > 0 && (
            <ol class="lz-past">
              {pastSeries.map((series) => (
                <li data-r>
                  <a href={series.href} target="_blank" rel="noopener noreferrer">
                    <span class="lz-past__title">{series.title.toLowerCase()}</span>
                    <span class="lz-spaced">{series.subtitle}</span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </div>
      </section>
    )}

    <!-- ══════════ QUÉ ESTÁ PASANDO ══════════
         Como el feed: piezas 4:5, foto con viñeta, título en mayúscula pesada
         con mezcla de pesos y el logo abajo. -->
    {agenda.length > 0 && (
      <section class="lz-section lz-dark lz-dark--2" id="agenda">
        <div class="lz-wrap">
          <div class="lz-head">
            <h2 class="lz-lockup lz-lockup--md" data-r>
              <span>qué está</span>
              <span class="lz-lockup__shift">pasando</span>
            </h2>
            <p class="lz-quote lz-quote--side" data-r>
              Caminemos juntos. <strong>Mirá las próximas clases, eventos y encuentros de la casa.</strong>
            </p>
          </div>
          {/* Los anuncios ya son flyers con su propio texto: van limpios,
              como en el feed, y el título va abajo. */}
          <div class="lz-feed">
            {agenda.map((item) => (
              <a class="lz-flyer" href={item.href} data-r>
                {item.image ? (
                  <span class="lz-flyer__img"><img src={item.image} alt={item.alt} loading="lazy" /></span>
                ) : (
                  <span
                    class="lz-flyer__img lz-flyer__img--empty"
                    style={`--m: ${(item.slug && ministryColors[item.slug]) ?? '#c5a059'}`}
                  >
                    {item.logo && <img src={item.logo} alt="" loading="lazy" />}
                  </span>
                )}
                <span class="lz-spaced">{item.eyebrow}</span>
                <span class="lz-flyer__title lz-caps-mix">
                  <span>{splitTitle(item.title)[0]}</span>
                  {splitTitle(item.title)[1]}
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ══════════ DEVOCIONAL ══════════ La placa del feed, tal cual. -->
    {devotional && (
      <section class="lz-section lz-dark">
        <div class="lz-wrap lz-devo">
          <div class="lz-devo__text">
            <p class="lz-spaced" data-r>Devocional</p>
            <h2 class="lz-title" data-r>Contenido sobre vida cristiana, formación y aliento bíblico para tu semana.</h2>
            <div class="lz-devo__post" data-r>
              <span class="lz-spaced">{devotional.weekLabel}</span>
              <span class="lz-devo__name">{devotional.title}</span>
            </div>
            <a class="lz-btn" href="/devocional" data-r>Ver todos los devocionales</a>
          </div>

          <a class="lz-plate lz-plate--tile" href="/devocional" data-r>
            <div class="lz-mesh" aria-hidden="true"></div>
            <p class="lz-quote">{devotional.excerpt}</p>
            <span class="lz-lockup lz-lockup--tile">
              <span>devocional</span>
              <span class="lz-lockup__shift">semanal</span>
            </span>
            <span class="lz-logo lz-logo--post" aria-hidden="true"><img src="/brand/logowhite.png" alt="" /></span>
          </a>
        </div>
      </section>
    )}

    <!-- ══════════ MINISTERIOS ══════════
         Todas van sobre un degradé del color de cada ministerio. Los que tienen
         logo lo muestran; los demás, sólo el nombre: las fotos de esas fichas
         eran imágenes externas de relleno, no material de la casa. -->
    <section class="lz-section lz-dark lz-dark--2" id="ministerios">
      <div class="lz-wrap">
        <div class="lz-head">
          <h2 class="lz-lockup lz-lockup--md" data-r>
            <span>encontrá</span>
            <span class="lz-lockup__shift">tu lugar</span>
          </h2>
          <p class="lz-quote lz-quote--side" data-r>
            Ministerios. <strong>Encontrá tu lugar para servir y crecer.</strong>
          </p>
        </div>
        <div class="lz-feed">
          {ministries.map((ministry) => (
            <a
              class={`lz-post lz-post--logo${logoSlugs.has(ministry.slug) ? '' : ' lz-post--solo'}`}
              href={`/ministerios/${ministry.slug}`}
              style={`--m: ${ministryColors[ministry.slug] ?? '#c5a059'}`}
              data-r
            >
              {logoSlugs.has(ministry.slug) && (
                <img class="lz-post__img" src={ministry.image} alt={`Ministerio ${ministry.name}`} loading="lazy" />
              )}
              <span class="lz-spaced lz-post__top">{ministry.area}</span>
              <span class="lz-post__title lz-post__title--big">{ministry.name}</span>
              <span class="lz-logo lz-logo--post" aria-hidden="true"><img src="/brand/logowhite.png" alt="" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ RADIO ══════════ -->
    <section class="lz-plate lz-plate--full lz-radio" id="radio">
      <div class="lz-mesh" aria-hidden="true"></div>
      <div class="lz-wrap lz-radio__inner">
        <p class="lz-quote" data-r>La frecuencia del cielo. <strong>24/7 conectados con vos.</strong></p>
        <h2 class="lz-lockup lz-lockup--lg" data-r>
          <span>radio</span>
          <span class="lz-lockup__shift">corazón</span>
        </h2>
        <span class="lz-tag" data-r>Próximamente</span>
      </div>
    </section>

</NocheLayout>
