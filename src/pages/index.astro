---
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Navbar from '../components/Navbar.astro';
import { seriesPlaylistUrl } from '../data/series';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAnnouncements, getDevotionals, getMinistries, getSeries } from '../lib/content/collections';

const logoSlugs = new Set(['gold', 'kids', 'arde']);

const [devotionalPosts, ministries, sermonSeries, announcements] = await Promise.all([
  getDevotionals(),
  getMinistries(),
  getSeries(),
  getAnnouncements(),
]);

const currentDevotionalPost = devotionalPosts[0];

// Una serie recién agregada desde el panel arranca sin portada ni link. Se
// muestra en el sitio recién cuando la terminan de completar; si no, el inicio
// mostraría una imagen rota y un link muerto.
const publishedSeries = sermonSeries.filter((series) => series.image && series.href);
const [currentSeries, ...recentSeries] = publishedSeries;
const getYouTubeEmbedUrl = (videoUrl?: string) => {
  if (!videoUrl) return null;
  try {
    const url = new URL(videoUrl);
    const idFromPath = url.pathname.startsWith('/live/') ? url.pathname.split('/live/')[1] : null;
    const idFromQuery = url.searchParams.get('v');
    const videoId = idFromQuery || idFromPath;
    return videoId ? `https://www.youtube.com/embed/${videoId}` : videoUrl;
  } catch {
    return videoUrl;
  }
};
const currentDevotionalEmbedUrl = getYouTubeEmbedUrl(currentDevotionalPost?.videoUrl);
---

<BaseLayout>
  <Navbar transparent />
  <Hero />

  <main data-cinematic-page="home" class="home-cinematic bg-[#11110f]">
    <section data-animate="reveal" class="cinematic-light-section relative bg-[#e9e4da] py-20 md:py-32">
      <div class="mx-auto grid max-w-[90rem] grid-cols-1 gap-12 px-5 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-20 lg:px-8">
        <div class="border-l-2 border-primary pl-6 sm:pl-8">
          <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
            <span class="tabular-nums">01</span>
            <span class="h-px w-8 bg-primary/60"></span>
            Quiénes somos
          </p>
          <h2 data-cinematic-heading class="font-display text-4xl font-semibold leading-[1.04] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
            Existimos para ministrar al Señor y encender una generación.
          </h2>
        </div>
        <div data-cinematic-copy class="space-y-6 border-t border-charcoal/15 pt-8 text-base leading-relaxed text-charcoal/75 sm:text-lg">
          <p>
            Iglesia Corazón de Fuego es una casa de adoración, oración y formación. Nos reunimos para darle a Dios gratitud y alabanza, afirmar quién es Él, interceder por lo que desea hacer y caminar como familia en el propósito que nos confió.
          </p>
          <a class="editorial-link text-charcoal" href="/nosotros">
            Conocé más de nosotros
            <span class="material-symbols-outlined text-sm">arrow_outward</span>
          </a>
        </div>
      </div>
    </section>

    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#151514] py-20 text-white md:py-32" id="series">
      <div aria-hidden="true" class="cinematic-orb cinematic-orb--right"></div>
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/70 to-transparent"></div>

      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-3xl md:mb-16">
          <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
            <span class="tabular-nums">02</span>
            <span class="h-px w-8 bg-primary/60"></span>
            Series
          </p>
          <h2 data-cinematic-heading class="font-display text-4xl font-semibold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
            Lo que estamos predicando.
          </h2>
        </div>

        {/* Las series se editan desde el panel, así que la lista puede quedar
            vacía. Sin esta guarda el inicio rompe entero. */}
        {currentSeries && (
          <a
            data-animate="card"
            data-cinematic-card
            href={currentSeries.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver serie ${currentSeries.title}`}
            class="group relative block"
          >
            <div class="relative h-[24rem] overflow-hidden rounded-smooth sm:h-[30rem] lg:h-[34rem]">
              <picture>
                {currentSeries.mobileImage && <source media="(max-width: 767px)" srcset={currentSeries.mobileImage} />}
                <img
                  data-cinematic="image"
                  src={currentSeries.image}
                  alt={`Serie ${currentSeries.title}`}
                  class="absolute inset-0 h-full w-full object-cover object-center [filter:brightness(0.7)_saturate(0.72)_contrast(1.1)]"
                />
              </picture>
            </div>
            <div class="relative mt-8 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
              <div class="max-w-2xl">
                <p class="mb-4 text-[0.65rem] font-bold uppercase tracking-[0.26em] text-primary">{currentSeries.label} · Abril</p>
                <h3 class="font-display text-3xl font-semibold leading-tight text-white sm:text-4xl lg:text-5xl">{currentSeries.title}</h3>
                <p class="mt-4 text-sm leading-relaxed text-white/65 sm:text-base">{currentSeries.description}</p>
              </div>
              <span class="editorial-link shrink-0 text-white">
                Ver en YouTube
                <span class="material-symbols-outlined text-sm">arrow_outward</span>
              </span>
            </div>
          </a>
        )}

        <div class="mt-14 md:mt-20">
          <div class="mb-7 flex items-end justify-between gap-6 border-t border-white/10 pt-7">
            <h3 class="font-display text-xl tracking-tight text-white/85 sm:text-2xl">Series anteriores</h3>
            <a
              href={seriesPlaylistUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="editorial-link shrink-0 text-white/70"
            >
              Ver todas
              <span class="material-symbols-outlined text-sm">arrow_outward</span>
            </a>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
            {
              recentSeries.map((series) => (
                <a
                  data-animate="card"
                  data-cinematic-card
                  href={series.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver serie ${series.title}`}
                  class="group block"
                >
                  <div class="relative aspect-square overflow-hidden rounded-soft">
                    <img
                      src={series.image}
                      alt={`Serie ${series.title}`}
                      class="h-full w-full object-cover transition-[filter,transform] duration-700 ease-out [filter:brightness(0.66)_saturate(0.35)_contrast(1.08)] group-hover:scale-[1.03] group-hover:[filter:brightness(0.9)_saturate(0.85)_contrast(1.05)]"
                    />
                  </div>
                  <p class="mt-3 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-white/60 transition-colors group-hover:text-primary">
                    {series.title}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section data-animate="reveal" class="cinematic-light-section relative bg-[#f2eee6] py-20 md:py-32" id="novedades">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-3xl md:mb-16">
          <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
            <span class="tabular-nums">03</span>
            <span class="h-px w-8 bg-primary/60"></span>
            Anuncios
          </p>
          <h2 data-cinematic-heading class="font-display text-4xl font-semibold leading-[1.04] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
            Lo que está sucediendo en nuestra casa.
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-6">
          {
            announcements.map((item) => (
              <a
                data-animate="card"
                data-cinematic-card
                href={item.href}
                aria-label={`Ver más sobre ${item.title}`}
                class="group flex flex-col"
              >
                {/* Los flyers vienen de redes, con textos hasta el borde y muy
                    saturados. object-contain evita recortarles información y el
                    grading los baja al tono del resto de la página. */}
                <div class="relative aspect-[4/3] overflow-hidden rounded-soft bg-[#e2dbcd]">
                  <img
                    src={item.image}
                    alt={item.alt}
                    class="h-full w-full object-contain transition-[filter,transform] duration-700 ease-out [filter:saturate(0.6)_contrast(1.02)_brightness(0.98)] group-hover:scale-[1.02] group-hover:[filter:saturate(1)_contrast(1)_brightness(1)]"
                  />
                </div>
                <div class="flex flex-1 flex-col pt-6">
                  <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">{item.eyebrow}</p>
                  <h3 class="mt-3 font-display text-2xl leading-tight text-charcoal">{item.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-charcoal/65">{item.description}</p>
                  <span class="editorial-link mt-6 text-charcoal">
                    Ver más
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {currentDevotionalPost && (
      <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#1a1a18] py-20 text-white md:py-32" id="devocional">
        <div aria-hidden="true" class="cinematic-orb cinematic-orb--left"></div>
        <div class="absolute right-0 top-0 h-full w-px bg-primary/30"></div>

        <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
          <div class="mb-12 max-w-3xl md:mb-16">
            <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
              <span class="tabular-nums">04</span>
              <span class="h-px w-8 bg-primary/60"></span>
              Devocional
            </p>
            <h2 data-cinematic-heading class="font-display text-4xl font-semibold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
              Una palabra para esta semana.
            </h2>
          </div>

          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-14">
            <div data-cinematic-copy class="order-2 lg:order-1">
              <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">{currentDevotionalPost.weekLabel}</p>
              <h3 class="mt-4 font-display text-3xl leading-tight text-white sm:text-4xl">{currentDevotionalPost.title}</h3>
              <p class="mt-5 text-base leading-relaxed text-white/70">{currentDevotionalPost.excerpt}</p>
              <a href="/devocional" class="editorial-link mt-8 text-white">
                Leer el devocional
                <span class="material-symbols-outlined text-sm">arrow_outward</span>
              </a>
            </div>

            <div data-animate="card" data-cinematic-card class="order-1 overflow-hidden rounded-smooth lg:order-2">
              {currentDevotionalEmbedUrl ? (
                <iframe
                  class="aspect-video w-full"
                  src={currentDevotionalEmbedUrl}
                  title={currentDevotionalPost.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              ) : (
                <img
                  data-cinematic="image"
                  src={currentDevotionalPost.image}
                  alt={currentDevotionalPost.title}
                  class="aspect-video w-full object-cover [filter:brightness(0.82)_saturate(0.78)_contrast(1.06)]"
                />
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Bloque secundario del inicio: son nueve areas y ninguna es la entrada
        principal del visitante nuevo. Va compacto a proposito, con la ficha de
        cada ministerio cargando el peso. */}
    <section data-animate="reveal" class="cinematic-light-section relative bg-[#e9e4da] py-16 md:py-20" id="ministerios">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-6 md:mb-10">
          <div class="max-w-2xl">
            <p class="mb-4 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
              <span class="tabular-nums">05</span>
              <span class="h-px w-8 bg-primary/60"></span>
              Ministerios
            </p>
            <h2 data-cinematic-heading class="font-display text-3xl font-semibold leading-[1.06] tracking-tight text-charcoal sm:text-4xl">
              Áreas donde servimos y crecemos juntos.
            </h2>
          </div>
          <a href="/ministerios" class="editorial-link text-charcoal">
            Ver todos
            <span class="material-symbols-outlined">arrow_outward</span>
          </a>
        </div>

        <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-6 xl:grid-cols-9 lg:gap-5">
          {
            ministries.map((ministry) => (
              <a
                data-animate="card"
                data-cinematic-card
                class="group flex flex-col"
                href={`/ministerios/${ministry.slug}`}
              >
                <div class={`relative aspect-square overflow-hidden rounded-soft ${logoSlugs.has(ministry.slug) ? 'bg-white p-3' : ''}`}>
                  <img
                    alt={`Ministerio ${ministry.name}`}
                    class={
                      logoSlugs.has(ministry.slug)
                        ? 'h-full w-full object-contain'
                        : 'h-full w-full object-cover transition-[filter,transform] duration-700 ease-out [filter:saturate(0.7)_contrast(1.06)_brightness(0.94)] group-hover:scale-[1.03] group-hover:[filter:saturate(0.95)_contrast(1.02)_brightness(1)]'
                    }
                    src={ministry.image}
                  />
                </div>
                <div class="pt-3">
                  <h3 class="font-display text-sm leading-tight text-charcoal transition-colors group-hover:text-primary">{ministry.name}</h3>
                  <p class="mt-1 text-[0.55rem] font-bold uppercase tracking-[0.18em] text-charcoal/45">{ministry.area}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#121211] py-20 text-white md:py-28" id="radio">
      <div aria-hidden="true" class="cinematic-grain absolute inset-0 opacity-20 mix-blend-soft-light"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-end gap-10 border-t border-primary/30 pt-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
          <div>
            <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
              <span class="tabular-nums">06</span>
              <span class="h-px w-8 bg-primary/60"></span>
              Radio
            </p>
            <h2 data-cinematic-heading class="font-display text-4xl font-semibold leading-[1.02] tracking-tight text-white sm:text-5xl lg:text-6xl">
              Radio Corazón
            </h2>
            <div class="mt-5 flex items-center gap-3">
              <span class="text-xs uppercase tracking-[0.24em] text-white/50">La frecuencia del cielo</span>
              <div class="audio-wave flex h-3 items-end gap-[3px]">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
          </div>
          <div data-cinematic-copy class="flex flex-col items-start gap-5 lg:items-end">
            <span class="inline-flex border border-primary/60 px-4 py-2 text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Próximamente</span>
            <p class="text-sm italic text-white/50 lg:text-right">“24/7 conectados contigo.”</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
