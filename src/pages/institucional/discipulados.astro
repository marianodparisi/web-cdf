---
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pillars = [
  {
    index: '01',
    label: 'Enfoque',
    title: 'Fundamentos de la fe',
    text: 'Estudiamos la Biblia desde una base clara y pastoral para que cada nuevo creyente entienda el mensaje del Evangelio y pueda afirmarse en su nueva vida en Cristo.',
  },
  {
    index: '02',
    label: 'Modalidad',
    title: 'Clases los sábados',
    text: 'Las clases se desarrollan los sábados, en un formato simple y accesible, para avanzar semana a semana en temas centrales de la vida cristiana.',
  },
  {
    index: '03',
    label: 'Acompañamiento',
    title: 'Profesores diferentes',
    text: 'Cada etapa cuenta con distintos profesores, aportando perspectivas complementarias y ayudando a que el proceso sea más dinámico y enriquecedor.',
  },
];

const topics = [
  { title: 'La Biblia', text: 'Cómo leerla, entenderla y tomarla como base para la vida diaria.' },
  { title: 'El Evangelio', text: 'La obra de Jesús, la salvación y el significado de una nueva vida en Cristo.' },
  { title: 'Vida cristiana', text: 'Oración, obediencia, comunión y crecimiento personal en la fe.' },
  { title: 'Iglesia y servicio', text: 'Cómo integrarse a la comunidad y comenzar a caminar con propósito.' },
];

const summary = [
  'Estudio para personas recién convertidas en el Evangelio',
  'Clases bíblicas los sábados',
  'Profesores diferentes durante el proceso',
  'Un enfoque simple, pastoral y formativo',
  'Diferente de IETE, que tiene un perfil más institucional',
];

const fieldClass =
  'w-full rounded-soft border border-charcoal/15 bg-white px-4 py-3 text-sm text-charcoal outline-none transition-colors placeholder:text-charcoal/35 hover:border-primary/50 focus:border-primary';
const labelClass = 'mb-2 block text-[0.62rem] font-bold uppercase tracking-[0.22em] text-charcoal/60';
---

<BaseLayout title="Discipulados | Iglesia Corazon de Fuego">
  <Navbar />

  <main data-cinematic-page="discipulados" class="bg-[#11110f]">
    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#151514] py-16 text-white md:py-24">
      <div aria-hidden="true" class="cinematic-orb cinematic-orb--left"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <a href="/#institucional" class="editorial-link text-white/70">
          <span class="material-symbols-outlined">arrow_back</span>
          Volver a institucional
        </a>

        <p class="mb-5 mt-10 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
          <span class="h-px w-8 bg-primary/60"></span>
          Discipulados
        </p>
        <h1 data-cinematic-heading class="max-w-4xl font-display text-4xl font-semibold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Un espacio para dar tus primeros pasos firmes en el Evangelio.
        </h1>
        <p data-cinematic-copy class="mt-7 max-w-2xl text-base leading-relaxed text-white/70 sm:text-lg">
          Discipulados está pensado especialmente para personas recién convertidas que quieren conocer mejor la Biblia, crecer en su fe y empezar a construir fundamentos sólidos para su vida cristiana.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#como-funciona" class="editorial-button bg-white/[0.06] text-white">
            <span>Cómo funciona</span>
            <span class="material-symbols-outlined">arrow_outward</span>
          </a>
          <a href="#clases" class="editorial-button bg-transparent text-white ring-1 ring-inset ring-white/25">
            <span>Ver clases</span>
            <span class="material-symbols-outlined">arrow_outward</span>
          </a>
        </div>
      </div>
    </section>

    <section id="como-funciona" data-animate="reveal" class="cinematic-light-section relative bg-[#e9e4da] py-20 md:py-28">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <div class="mb-12 grid grid-cols-1 gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20 md:mb-16">
          <div class="border-l-2 border-primary pl-6 sm:pl-8">
            <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">¿Qué es Discipulados?</p>
            <h2 data-cinematic-heading class="mt-5 font-display text-3xl font-semibold leading-[1.06] tracking-tight text-charcoal sm:text-4xl">
              Formación inicial, cercana y práctica.
            </h2>
          </div>
          <div data-cinematic-copy class="space-y-6 border-t border-charcoal/15 pt-8 text-base leading-relaxed text-charcoal/75 sm:text-lg">
            <p>
              Es un estudio pensado para acompañar a quienes están comenzando en la fe. Buscamos que cada persona pueda entender las bases del Evangelio, afirmar su relación con Jesús y aprender a caminar con la Biblia como guía.
            </p>
            <p>
              No es un espacio académico como IETE, sino una instancia de formación inicial, cercana y práctica para crecer paso a paso dentro de la vida cristiana.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-10 border-t border-charcoal/15 pt-12 md:grid-cols-3 md:gap-8">
          {
            pillars.map((pillar) => (
              <article data-animate="card" data-cinematic-card class="flex flex-col">
                <div class="flex items-baseline gap-3">
                  <span class="font-display text-sm font-bold tabular-nums tracking-[0.2em] text-primary">{pillar.index}</span>
                  <span class="h-px flex-1 bg-charcoal/15"></span>
                </div>
                <p class="mt-5 text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">{pillar.label}</p>
                <h3 class="mt-3 font-display text-2xl leading-tight text-charcoal">{pillar.title}</h3>
                <p class="mt-4 text-sm leading-relaxed text-charcoal/70">{pillar.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="clases" data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#1a1a18] py-20 text-white md:py-28">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/70 to-transparent"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-3xl md:mb-16">
          <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
            <span class="h-px w-8 bg-primary/60"></span>
            Clases y contenido
          </p>
          <h2 data-cinematic-heading class="font-display text-3xl font-semibold leading-[1.06] tracking-tight text-white sm:text-4xl lg:text-5xl">
            ¿Qué se trabaja en Discipulados?
          </h2>
          <p data-cinematic-copy class="mt-7 text-base leading-relaxed text-white/70">
            El objetivo es que cada persona pueda conocer, entender y practicar principios esenciales de la vida cristiana.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            topics.map((topic) => (
              <article data-animate="card" data-cinematic-card class="cinematic-dark-card flex min-h-56 flex-col border border-white/10 bg-white/[0.035] p-7 transition-colors hover:border-primary/50 hover:bg-white/[0.07]">
                <h3 class="font-display text-xl leading-tight text-white">{topic.title}</h3>
                <p class="mt-4 text-sm leading-relaxed text-white/65">{topic.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section data-animate="reveal" class="cinematic-light-section relative bg-[#f2eee6] py-20 md:py-28">
      <div class="mx-auto grid max-w-[90rem] grid-cols-1 gap-12 px-5 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-20 lg:px-8">
        <div class="border-l-2 border-primary pl-6 sm:pl-8">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">¿Para quién es?</p>
          <h2 data-cinematic-heading class="mt-5 font-display text-3xl font-semibold leading-[1.06] tracking-tight text-charcoal sm:text-4xl lg:text-5xl">
            Para quienes están comenzando.
          </h2>
          <p class="mt-7 text-base leading-relaxed text-charcoal/75">
            Si recibiste a Jesús hace poco, si estás empezando a conocer la Biblia o si necesitás ordenar tus bases en la fe, este espacio es para vos.
          </p>
        </div>

        <div data-cinematic-copy class="border-t border-charcoal/15 pt-8">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Resumen</p>
          <ul class="mt-7 divide-y divide-charcoal/10">
            {
              summary.map((item) => (
                <li class="flex items-start gap-4 py-4 text-base leading-relaxed text-charcoal/80">
                  <span aria-hidden="true" class="mt-2 h-1 w-4 shrink-0 bg-primary"></span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="contacto-discipulados" data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#121211] py-20 text-white md:py-28">
      <div aria-hidden="true" class="cinematic-grain absolute inset-0 opacity-20 mix-blend-soft-light"></div>
      <div class="relative mx-auto grid max-w-[90rem] grid-cols-1 gap-12 px-5 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20 lg:px-8">
        <div class="border-l-2 border-primary pl-6 sm:pl-8">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">Contacto</p>
          <h2 data-cinematic-heading class="mt-5 font-display text-3xl font-semibold leading-[1.06] tracking-tight text-white sm:text-4xl">
            Quiero sumarme a Discipulados.
          </h2>
          <p class="mt-7 text-base leading-relaxed text-white/70">
            Si querés comenzar, conocer los horarios o recibir más información sobre las clases de los sábados, dejanos tus datos y nos comunicamos con vos.
          </p>
        </div>

        <form data-animate="card" data-cinematic-card class="border-t border-white/10 pt-8">
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label class={labelClass} for="whatsapp">WhatsApp *</label>
              <input id="whatsapp" name="whatsapp" type="text" required class={fieldClass} placeholder="10 dígitos" />
            </div>
            <div class="sm:col-span-2">
              <label class={labelClass} for="correo">Correo electrónico *</label>
              <input id="correo" name="correo" type="email" required class={fieldClass} placeholder="tu@correo.com" />
            </div>
            <div class="sm:col-span-2">
              <label class={labelClass} for="nombres">Nombre(s) *</label>
              <input id="nombres" name="nombres" type="text" required class={fieldClass} placeholder="Tus nombres" />
            </div>
            <div>
              <label class={labelClass} for="apellido1">Primer apellido *</label>
              <input id="apellido1" name="apellido1" type="text" required class={fieldClass} placeholder="Primer apellido" />
            </div>
            <div>
              <label class={labelClass} for="apellido2">Segundo apellido</label>
              <input id="apellido2" name="apellido2" type="text" class={fieldClass} placeholder="Segundo apellido" />
            </div>
          </div>

          <label class="mt-7 flex items-start gap-3 text-sm leading-relaxed text-white/65" for="privacidad">
            <input id="privacidad" name="privacidad" type="checkbox" class="mt-1 h-4 w-4 shrink-0 rounded-sm border-white/30 bg-transparent accent-primary" />
            <span>Acepto el aviso de privacidad y protección de datos personales de la iglesia</span>
          </label>

          <button type="button" class="editorial-button mt-9 bg-white/[0.06] text-white">
            <span>Enviar solicitud</span>
            <span class="material-symbols-outlined">arrow_outward</span>
          </button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
