---
/**
 * Página de sede, en el lenguaje noche. El contenido sale de
 * `src/data/maqueta-anexos.ts` y cada sede tiñe la página con su color.
 */
import NocheLayout from '../../layouts/NocheLayout.astro';
import NocheHero from '../../components/noche/NocheHero.astro';
import NocheCta from '../../components/noche/NocheCta.astro';
import { maquetaAnexos } from '../../data/maqueta-anexos';
import { getMinistries } from '../../lib/content/collections';

const { slug } = Astro.params;

const index = maquetaAnexos.findIndex((a) => a.slug === slug);
const anexo = maquetaAnexos[index];
if (!anexo) return Astro.redirect('/');

const next = maquetaAnexos[(index + 1) % maquetaAnexos.length];
const ministries = await getMinistries();

const fotos = ['/sedes/nosotros1.JPG', '/sedes/nosotros2.JPG', '/sedes/nosotros3.JPG'];
const mapsHref = `https://www.google.com/maps/search/${encodeURIComponent(anexo.addressLines.join(' '))}`;
---

<NocheLayout title={`Sede ${anexo.name} · Iglesia Corazón de Fuego`}>
  <div class="lz-tint" style={`--m: ${anexo.color}`}>
    <NocheHero lines={[anexo.name.toLowerCase()]} kicker="Nuestras sedes" lead={anexo.subtitle} image={anexo.heroImage}>
      <a class="lz-btn" href="#llegar">Cómo llegar</a>
      <a class="lz-btn lz-btn--ghost" href="#horarios">Ver horarios</a>
    </NocheHero>

    <section class="lz-section lz-dark" id="historia">
      <div class="lz-wrap lz-split">
        <div>
          <span class="lz-spaced lz-kicker" data-r>Nuestra historia</span>
          <h2 class="lz-title" data-r>{anexo.storyTitle}</h2>
          <div class="lz-stats" data-r>
            <div class="lz-stat">
              <strong>{anexo.yearsValue}</strong>
              <span>{anexo.yearsLabel}</span>
            </div>
            <div class="lz-stat">
              <strong>{anexo.localValue}</strong>
              <span>{anexo.localLabel}</span>
            </div>
          </div>
        </div>
        <div class="lz-prose" data-r>
          {anexo.storyParagraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="lz-wrap" style="margin-top: clamp(56px, 7vw, 96px)">
        <img class="lz-wide" src={anexo.storyImage} alt={`Sede ${anexo.name}`} loading="lazy" data-r />
      </div>
    </section>

    <section class="lz-plate lz-statement" id="horarios">
      <div class="lz-mesh" aria-hidden="true"></div>
      <div class="lz-wrap lz-split">
        <div>
          <span class="lz-spaced lz-kicker" data-r>Horarios</span>
          <h2 class="lz-title" data-r>Cuándo nos reunimos.</h2>
          <div class="lz-times" style="margin-top: 28px" data-r>
            {anexo.meetingsLines.map((linea) => {
              const [dia, hora] = linea.split('—').map((s) => s.trim());
              return (
                <div class="lz-time">
                  <span class="lz-time__day">{dia}</span>
                  {hora && <span class="lz-time__hour">{hora}</span>}
                </div>
              );
            })}
          </div>
        </div>
        <div id="llegar">
          <span class="lz-spaced lz-kicker" data-r>Cómo llegar</span>
          <h2 class="lz-title" data-r>{anexo.locationTitle}</h2>
          <div class="lz-data" data-r>
            <span class="lz-spaced">Dirección</span>
            {anexo.addressLines.map((l) => <p>{l}</p>)}
          </div>
          <div class="lz-actions" style="margin-top: 24px" data-r>
            <a class="lz-btn" href={mapsHref} target="_blank" rel="noopener noreferrer">Abrir en Maps</a>
          </div>
        </div>
      </div>
    </section>

    <section class="lz-section lz-dark" id="ministerios">
      <div class="lz-wrap">
        <div class="lz-head">
          <h2 class="lz-lockup lz-lockup--md" data-r>
            <span>áreas</span>
            <span class="lz-lockup__shift">de la sede</span>
          </h2>
          <p class="lz-quote lz-quote--side" data-r>Ministerios. <strong>Áreas que funcionan en la sede.</strong></p>
        </div>
        <div class="lz-tiles">
          {ministries.slice(0, 6).map((m) => (
            <a class="lz-tile" href={`/ministerios/${m.slug}`} data-r>
              <span class="lz-tile__name">{m.name}</span>
              <span class="lz-spaced">{m.area}</span>
              <span class="lz-tile__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <div class="lz-photos" style="margin-top: clamp(56px, 7vw, 96px)" data-r>
          {fotos.map((src) => <img src={src} alt="" loading="lazy" />)}
        </div>
      </div>
    </section>

    <NocheCta
      title={anexo.ctaTitle}
      text={anexo.ctaText}
      next={{ label: 'Siguiente sede', title: next.name, href: `/anexos/${next.slug}` }}
    >
      <a class="lz-btn" href="/contact">Escribinos</a>
      <a class="lz-btn lz-btn--ghost" href="https://maps.app.goo.gl/mEVMgoTXbV3BULVq8" target="_blank" rel="noopener noreferrer">Tu primera vez</a>
    </NocheCta>
  </div>
</NocheLayout>
