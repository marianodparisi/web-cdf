---
/**
 * Listado de sedes.
 *
 * Reusa `.as-sedes`, la misma grilla de hairlines que ya usan las páginas
 * internas, en vez de inventar un bloque nuevo. La lista sale de la única
 * fuente que hay, la que exporta el layout, así que el nav, el footer y esta
 * página no se pueden desincronizar.
 */
import MaquetaLayout, { sedes } from '../../layouts/MaquetaLayout.astro';

/* La primera entrada es "Sede Central", que apunta a este mismo listado: acá
   sería un link a sí mismo. */
const anexos = sedes.filter((sede) => sede.href !== '/anexos');
---

<MaquetaLayout title="Nuestras Sedes · Iglesia Corazón de Fuego">
  <section class="as-section">
    <div class="as-wrap">
      <div class="as-head">
        <div>
          <p class="as-eyebrow" data-reveal>Nuestras Sedes</p>
          <h1 class="as-h1" data-reveal="words">Una iglesia en varias ciudades.</h1>
        </div>
      </div>

      <div class="as-sedes" data-reveal>
        {
          anexos.map((sede) => (
            <a class="as-sede" href={sede.href}>
              <h4>{sede.name}</h4>
              <p>{sede.region}</p>
              <span class="as-sede__arrow material-symbols-outlined">arrow_forward</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</MaquetaLayout>
