---
/**
 * Listado de sedes, en el lenguaje noche. La lista sale de los mismos datos
 * que usa cada página de sede.
 */
import NocheLayout from '../../layouts/NocheLayout.astro';
import NocheHero from '../../components/noche/NocheHero.astro';
import NocheCta from '../../components/noche/NocheCta.astro';
import { maquetaAnexos } from '../../data/maqueta-anexos';
---

<NocheLayout title="Nuestras Sedes · Iglesia Corazón de Fuego">
  <NocheHero lines={['nuestras', 'sedes']} lead="Una iglesia en varias ciudades." image="/sedes/nosotros3.JPG" short />

  <section class="lz-section lz-dark">
    <div class="lz-wrap">
      <div class="lz-tiles">
        {maquetaAnexos.map((a) => (
          <a class="lz-tile" href={`/anexos/${a.slug}`} data-r>
            <span class="lz-tile__name">{a.name}</span>
            <span class="lz-spaced">{a.addressLines[0] ?? a.yearsLabel}</span>
            <span class="lz-tile__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <NocheCta title="Te esperamos." text="Vení a conocernos este fin de semana en cualquiera de nuestras sedes.">
    <a class="lz-btn" href="https://maps.app.goo.gl/mEVMgoTXbV3BULVq8" target="_blank" rel="noopener noreferrer">Tu primera vez</a>
    <a class="lz-btn lz-btn--ghost" href="/contact">Escribinos</a>
  </NocheCta>
</NocheLayout>
