---
/**
 * Nosotros, en el lenguaje noche del inicio. Los textos son los de la página
 * anterior; cambia el envoltorio.
 */
import NocheLayout from '../layouts/NocheLayout.astro';
import NocheHero from '../components/noche/NocheHero.astro';
import NocheCta from '../components/noche/NocheCta.astro';
import { maquetaAnexos } from '../data/maqueta-anexos';
import { getMinistries } from '../lib/content/collections';

const ministries = await getMinistries();
const mapsUrl = 'https://maps.app.goo.gl/mEVMgoTXbV3BULVq8';

const pilares = [
  {
    n: '01',
    title: 'Darle a Dios el lugar central.',
    text: 'Nuestra primera respuesta es ministrar al Señor con gratitud, reverencia y alabanza.',
  },
  {
    n: '02',
    title: 'Ponernos de acuerdo con su voluntad.',
    text: 'Intercedemos por nuestras familias, la ciudad y todo lo que Dios desea transformar.',
  },
  {
    n: '03',
    title: 'Caminar como discípulos de Jesús.',
    text: 'Crecemos en comunidad para vivir la fe con carácter, convicción y servicio.',
  },
];

const fotos = ['/sedes/nosotros1.JPG', '/sedes/nosotros2.JPG', '/sedes/nosotros3.JPG'];
---

<NocheLayout title="Nosotros · Iglesia Corazón de Fuego">
  <NocheHero
    lines={['nosotros']}
    kicker="Iglesia Corazón de Fuego · Ramos Mejía"
    lead="Una casa para encontrarnos con Su presencia."
    video="/home/hero-v1-compressed.mp4"
    image="/sedes/nosotros1.JPG"
  >
    <Fragment slot="quote">
      Adoramos, oramos y caminamos juntos para conocer a Jesús y
      <strong>encender una generación que viva para Él.</strong>
    </Fragment>
    <a class="lz-btn" href={mapsUrl} target="_blank" rel="noopener noreferrer">Visitanos</a>
    <a class="lz-btn lz-btn--ghost" href="#historia">Nuestra historia</a>
  </NocheHero>

  <section class="lz-plate lz-statement" id="quienes">
    <div class="lz-mesh" aria-hidden="true"></div>
    <div class="lz-wrap lz-statement__grid">
      <div>
        <span class="lz-spaced lz-kicker" data-r>Quiénes somos</span>
        <h2 class="lz-statement__text" data-r>Una comunidad para encontrarte con Dios, crecer y servir.</h2>
      </div>
      <div class="lz-statement__body" data-r>
        <p class="lz-title">Adoración que se vuelve vida.</p>
        <p class="lz-body">
          Creemos que la iglesia es una familia espiritual llamada a revelar a Cristo con palabras,
          obras y una vida rendida a Dios.
        </p>
      </div>
    </div>
  </section>

  <section class="lz-section lz-dark">
    <div class="lz-wrap">
      <div class="lz-cols">
        {pilares.map((p) => (
          <div class="lz-col" data-r>
            <span class="lz-col__n">{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lz-section lz-dark lz-dark--2" id="historia">
    <div class="lz-wrap lz-split">
      <div>
        <span class="lz-spaced lz-kicker" data-r>Nuestra historia</span>
        <h2 class="lz-title" data-r>Una obra nacida en oración, espera y obediencia.</h2>
      </div>
      <div class="lz-prose" data-r>
        <p>
          Dios abrió camino para levantar una casa en Ramos Mejía. Desde el primer llamado hasta el
          terreno en una avenida visible, cada paso confirmó que Dios estaba preparando algo nuevo.
        </p>
        <p>
          Hoy somos una iglesia que alcanza, forma y envía, con un equipo disponible para servir y
          soñar por más.
        </p>
      </div>
    </div>
    <div class="lz-wrap" style="margin-top: clamp(56px, 7vw, 96px)">
      <div class="lz-photos" data-r>
        {fotos.map((src) => <img src={src} alt="" loading="lazy" />)}
      </div>
    </div>
  </section>

  <section class="lz-section lz-dark" id="sedes">
    <div class="lz-wrap">
      <div class="lz-head">
        <h2 class="lz-lockup lz-lockup--md" data-r>
          <span>nuestras</span>
          <span class="lz-lockup__shift">sedes</span>
        </h2>
        <p class="lz-quote lz-quote--side" data-r>Sedes. <strong>Una iglesia en varias ciudades.</strong></p>
      </div>
      <div class="lz-tiles">
        {maquetaAnexos.map((a) => (
          <a class="lz-tile" href={`/anexos/${a.slug}`} data-r>
            <span class="lz-tile__name">{a.name}</span>
            <span class="lz-spaced">{a.yearsValue} · {a.yearsLabel}</span>
            <span class="lz-tile__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="lz-section lz-dark lz-dark--2" id="ministerios">
    <div class="lz-wrap">
      <div class="lz-head">
        <h2 class="lz-lockup lz-lockup--md" data-r>
          <span>dónde</span>
          <span class="lz-lockup__shift">servimos</span>
        </h2>
        <p class="lz-quote lz-quote--side" data-r>Ministerios. <strong>Dónde servimos y crecemos.</strong></p>
      </div>
      <div class="lz-tiles">
        {ministries.slice(0, 6).map((m) => (
          <a class="lz-tile" href={`/ministerios/${m.slug}`} data-r>
            <span class="lz-tile__name">{m.name}</span>
            <span class="lz-spaced">{m.area}</span>
            <span class="lz-tile__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="lz-actions" style="margin-top: 32px" data-r>
        <a class="lz-btn lz-btn--ghost" href="/ministerios">Ver todos</a>
      </div>
    </div>
  </section>

  <NocheCta title="Te esperamos." text="Vení a conocernos este fin de semana en cualquiera de nuestras sedes.">
    <a class="lz-btn" href={mapsUrl} target="_blank" rel="noopener noreferrer">Tu primera vez</a>
    <a class="lz-btn lz-btn--ghost" href="/contact">Contactanos</a>
  </NocheCta>
</NocheLayout>
