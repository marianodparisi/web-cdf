---
/**
 * MAQUETA — "Nosotros", con la estructura de la página institucional de
 * austinstone.org. El texto sale de la /nosotros que ya existe en el sitio.
 */
import MaquetaLayout from '../layouts/MaquetaLayout.astro';
import { maquetaAnexos } from '../data/maqueta-anexos';
import { getMinistries } from '../lib/content/collections';

const ministries = await getMinistries();

const pilares = [
  {
    n: '01',
    title: 'Darle a Dios el lugar central.',
    text: 'Nuestra primera respuesta es ministrar al Señor con gratitud, reverencia y alabanza.',
  },
  {
    n: '02',
    title: 'Ponernos de acuerdo con su voluntad.',
    text: 'Intercedemos por nuestras familias, la ciudad y todo lo que Dios desea transformar.',
  },
  {
    n: '03',
    title: 'Caminar como discípulos de Jesús.',
    text: 'Crecemos en comunidad para vivir la fe con carácter, convicción y servicio.',
  },
];

const fotos = [
  '/sedes/nosotros1.JPG',
  '/ministries/life/life1.jpg',
  '/sedes/nosotros2.JPG',
  '/ministries/life/life3.jpg',
  '/sedes/nosotros3.JPG',
  '/ministries/life/life2.jpeg',
];
---

<MaquetaLayout title="Nosotros · Iglesia Corazón de Fuego">
  <div class="as-ministry" style="--m: #c5a059">
    <header class="as-hero as-hero--inner">
      <div class="as-hero__bg">
        <video autoplay muted loop playsinline preload="metadata" poster="/sedes/nosotros1.JPG">
          <source src="/home/hero-v1-compressed.mp4" type="video/mp4" />
        </video>
        <div class="as-hero__veil"></div>
      </div>
      <div class="as-hero__grid">
        <div class="as-hero__content">
          <p class="as-eyebrow as-eyebrow--light" data-reveal>Iglesia Corazón de Fuego · Ramos Mejía</p>
          <h1 class="as-display" data-reveal="words">Una casa para encontrarnos con Su presencia.</h1>
          <p class="as-hero__lead" data-reveal>
            Adoramos, oramos y caminamos juntos para conocer a Jesús y encender una generación que viva para Él.
          </p>
          <div class="as-hero__actions" data-reveal data-reveal-delay="140">
            <a class="as-button as-button--white" href="https://maps.app.goo.gl/mEVMgoTXbV3BULVq8" target="_blank" rel="noopener noreferrer">Visitanos</a>
            <a class="as-button as-button--ghost-white" href="#historia">Nuestra historia</a>
          </div>
        </div>
      </div>
    </header>

    <section class="as-section as-section--dark as-statement" id="quienes">
      <div class="as-wrap">
        <p class="as-eyebrow as-eyebrow--light" data-reveal>Quiénes somos</p>
        <h2 class="as-statement__text" data-reveal="words">
          Una comunidad para encontrarte con Dios, crecer y servir.
        </h2>
      </div>
    </section>

    <section class="as-section as-section--light">
      <div class="as-wrap as-split">
        <h2 class="as-h1" data-reveal="words">Adoración que se vuelve vida.</h2>
        <p class="as-lead" data-reveal>
          Creemos que la iglesia es una familia espiritual llamada a revelar a Cristo con palabras,
          obras y una vida rendida a Dios.
        </p>
      </div>

      <div class="as-wrap" style="margin-top:4rem">
        <div class="as-cols">
          {pilares.map((p, i) => (
            <div class="as-col" data-reveal data-reveal-delay={i * 110}>
              <span class="as-col__n">{p.n}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="as-section" id="historia">
      <div class="as-wrap as-split">
        <div>
          <p class="as-eyebrow" data-reveal>Nuestra historia</p>
          <h2 class="as-h1" data-reveal="words">Una obra nacida en oración, espera y obediencia.</h2>
        </div>
        <div>
          <p class="as-lead" data-reveal>
            Dios abrió camino para levantar una casa en Ramos Mejía. Desde el primer llamado hasta el
            terreno en una avenida visible, cada paso confirmó que Dios estaba preparando algo nuevo.
          </p>
          <p class="as-lead" style="margin-top:1.25rem" data-reveal data-reveal-delay="90">
            Hoy somos una iglesia que alcanza, forma y envía, con un equipo disponible para servir y
            soñar por más.
          </p>
        </div>
      </div>
    </section>

    <section class="as-section as-section--photos">
      <div class="as-wrap as-photos">
        {fotos.map((src, i) => (
          <div class="as-photo" data-reveal data-reveal-delay={i * 70}>
            <img src={src} alt="" loading="lazy" />
          </div>
        ))}
      </div>
    </section>

    <section class="as-section as-section--light" id="sedes">
      <div class="as-wrap">
        <div class="as-head">
          <div>
            <p class="as-eyebrow" data-reveal>Sedes</p>
            <h2 class="as-h1" data-reveal="words">Una iglesia en varias ciudades.</h2>
          </div>
        </div>
        <div class="as-sedes" data-reveal>
          {maquetaAnexos.map((a) => (
            <a class="as-sede" href={`/anexos/${a.slug}`}>
              <h4>{a.name}</h4>
              <p>{a.yearsValue} · {a.yearsLabel}</p>
              <span class="as-sede__arrow material-symbols-outlined">arrow_forward</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="as-section" id="ministerios">
      <div class="as-wrap">
        <div class="as-head">
          <div>
            <p class="as-eyebrow" data-reveal>Ministerios</p>
            <h2 class="as-h1" data-reveal="words">Dónde servimos y crecemos.</h2>
          </div>
          <a class="as-button as-button--small" href="/#ministerios">Ver todos</a>
        </div>
        <div class="as-sedes" data-reveal>
          {ministries.slice(0, 6).map((m) => (
            <a class="as-sede" href={`/ministerios/${m.slug}`}>
              <h4>{m.name}</h4>
              <p>{m.area}</p>
              <span class="as-sede__arrow material-symbols-outlined">arrow_forward</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="as-section as-section--dark as-cta">
      <div class="as-wrap">
        <h2 class="as-display" data-reveal="words">Te esperamos.</h2>
        <p data-reveal>Vení a conocernos este fin de semana en cualquiera de nuestras sedes.</p>
        <div class="as-button-group" data-reveal data-reveal-delay="120">
          <a class="as-button as-button--white" href="https://maps.app.goo.gl/mEVMgoTXbV3BULVq8" target="_blank" rel="noopener noreferrer">Tu primera vez</a>
          <a class="as-button as-button--ghost-white" href="/contact">Contactanos</a>
        </div>
      </div>
    </section>
  </div>
</MaquetaLayout>
