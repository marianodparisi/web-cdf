---
/**
 * Página de ministerio, en el lenguaje noche. El color propio de cada uno tiñe
 * el degradé y los acentos.
 *
 * Kids y Arde quedan afuera a propósito: tienen rutas propias (`kids.astro`,
 * `arde.astro`) con el diseño anterior hasta su tratamiento particular. No se
 * resuelven acá con un condicional porque importar ese componente sumaría los
 * estilos viejos (Tailwind, maqueta.css) a todas las páginas noche.
 *
 * SSR con el adaptador de node: el slug llega por la URL y no hace falta
 * `getStaticPaths`.
 */
import NocheLayout from '../../layouts/NocheLayout.astro';
import NocheHero from '../../components/noche/NocheHero.astro';
import NocheCta from '../../components/noche/NocheCta.astro';
import { getMinistries } from '../../lib/content/collections';
import { maquetaAnexos } from '../../data/maqueta-anexos';

const { slug } = Astro.params;
const ministries = await getMinistries();

const index = ministries.findIndex((m) => m.slug === slug);
const ministry = ministries[index];
if (!ministry) return Astro.redirect('/');

const next = ministries[(index + 1) % ministries.length];

/** Mismo mapa de color que el inicio y el listado. */
const ministryColors: Record<string, string> = {
  life: '#48c2c5',
  gold: '#c5a059',
  kids: '#e31b48',
  arde: '#e8642b',
  carcelario: '#487a7c',
  'firmes-y-adelante': '#c43b46',
};
const color = ministryColors[ministry.slug] ?? '#b07a40';
const esLogo = ['life', 'gold'].includes(ministry.slug);

/* Fotos propias, las que ya viven en `/public/ministries`. Sin material
   propio la grilla no se muestra: un hueco es más honesto que fotos ajenas. */
const fotosPorMinisterio: Record<string, string[]> = {
  life: ['/ministries/life/life1.jpg', '/ministries/life/life3.jpg', '/ministries/life/life4.jpeg'],
  gold: ['/ministries/gold/goldanuncio.jpg'],
};
const fotos = fotosPorMinisterio[ministry.slug] ?? [];

const columnas = [
  ministry.schedule && { n: '01', title: 'Cuándo nos reunimos', text: ministry.schedule },
  ministry.participation && { n: '02', title: 'Cómo participar', text: ministry.participation },
  ministry.place && { n: '03', title: 'Dónde', text: ministry.place },
].filter(Boolean) as { n: string; title: string; text: string }[];

const datos = [
  ministry.meetingDay && { label: 'Día', value: ministry.meetingDay },
  ministry.meetingHours && { label: 'Horario', value: ministry.meetingHours },
  ministry.place && { label: 'Lugar', value: ministry.place },
].filter(Boolean) as { label: string; value: string }[];

const whatsappHref = ministry.whatsapp
  ? `https://wa.me/${ministry.whatsapp.replace(/\D/g, '')}`
  : '/contact';
const mapsUrl = 'https://maps.app.goo.gl/mEVMgoTXbV3BULVq8';

const nameWords = ministry.name.toLowerCase().split(' ');
const lines = nameWords.length > 1 ? [nameWords.slice(0, -1).join(' '), nameWords[nameWords.length - 1]] : nameWords;
---

<NocheLayout title={`${ministry.name} · Iglesia Corazón de Fuego`}>
    <div class="lz-tint" style={`--m: ${color}`}>
      <NocheHero lines={lines} kicker={ministry.area} image={!esLogo ? ministry.photo || undefined : undefined}>
        <Fragment slot="quote">{ministry.excerpt}</Fragment>
        <a class="lz-btn" href="#participar">Quiero participar</a>
      </NocheHero>

      <section class="lz-plate lz-statement" id="sobre">
        <div class="lz-mesh" aria-hidden="true"></div>
        <div class="lz-wrap lz-statement__grid">
          <div>
            <span class="lz-spaced lz-kicker" data-r>{ministry.name} en Corazón de Fuego</span>
            <h2 class="lz-statement__text" data-r>¿Qué es {ministry.name}?</h2>
          </div>
          <div class="lz-statement__body" data-r>
            {esLogo && (
              <img src={ministry.image} alt={`Logo ${ministry.name}`} style="width: 160px; margin-bottom: 8px" />
            )}
            <p class="lz-body" style="color: var(--white)">{ministry.description}</p>
            {ministry.noticeTitle && (
              <div class="lz-notice">
                <p class="lz-notice__title">{ministry.noticeTitle}</p>
                {ministry.noticeText && <p>{ministry.noticeText}</p>}
              </div>
            )}
          </div>
        </div>
      </section>

      {columnas.length > 0 && (
        <section class="lz-section lz-dark" id="participar">
          <div class="lz-wrap">
            <div class="lz-head">
              <h2 class="lz-lockup lz-lockup--md" data-r>
                <span>cómo</span>
                <span class="lz-lockup__shift">sumarte</span>
              </h2>
              <div class="lz-actions" data-r>
                <a class="lz-btn" href={whatsappHref} target="_blank" rel="noopener noreferrer">Escribinos</a>
              </div>
            </div>
            <div class="lz-cols" style={`--n: ${columnas.length}`}>
              {columnas.map((c) => (
                <div class="lz-col" data-r>
                  <span class="lz-col__n">{c.n}</span>
                  <h3>{c.title}</h3>
                  <p>{c.text}</p>
                </div>
              ))}
            </div>

            {datos.length > 0 && (
              <div class="lz-times" style="margin-top: 48px" data-r>
                {datos.map((d) => (
                  <div class="lz-time">
                    <span class="lz-time__day">{d.label}</span>
                    <span class="lz-time__hour">{d.value}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )}

      {fotos.length > 0 && (
        <section class="lz-section lz-dark lz-dark--2">
          <div class="lz-wrap">
            <div class="lz-photos" data-r>
              {fotos.map((src) => <img src={src} alt={ministry.name} loading="lazy" />)}
            </div>
          </div>
        </section>
      )}

      <section class="lz-section lz-dark" id="sedes">
        <div class="lz-wrap">
          <div class="lz-head">
            <h2 class="lz-lockup lz-lockup--md" data-r>
              <span>dónde</span>
              <span class="lz-lockup__shift">encontrarnos</span>
            </h2>
            <div class="lz-actions" data-r>
              <a class="lz-btn lz-btn--ghost" href="/anexos">Ver todas</a>
            </div>
          </div>
          <div class="lz-tiles">
            {maquetaAnexos.map((a) => (
              <a class="lz-tile" href={`/anexos/${a.slug}`} data-r>
                <span class="lz-tile__name">{a.name}</span>
                <span class="lz-spaced">{a.addressLines[0] ?? a.yearsLabel}</span>
                <span class="lz-tile__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <NocheCta
        title="Te esperamos."
        text="Vení a conocernos o escribinos y te contamos cómo empezar."
        next={{ label: 'Siguiente ministerio', title: next.name, href: `/ministerios/${next.slug}` }}
      >
        <a class="lz-btn" href={whatsappHref} target="_blank" rel="noopener noreferrer">Escribinos</a>
        <a class="lz-btn lz-btn--ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">Visitanos</a>
        {ministry.instagram && (
          <a class="lz-btn lz-btn--ghost" href={ministry.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        )}
      </NocheCta>
    </div>
  </NocheLayout>
