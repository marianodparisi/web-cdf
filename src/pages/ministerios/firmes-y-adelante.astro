---
import Footer from '../../components/Footer.astro';
import MinistryTemplate from '../../components/MinistryTemplate.astro';
import Navbar from '../../components/Navbar.astro';
import { getMinistryBySlug } from '../../lib/content/collections';
import BaseLayout from '../../layouts/BaseLayout.astro';

const ministry = await getMinistryBySlug('firmes-y-adelante');
if (!ministry) throw new Error('Ministerio firmes-y-adelante no encontrado');
---

<BaseLayout title="Firmes y Adelante | Iglesia Corazon de Fuego">
  <Navbar sticky={false} />
  <MinistryTemplate
    ministry={ministry}
    title={ministry.name}
    tagline={ministry.excerpt}
    heroImage={ministry.image}
    badge={ministry.area}
    themeClass="bg-[#18202a]"
    intro={ministry.description}
    focusTitle="Enfoque"
    focusText={ministry.description}
    participationTitle="Cómo sumarte"
    participationText={ministry.participation}
    scheduleTitle="Encuentros"
    scheduleText={ministry.schedule}
  />
  <Footer />
</BaseLayout>
