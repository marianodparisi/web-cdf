---
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import { ministries } from '../../data/ministries';
import BaseLayout from '../../layouts/BaseLayout.astro';

const logoSlugs = new Set(['gold', 'kids', 'arde']);
---

<BaseLayout title="Ministerios | Iglesia Corazon de Fuego">
  <Navbar />

  <main data-cinematic-page="ministerios" class="bg-[#11110f]">
    <section data-animate="reveal" data-nav-surface-zone="dark" class="relative overflow-hidden bg-[#151514] py-20 text-white md:py-28">
      <div aria-hidden="true" class="cinematic-orb cinematic-orb--right"></div>
      <div class="relative mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
          <span class="h-px w-8 bg-primary/60"></span>
          Sección ministerios
        </p>
        <h1 data-cinematic-heading class="max-w-4xl font-display text-4xl font-semibold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Nuestro liderazgo y áreas de servicio.
        </h1>
        <p data-cinematic-copy class="mt-7 max-w-2xl text-base leading-relaxed text-white/70 sm:text-lg">
          Conocé cada área de servicio y encontrá el lugar donde podés crecer, servir y conectar con la familia de la fe.
        </p>
      </div>
    </section>

    <section data-animate="reveal" class="cinematic-light-section relative bg-[#e9e4da] py-20 md:py-28">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
          {
            ministries.map((ministry) => (
              <a
                data-animate="card"
                data-cinematic-card
                href={`/ministerios/${ministry.slug}`}
                class="group flex flex-col"
              >
                <div class={`relative aspect-[16/10] overflow-hidden rounded-soft ${logoSlugs.has(ministry.slug) ? 'bg-white p-8' : ''}`}>
                  <img
                    src={ministry.image}
                    alt={`Ministerio ${ministry.name}`}
                    class={
                      logoSlugs.has(ministry.slug)
                        ? 'h-full w-full object-contain'
                        : 'h-full w-full object-cover transition-[filter,transform] duration-700 ease-out [filter:saturate(0.7)_contrast(1.06)_brightness(0.94)] group-hover:scale-[1.03] group-hover:[filter:saturate(0.95)_contrast(1.02)_brightness(1)]'
                    }
                  />
                </div>
                <div class="flex flex-1 flex-col pt-6">
                  <p class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-primary">{ministry.area}</p>
                  <h2 class="mt-3 font-display text-2xl leading-tight text-charcoal transition-colors group-hover:text-primary">{ministry.name}</h2>
                  <p class="mt-3 text-sm leading-relaxed text-charcoal/65">{ministry.excerpt}</p>
                  <span class="editorial-link mt-6 text-charcoal">
                    Ver detalle
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
