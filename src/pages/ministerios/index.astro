---
/**
 * Listado de ministerios.
 *
 * El home los muestra en una fila que se desliza, porque ahí compiten con el
 * resto de la página. Acá es lo único que hay, así que van en grilla: se ven
 * todos de una y no hay que arrastrar para descubrir que existe el noveno.
 *
 * Reusa `.as-mcard`, la misma tarjeta del home, para que sea el mismo objeto
 * en los dos lugares y no dos cosas parecidas.
 */
import MaquetaLayout from '../../layouts/MaquetaLayout.astro';
import { getMinistries } from '../../lib/content/collections';

const ministries = await getMinistries();

/** Mismo mapa de color que el home y la página de cada ministerio. */
const ministryColors: Record<string, string> = {
  life: '#48c2c5',
  gold: '#c5a059',
  kids: '#e31b48',
  arde: '#e8642b',
  carcelario: '#487a7c',
  'firmes-y-adelante': '#c43b46',
};

// Los logos no toleran recorte: van contenidos sobre fondo propio.
const logoSlugs = new Set(['life', 'gold', 'kids', 'arde']);
---

<MaquetaLayout title="Ministerios · Iglesia Corazón de Fuego">
  <section class="as-section as-section--light">
    <div class="as-wrap">
      <div class="as-head">
        <div>
          <p class="as-eyebrow" data-reveal>Ministerios</p>
          <h1 class="as-h1" data-reveal="words">Encontrá tu lugar para servir y crecer.</h1>
        </div>
      </div>

      <div class="as-ministries as-ministries--grilla" data-reveal>
        {
          ministries.map((ministry) => (
            <a
              class="as-mcard"
              href={`/ministerios/${ministry.slug}`}
              style={`--m: ${ministryColors[ministry.slug] ?? '#282828'}`}
            >
              <div class={`as-mcard__media${logoSlugs.has(ministry.slug) ? ' is-logo' : ''}`}>
                <img src={ministry.image} alt={`Ministerio ${ministry.name}`} loading="lazy" />
              </div>
              <div class="as-mcard__body">
                <p class="as-mcard__area">{ministry.area}</p>
                <h3>{ministry.name}</h3>
                <span class="as-item__view">Conocer</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</MaquetaLayout>
