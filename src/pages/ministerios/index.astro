---
/**
 * Listado de ministerios, en el lenguaje noche. Las mismas piezas 4:5 del
 * inicio, en grilla: acá es lo único que hay, así que se ven todos de una.
 */
import NocheLayout from '../../layouts/NocheLayout.astro';
import NocheHero from '../../components/noche/NocheHero.astro';
import { getMinistries } from '../../lib/content/collections';

const ministries = await getMinistries();

/** Mismo mapa de color que el inicio y la página de cada ministerio. */
const ministryColors: Record<string, string> = {
  life: '#48c2c5',
  gold: '#c5a059',
  kids: '#e31b48',
  arde: '#e8642b',
  carcelario: '#487a7c',
  'firmes-y-adelante': '#c43b46',
};
const logoSlugs = new Set(['life', 'gold', 'kids', 'arde']);
---

<NocheLayout title="Ministerios · Iglesia Corazón de Fuego">
  <NocheHero lines={['encontrá', 'tu lugar']} kicker="Ministerios" short>
    <Fragment slot="quote">Encontrá tu lugar <strong>para servir y crecer.</strong></Fragment>
  </NocheHero>

  <section class="lz-section lz-dark">
    <div class="lz-wrap">
      <div class="lz-feed">
        {ministries.map((ministry) => (
          <a
            class={`lz-post lz-post--logo${logoSlugs.has(ministry.slug) ? '' : ' lz-post--solo'}`}
            href={`/ministerios/${ministry.slug}`}
            style={`--m: ${ministryColors[ministry.slug] ?? '#c5a059'}`}
            data-r
          >
            {logoSlugs.has(ministry.slug) && (
              <img class="lz-post__img" src={ministry.image} alt={`Ministerio ${ministry.name}`} loading="lazy" />
            )}
            <span class="lz-spaced lz-post__top">{ministry.area}</span>
            <span class="lz-post__title lz-post__title--big">{ministry.name}</span>
            <span class="lz-logo lz-logo--post" aria-hidden="true"><img src="/brand/logowhite.png" alt="" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</NocheLayout>
