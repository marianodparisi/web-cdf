---
import Footer from '../../components/Footer.astro';
import MinistryTemplate from '../../components/MinistryTemplate.astro';
import Navbar from '../../components/Navbar.astro';
import { getMinistryBySlug } from '../../lib/content/collections';
import BaseLayout from '../../layouts/BaseLayout.astro';

const ministry = await getMinistryBySlug('carcelario');
if (!ministry) throw new Error('Ministerio carcelario no encontrado');
---

<BaseLayout title="Ministerio Carcelario | Iglesia Corazón de Fuego">
  <Navbar />
  <MinistryTemplate
    title={ministry.name}
    tagline={ministry.excerpt}
    heroImage={ministry.image}
    badge={ministry.area}
    intro={ministry.description}
    focusTitle="Propósito"
    focusText={ministry.description}
    participationTitle="Cómo sumarte"
    participationText={ministry.participation}
    scheduleTitle="Ritmo de servicio"
    scheduleText={ministry.schedule}
  />
  <Footer />
</BaseLayout>
