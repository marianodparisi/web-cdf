---
/**
 * MAQUETA — listado de devocional, con la estructura de sus páginas de media:
 * pieza destacada arriba, pestañas por tipo y grilla de 3 columnas.
 */
import MaquetaLayout from '../../../layouts/MaquetaLayout.astro';
import { getDevotionals } from '../../../lib/content/collections';

const posts = await getDevotionals();
const [destacado, ...resto] = posts;

// El tipo ya viene en los datos ('Devocional' | 'Testimonio'): se arman las
// pestañas con lo que realmente hay cargado, no con una lista fija.
const tipos = [...new Set(posts.map((p) => p.type))];
const tabs = [
  { id: 'todos', label: 'Todos', items: resto },
  ...tipos.map((t) => ({ id: t.toLowerCase(), label: `${t}s`, items: resto.filter((p) => p.type === t) })),
];

const getYouTubeEmbedUrl = (videoUrl?: string) => {
  if (!videoUrl) return null;
  try {
    const url = new URL(videoUrl);
    const idFromPath = url.pathname.startsWith('/live/') ? url.pathname.split('/live/')[1] : null;
    const videoId = url.searchParams.get('v') || idFromPath;
    return videoId ? `https://www.youtube.com/embed/${videoId}` : videoUrl;
  } catch {
    return videoUrl;
  }
};
const embed = getYouTubeEmbedUrl(destacado?.videoUrl);
---

<MaquetaLayout title="Devocional · Maqueta · Corazón de Fuego">
  <div class="as-ministry" style="--m: #c5a059">
    <header class="as-mhero">
      <div class="as-mhero__copy">
        <p class="as-eyebrow" data-reveal>Contenido</p>
        <h1 class="as-display" data-reveal="words">Devocional</h1>
        <p class="as-mhero__lead" data-reveal>
          Una palabra para la semana. Textos y testimonios para sostener el caminar de todos los días.
        </p>
      </div>
      {destacado && (
        <div class="as-mhero__media" data-reveal>
          <img src={destacado.image} alt={destacado.title} />
        </div>
      )}
    </header>

    <!-- ══════════ DESTACADO ══════════ -->
    {destacado && (
      <section class="as-section as-section--light">
        <div class="as-wrap">
          <p class="as-eyebrow" data-reveal>Esta semana</p>
          <div class="as-split">
            <div>
              <h2 class="as-h1" data-reveal="words">{destacado.title}</h2>
              <p class="as-item__meta" style="margin-top:1rem">{destacado.type} · {destacado.weekLabel}</p>
              <p class="as-lead" style="margin-top:1.25rem" data-reveal>{destacado.excerpt}</p>
              <div class="as-button-group" data-reveal data-reveal-delay="120">
                <a class="as-button as-button--ministry" href={`/maqueta/devocional/${destacado.slug}`}>
                  Leer completo
                </a>
              </div>
            </div>
            <div data-reveal>
              {embed ? (
                <div class="as-embed">
                  <iframe
                    src={embed}
                    title={destacado.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
              ) : (
                <a class="as-image as-image--landscape" href={`/maqueta/devocional/${destacado.slug}`}>
                  <img src={destacado.image} alt={destacado.title} loading="lazy" />
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ══════════ LISTADO ══════════ -->
    <section class="as-section">
      <div class="as-wrap">
        <h2 class="as-h1" data-reveal="words">Anteriores</h2>
        <div class="as-tabs" data-tabs>
          <div class="as-tabs__menu">
            {tabs.map((t, i) => (
              <button class={`as-tabs__link${i === 0 ? ' is-active' : ''}`} type="button" data-tab={t.id}>
                {t.label}
              </button>
            ))}
          </div>
          {tabs.map((t, i) => (
            <div class={`as-tabs__panel${i === 0 ? ' is-active' : ''}`} data-panel={t.id}>
              {t.items.length === 0 ? (
                <p class="as-lead">Todavía no hay contenido en esta categoría.</p>
              ) : (
                <div class="as-collection">
                  {t.items.map((p) => (
                    <a class="as-item" href={`/maqueta/devocional/${p.slug}`}>
                      <div class="as-image as-image--square">
                        <img src={p.image} alt={p.title} loading="lazy" />
                      </div>
                      <p class="as-item__meta">{p.type} · {p.weekLabel}</p>
                      <h3 class="as-item__title">{p.title}</h3>
                      <span class="as-item__view">Leer</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="as-section as-section--dark as-cta">
      <div class="as-wrap">
        <h2 class="as-display" data-reveal="words">Nos vemos el fin de semana.</h2>
        <p data-reveal>Viernes y sábados 20 hs · Domingos 9:30 y 11:00 hs.</p>
        <div class="as-button-group" data-reveal data-reveal-delay="120">
          <a class="as-button as-button--white" href="/maqueta#primera-vez">Tu primera vez</a>
          <a class="as-button as-button--ghost-white" href="/maqueta/contacto">Escribinos</a>
        </div>
      </div>
    </section>
  </div>
</MaquetaLayout>
