---
import Field from '../../../components/admin/Field.astro';
import ImageField from '../../../components/admin/ImageField.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getMinistryBySlug } from '../../../lib/content/collections';
import { canEdit, denyRedirect, getSession } from '../../../lib/admin-guard';
import { ministrySectionKey } from '../../../lib/content/sections';

const session = getSession(Astro.locals);
const { slug } = Astro.params;
const ministry = await getMinistryBySlug(slug);

if (!ministry) {
  return denyRedirect('Ese ministerio no existe.');
}

if (!canEdit(session, ministrySectionKey(ministry.slug))) {
  return denyRedirect(`No tenés acceso a ${ministry.name}.`);
}

// El nombre, el logo y el resumen se ven en el navbar, en el inicio y en el
// listado de ministerios: no son de este ministerio solo, así que los cambia un
// administrador. Quien lidera edita lo que pasa dentro de su propia página.
const isAdmin = session.role === 'admin';
---

<AdminLayout title={ministry.name} backHref="/admin" backLabel="Volver al panel" session={session}>
  <a
    href={`/ministerios/${ministry.slug}`}
    target="_blank"
    rel="noopener noreferrer"
    class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-charcoal/70 transition-colors hover:text-primary"
  >
    <span class="material-symbols-outlined text-lg">open_in_new</span>
    Ver cómo se ve en el sitio
  </a>

  <form
    method="POST"
    action="/api/admin/ministerios"
    enctype="multipart/form-data"
    data-warn-unsaved
    class="rounded-2xl border border-black/10 bg-white p-6 sm:p-8"
  >
    <input type="hidden" name="slug" value={ministry.slug} />

    {
      isAdmin ? (
        <fieldset class="mb-10">
          <legend class="mb-1 font-display text-lg font-semibold">La ficha del ministerio</legend>
          <p class="mb-6 text-sm text-charcoal/60">
            Esto se ve en el menú de arriba, en el inicio y en la lista de ministerios. Sólo lo cambia un
            administrador.
          </p>

          <Field name="name" label="Nombre" value={ministry.name} required />
          <Field
            name="area"
            label="A quién está dirigido"
            value={ministry.area}
            hint="Por ejemplo: Jóvenes, Mujeres, Niños."
            required
          />
          <Field
            name="excerpt"
            label="Resumen corto"
            value={ministry.excerpt}
            rows={2}
            hint="Una línea. Es lo que se lee en la lista de ministerios y en el inicio."
            required
          />
          <ImageField name="image" label="Foto o logo" currentImage={ministry.image} />
        </fieldset>
      ) : (
        <div class="mb-10 rounded-2xl border border-black/10 bg-[#f5f1e8] p-5">
          <p class="font-display text-lg font-semibold">{ministry.name}</p>
          <p class="mt-1 text-sm text-charcoal/70">{ministry.excerpt}</p>
          <p class="mt-3 text-sm text-charcoal/55">
            El nombre y el logo los cambia un administrador. Vos editás lo de acá abajo, que es lo que se ve
            dentro de la página de {ministry.name}.
          </p>
        </div>
      )
    }

    <fieldset class="mb-10">
      <legend class="mb-1 font-display text-lg font-semibold">Los datos que más cambian</legend>
      <p class="mb-6 text-sm text-charcoal/60">
        Lo que dejes vacío no se muestra en la página. No queda ningún hueco.
      </p>

      <div class="grid gap-x-6 sm:grid-cols-2">
        <Field
          name="meetingDay"
          label="Qué día se reúnen"
          value={ministry.meetingDay}
          placeholder="Sábados"
        />
        <Field
          name="meetingHours"
          label="A qué hora"
          value={ministry.meetingHours}
          placeholder="18:00 a 20:00 hs"
        />
      </div>

      <Field
        name="place"
        label="Dónde"
        value={ministry.place}
        rows={2}
        hint="La dirección, como quieras que se lea. Podés usar dos renglones."
      />
      <Field
        name="mapUrl"
        label="Link para ver el mapa"
        value={ministry.mapUrl}
        hint="Buscá el lugar en Google Maps y pegá acá el link. Si lo dejás vacío no aparece el botón."
        placeholder="https://maps.app.goo.gl/..."
      />

      <div class="grid gap-x-6 sm:grid-cols-2">
        <Field
          name="whatsapp"
          label="WhatsApp"
          value={ministry.whatsapp}
          hint="El número, con característica y sin el 0 ni el 15."
          placeholder="11 5555 5555"
        />
        <Field
          name="instagram"
          label="Instagram"
          value={ministry.instagram}
          hint="El usuario o el link."
          placeholder="@corazondefuegoiglesia"
        />
      </div>
    </fieldset>

    <fieldset class="mb-10">
      <legend class="mb-1 font-display text-lg font-semibold">Un aviso arriba de todo</legend>
      <p class="mb-6 text-sm text-charcoal/60">
        Para la próxima actividad o algo puntual. Si borrás el título, el aviso desaparece de la página.
      </p>

      <Field
        name="noticeTitle"
        label="Título del aviso"
        value={ministry.noticeTitle}
        placeholder="Se viene el campamento"
      />
      <Field name="noticeText" label="Texto del aviso" value={ministry.noticeText} rows={3} />
      <ImageField name="photo" label="Foto de la última actividad" currentImage={ministry.photo} />
    </fieldset>

    <fieldset class="mb-2">
      <legend class="mb-6 font-display text-lg font-semibold">Los textos de la página</legend>

    <Field
      name="description"
      label="Descripción"
      value={ministry.description}
      rows={5}
      hint="Qué es el ministerio y qué hace."
      required
    />
    <Field
      name="participation"
      label="Cómo sumarse"
      value={ministry.participation}
      rows={5}
      hint="Quién puede participar y cómo dar el primer paso."
      required
    />
    <Field
      name="schedule"
      label="Cómo es el ritmo del ministerio"
      value={ministry.schedule}
      rows={2}
      hint="En una frase. El día y la hora exactos van más arriba."
      required
    />
    </fieldset>

    <div class="mt-8 flex flex-col gap-3 border-t border-black/10 pt-6 sm:flex-row sm:items-center">
      <button
        type="submit"
        class="rounded-full bg-primary px-8 py-4 text-base font-bold text-charcoal transition-colors hover:bg-primary-dark hover:text-white disabled:opacity-60"
      >
        Guardar
      </button>
      <a
        href="/admin"
        class="rounded-full px-6 py-4 text-center font-semibold text-charcoal/70 transition-colors hover:text-charcoal"
      >
        Cancelar
      </a>
    </div>
  </form>
</AdminLayout>
