---
/**
 * Un ministerio en el panel: sus novedades (varias, cada una en su modal) y
 * la foto de la página. Es todo lo que se edita desde acá, para todos los
 * roles; nombre, logo, textos, horarios y contactos se cambian por código.
 */
import ImageField from '../../../components/admin/ImageField.astro';
import NoticeModal from '../../../components/admin/NoticeModal.astro';
import NoticeRows from '../../../components/admin/NoticeRows.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getMinistryBySlug } from '../../../lib/content/collections';
import { isNoticeLive, noticesOf } from '../../../lib/content/notices';
import { canEdit, denyRedirect, getSession } from '../../../lib/admin-guard';
import { ministrySectionKey } from '../../../lib/content/sections';

const session = getSession(Astro.locals);
const { slug } = Astro.params;
const ministry = await getMinistryBySlug(slug);

if (!ministry) {
  return denyRedirect('Ese ministerio no existe.');
}

if (!canEdit(session, ministrySectionKey(ministry.slug))) {
  return denyRedirect(`No tenés acceso a ${ministry.name}.`);
}

const notices = noticesOf(ministry);
const live = notices.filter(isNoticeLive).length;
const volver = `/admin/ministerios/${ministry.slug}#novedad`;
const info = { slug: ministry.slug, name: ministry.name, image: ministry.image };
---

<AdminLayout title={ministry.name} backHref="/admin" backLabel="Volver al panel" session={session}>
  <!-- Resumen: qué ministerio es y cuántas novedades se ven ahora. -->
  <div class="adm-card adm-entity">
    <img class="adm-entity__logo" src={ministry.image} alt="" />
    <div class="adm-entity__text">
      <p class="adm-entity__area">{ministry.area}</p>
      <p class="adm-entity__status">
        {live > 0 ? (
          <span class="adm-badge adm-badge--ok"><span class="material-symbols-outlined">campaign</span>{live} {live === 1 ? 'novedad publicada' : 'novedades publicadas'}</span>
        ) : (
          <span class="adm-badge adm-badge--editor">Sin novedades publicadas</span>
        )}
      </p>
    </div>
    <a class="adm-btn adm-btn--ghost adm-btn--sm" href={`/ministerios/${ministry.slug}`} target="_blank" rel="noopener noreferrer">
      <span class="material-symbols-outlined">open_in_new</span><span class="adm-hide-sm">Ver en el sitio</span>
    </a>
  </div>

  <div class="adm-card adm-tabs" data-admin-tabs>
    <nav class="adm-tabs__nav" role="tablist" aria-label="Partes de la página">
      <button type="button" role="tab" data-tab-btn="novedad"><span class="material-symbols-outlined">campaign</span>Novedades</button>
      <button type="button" role="tab" data-tab-btn="imagenes"><span class="material-symbols-outlined">image</span>Imágenes</button>
    </nav>

    <section class="adm-tabs__panel" data-tab-panel="novedad">
      <div class="adm-tabs__body">
        <div class="adm-toolbar">
          <p class="adm-help" style="margin: 0; flex: 1">
            Para actividades o cosas puntuales. Cada una elige si se ve en el inicio, en la página del ministerio o en los dos.
          </p>
          <button type="button" class="adm-btn adm-btn--gold" data-modal-open="nueva-novedad">
            <span class="material-symbols-outlined">add</span> Agregar novedad
          </button>
        </div>
        {notices.length > 0 ? (
          <NoticeRows rows={notices.map((notice, index) => ({ notice, ministry: info, index }))} volver={volver} />
        ) : (
          <div class="adm-empty">
            <span class="material-symbols-outlined">campaign</span>
            <p>Todavía no hay novedades. Cuando cargues una, aparece acá.</p>
          </div>
        )}
      </div>
    </section>

    <form
      method="POST"
      action="/api/admin/ministerios"
      enctype="multipart/form-data"
      data-warn-unsaved
      class="adm-tabs__panel"
      data-tab-panel="imagenes"
    >
      <input type="hidden" name="slug" value={ministry.slug} />
      <div class="adm-tabs__body">
        <p class="adm-help" style="margin-bottom: 20px">La foto que se muestra dentro de la página del ministerio.</p>
        <ImageField name="photo" label="Foto de la última actividad" currentImage={ministry.photo} />
      </div>
      <div class="adm-savebar adm-tabs__foot">
        <button type="submit" class="adm-btn adm-btn--gold">
          <span class="material-symbols-outlined">check</span> Guardar la foto
        </button>
      </div>
    </form>
  </div>

  <NoticeModal id="nueva-novedad" volver={volver} ministry={info} />
  {notices.map((notice) => (
    <NoticeModal id={`novedad-${ministry.slug}-${notice.id}`} volver={volver} ministry={info} notice={notice} />
  ))}
</AdminLayout>
