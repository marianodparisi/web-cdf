---
import Field from '../../../components/admin/Field.astro';
import ImageField from '../../../components/admin/ImageField.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getMinistryBySlug } from '../../../lib/content/collections';
import { canEdit, denyRedirect, getSession } from '../../../lib/admin-guard';
import { ministrySectionKey } from '../../../lib/content/sections';

const session = getSession(Astro.locals);
const { slug } = Astro.params;
const ministry = await getMinistryBySlug(slug);

if (!ministry) {
  return denyRedirect('Ese ministerio no existe.');
}

if (!canEdit(session, ministrySectionKey(ministry.slug))) {
  return denyRedirect(`No tenés acceso a ${ministry.name}.`);
}

// El nombre, el logo y el resumen se ven en el navbar, en el inicio y en el
// listado de ministerios: no son de este ministerio solo, así que los cambia un
// administrador. Quien lidera edita sólo la novedad y las imágenes.
const isAdmin = session.role === 'admin';
---

<AdminLayout title={ministry.name} backHref="/admin" backLabel="Volver al panel" session={session}>
  <!-- Resumen: qué ministerio es y si tiene un aviso publicado ahora. -->
  <div class="adm-card adm-entity">
    <img class="adm-entity__logo" src={ministry.image} alt="" />
    <div class="adm-entity__text">
      <p class="adm-entity__area">{ministry.area}</p>
      <p class="adm-entity__status">
        {ministry.noticeTitle ? (
          <span class="adm-badge adm-badge--ok"><span class="material-symbols-outlined">campaign</span>Aviso publicado: {ministry.noticeTitle}</span>
        ) : (
          <span class="adm-badge adm-badge--editor">Sin aviso publicado</span>
        )}
      </p>
      {!isAdmin && (
        <p class="adm-help" style="margin: 6px 0 0">
          Desde acá cargás la novedad y las imágenes. Textos, horarios y contactos los cambia un administrador.
        </p>
      )}
    </div>
    <a class="adm-btn adm-btn--ghost adm-btn--sm" href={`/ministerios/${ministry.slug}`} target="_blank" rel="noopener noreferrer">
      <span class="material-symbols-outlined">open_in_new</span><span class="adm-hide-sm">Ver en el sitio</span>
    </a>
  </div>

  <form
    method="POST"
    action="/api/admin/ministerios"
    enctype="multipart/form-data"
    data-warn-unsaved
    class="adm-card adm-tabs"
    data-admin-tabs
  >
    <input type="hidden" name="slug" value={ministry.slug} />

    {/* Las pestañas sólo muestran u ocultan partes del mismo formulario:
        "Guardar" manda todo junto, como antes. */}
    <nav class="adm-tabs__nav" role="tablist" aria-label="Partes de la página">
      <button type="button" role="tab" data-tab-btn="novedad"><span class="material-symbols-outlined">campaign</span>Novedad</button>
      <button type="button" role="tab" data-tab-btn="imagenes"><span class="material-symbols-outlined">image</span>Imágenes</button>
      {isAdmin && <button type="button" role="tab" data-tab-btn="ficha"><span class="material-symbols-outlined">badge</span>Ficha</button>}
      {isAdmin && <button type="button" role="tab" data-tab-btn="datos"><span class="material-symbols-outlined">event</span>Datos</button>}
      {isAdmin && <button type="button" role="tab" data-tab-btn="textos"><span class="material-symbols-outlined">notes</span>Textos</button>}
    </nav>
    <div class="adm-tabs__body">

    {
      isAdmin ? (
        <fieldset class="adm-tabs__panel" data-tab-panel="ficha">
          <legend class="mb-1 font-display text-lg font-semibold">La ficha del ministerio</legend>
          <p class="mb-6 text-sm text-charcoal/60">
            Esto se ve en el menú de arriba, en el inicio y en la lista de ministerios. Sólo lo cambia un
            administrador.
          </p>

          <Field name="name" label="Nombre" value={ministry.name} required />
          <Field
            name="area"
            label="A quién está dirigido"
            value={ministry.area}
            hint="Por ejemplo: Jóvenes, Mujeres, Niños."
            required
          />
          <Field
            name="excerpt"
            label="Resumen corto"
            value={ministry.excerpt}
            rows={2}
            hint="Una línea. Es lo que se lee en la lista de ministerios y en el inicio."
            required
          />
          <ImageField name="image" label="Foto o logo" currentImage={ministry.image} />
        </fieldset>
      ) : null
    }

    <fieldset class="adm-tabs__panel" data-tab-panel="novedad">
      <legend class="mb-1 font-display text-lg font-semibold">La novedad</legend>
      <p class="mb-6 text-sm text-charcoal/60">
        Para la próxima actividad o algo puntual. Aparece en la página del ministerio y en el inicio, en "Qué está pasando". Si borrás el título, desaparece de los dos lados junto con su imagen.
      </p>

      <Field
        name="noticeTitle"
        label="Título del aviso"
        value={ministry.noticeTitle}
        placeholder="Se viene el campamento"
      />
      <Field name="noticeText" label="Texto del aviso" value={ministry.noticeText} rows={3} />
      <ImageField name="noticeImage" label="Imagen del aviso (el flyer)" currentImage={ministry.noticeImage} />
    </fieldset>

    <fieldset class="adm-tabs__panel" data-tab-panel="imagenes">
      <legend class="mb-1 font-display text-lg font-semibold">Imágenes de la página</legend>
      <p class="mb-6 text-sm text-charcoal/60">La foto que se muestra dentro de la página del ministerio.</p>
      <ImageField name="photo" label="Foto de la última actividad" currentImage={ministry.photo} />
    </fieldset>


    {/* Textos, horarios, lugar y contactos: sólo un administrador. Quien
        lidera el ministerio maneja la novedad y las imágenes, nada más. */}
    {isAdmin && (
      <>
      <fieldset class="adm-tabs__panel" data-tab-panel="datos">
        <legend class="mb-1 font-display text-lg font-semibold">Los datos que más cambian</legend>
        <p class="mb-6 text-sm text-charcoal/60">
          Lo que dejes vacío no se muestra en la página. No queda ningún hueco.
        </p>

        <div class="grid gap-x-6 sm:grid-cols-2">
          <Field
            name="meetingDay"
            label="Qué día se reúnen"
            value={ministry.meetingDay}
            placeholder="Sábados"
          />
          <Field
            name="meetingHours"
            label="A qué hora"
            value={ministry.meetingHours}
            placeholder="18:00 a 20:00 hs"
          />
        </div>

        <Field
          name="place"
          label="Dónde"
          value={ministry.place}
          rows={2}
          hint="La dirección, como quieras que se lea. Podés usar dos renglones."
        />
        <Field
          name="mapUrl"
          label="Link para ver el mapa"
          value={ministry.mapUrl}
          hint="Buscá el lugar en Google Maps y pegá acá el link. Si lo dejás vacío no aparece el botón."
          placeholder="https://maps.app.goo.gl/..."
        />

        <div class="grid gap-x-6 sm:grid-cols-2">
          <Field
            name="whatsapp"
            label="WhatsApp"
            value={ministry.whatsapp}
            hint="El número, con característica y sin el 0 ni el 15."
            placeholder="11 5555 5555"
          />
          <Field
            name="instagram"
            label="Instagram"
            value={ministry.instagram}
            hint="El usuario o el link."
            placeholder="@corazondefuegoiglesia"
          />
        </div>
      </fieldset>

      <fieldset class="adm-tabs__panel" data-tab-panel="textos">
        <legend class="mb-6 font-display text-lg font-semibold">Los textos de la página</legend>

      <Field
        name="description"
        label="Descripción"
        value={ministry.description}
        rows={5}
        hint="Qué es el ministerio y qué hace."
        required
      />
      <Field
        name="participation"
        label="Cómo sumarse"
        value={ministry.participation}
        rows={5}
        hint="Quién puede participar y cómo dar el primer paso."
        required
      />
      <Field
        name="schedule"
        label="Cómo es el ritmo del ministerio"
        value={ministry.schedule}
        rows={2}
        hint="En una frase. El día y la hora exactos van más arriba."
        required
      />
      </fieldset>

      </>
    )}

    </div>

    <div class="adm-savebar adm-tabs__foot">
      <a href="/admin" class="adm-btn adm-btn--ghost">Cancelar</a>
      <button type="submit" class="adm-btn adm-btn--gold">
        <span class="material-symbols-outlined">check</span> Guardar
      </button>
    </div>
  </form>
</AdminLayout>
