---
/**
 * Mi cuenta: a la izquierda quién sos y qué podés editar; a la derecha el
 * cambio de contraseña. Pide la actual además de la sesión (ver
 * PROJECT_MEMORY): una sesión olvidada en un teléfono ajeno no tiene que
 * poder quedarse con la cuenta.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../lib/admin-guard';
import { getSectionCatalog } from '../../lib/content/sections';

const session = getSession(Astro.locals);
const catalog = await getSectionCatalog();

// Un admin llega a todo, así que no tiene sentido listarle secciones una por una.
const mySections =
  session.role === 'admin' ? [] : catalog.filter((section) => session.sections.includes(section.key));

const hue = [...session.username].reduce((sum, c) => sum + c.charCodeAt(0), 0) % 360;
---

<AdminLayout title="Mi cuenta" backHref="/admin" backLabel="Volver al panel" session={session}>
  <div class="adm-account">
    <section class="adm-card adm-account__profile">
      <span class="adm-avatar adm-avatar--xl" style={`--h: ${hue}`}>{session.username.slice(0, 2).toUpperCase()}</span>
      <h2 class="adm-account__name">{session.username}</h2>
      {session.role === 'admin' ? (
        <span class="adm-badge adm-badge--admin"><span class="material-symbols-outlined">shield_person</span>Administrador</span>
      ) : (
        <span class="adm-badge adm-badge--editor">Editor</span>
      )}

      <div class="adm-account__perms">
        <p class="adm-eyebrow">Qué podés editar</p>
        {session.role === 'admin' ? (
          <p class="adm-help">Todas las secciones, y dar o sacar accesos.</p>
        ) : mySections.length > 0 ? (
          <ul class="adm-account__list">
            {mySections.map((section) => (
              <li>
                {section.image ? (
                  <img src={section.image} alt="" />
                ) : (
                  <span class="material-symbols-outlined">{section.icon ?? 'edit_note'}</span>
                )}
                {section.label}
              </li>
            ))}
          </ul>
        ) : (
          <p class="adm-help">
            Todavía no tenés ninguna sección asignada. Pedile a la persona que administra el panel que te dé
            acceso.
          </p>
        )}
      </div>
    </section>

    <section class="adm-card adm-account__pass">
      <h2 class="adm-h2">Cambiar mi contraseña</h2>
      <p class="adm-help" style="margin-bottom: 20px">
        Si te la dio otra persona, conviene poner una tuya que nadie más sepa.
      </p>

      <form method="POST" action="/api/admin/mi-cuenta" data-warn-unsaved>
        <div class="adm-field">
          <label class="adm-label" for="actual">La contraseña que usás ahora</label>
          <input id="actual" name="actual" type="password" required class="adm-input" autocomplete="current-password" data-secret />
        </div>
        <div class="adm-grid2">
          <div class="adm-field">
            <label class="adm-label" for="nueva">La nueva <small>(mínimo 8)</small></label>
            <input id="nueva" name="nueva" type="password" minlength="8" required class="adm-input" autocomplete="new-password" data-secret />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="repetir">La nueva otra vez</label>
            <input id="repetir" name="repetir" type="password" minlength="8" required class="adm-input" autocomplete="new-password" data-secret />
          </div>
        </div>
        <label class="adm-check-line" style="margin-top: 0">
          <input type="checkbox" id="mostrar-claves" />
          <span><strong>Mostrar lo que escribo</strong>Útil en el celular, para no equivocarte de tecla.</span>
        </label>
        <div class="adm-actions">
          <button type="submit" class="adm-btn adm-btn--gold">
            <span class="material-symbols-outlined">key</span> Guardar la contraseña nueva
          </button>
        </div>
      </form>
    </section>
  </div>
</AdminLayout>

<script>
  // Escribir a ciegas en un teléfono es la causa número uno de "no me anda la
  // contraseña". Que la puedan ver mientras la escriben evita el ida y vuelta.
  const toggle = document.getElementById('mostrar-claves') as HTMLInputElement | null;
  const fields = document.querySelectorAll<HTMLInputElement>('input[data-secret]');

  toggle?.addEventListener('change', () => {
    fields.forEach((field) => {
      field.type = toggle.checked ? 'text' : 'password';
    });
  });
</script>
