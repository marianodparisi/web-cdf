---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../lib/admin-guard';
import { getSectionCatalog } from '../../lib/content/sections';

const session = getSession(Astro.locals);
const catalog = await getSectionCatalog();

// Un admin llega a todo, así que no tiene sentido listarle secciones una por una.
const mySections =
  session.role === 'admin'
    ? []
    : catalog.filter((section) => session.sections.includes(section.key));

const inputClass =
  'w-full rounded-2xl border border-black/15 bg-white px-4 py-3 text-base outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/25';
---

<AdminLayout title="Mi cuenta" backHref="/admin" backLabel="Volver al panel" session={session}>
  <section class="mb-8 rounded-2xl border border-black/10 bg-white p-6 sm:p-8">
    <p class="text-lg">
      Entrás como <span class="font-bold">{session.username}</span>.
    </p>

    {
      session.role === 'admin' ? (
        <p class="mt-3 text-charcoal/70">
          Sos administrador: podés editar todas las secciones y dar o sacar accesos.
        </p>
      ) : mySections.length > 0 ? (
        <div class="mt-4">
          <p class="mb-3 text-charcoal/70">Podés editar:</p>
          <ul class="flex flex-wrap gap-2">
            {mySections.map((section) => (
              <li class="rounded-full border border-black/10 bg-[#f5f1e8] px-4 py-2 text-sm">
                {section.label}
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <p class="mt-3 text-charcoal/70">
          Todavía no tenés ninguna sección asignada. Pedile a la persona que administra el panel que te dé
          acceso.
        </p>
      )
    }
  </section>

  <section class="rounded-2xl border border-black/10 bg-white p-6 sm:p-8">
    <h2 class="mb-2 font-display text-xl font-semibold">Cambiar mi contraseña</h2>
    <p class="mb-6 text-charcoal/65">
      Si te la dio otra persona, conviene poner una tuya que nadie más sepa.
    </p>

    <form method="POST" action="/api/admin/mi-cuenta" data-warn-unsaved>
      <div class="mb-6">
        <label class="mb-2 block text-sm font-bold" for="actual">La contraseña que usás ahora</label>
        <input
          id="actual"
          name="actual"
          type="password"
          required
          class={inputClass}
          autocomplete="current-password"
          data-secret
        />
      </div>

      <div class="mb-6">
        <label class="mb-2 block text-sm font-bold" for="nueva">La nueva</label>
        <p class="mb-2 text-sm text-charcoal/60">Mínimo 8 caracteres.</p>
        <input
          id="nueva"
          name="nueva"
          type="password"
          minlength="8"
          required
          class={inputClass}
          autocomplete="new-password"
          data-secret
        />
      </div>

      <div class="mb-4">
        <label class="mb-2 block text-sm font-bold" for="repetir">La nueva otra vez</label>
        <p class="mb-2 text-sm text-charcoal/60">Para asegurarnos de que no haya un error de tipeo.</p>
        <input
          id="repetir"
          name="repetir"
          type="password"
          minlength="8"
          required
          class={inputClass}
          autocomplete="new-password"
          data-secret
        />
      </div>

      <label class="mb-8 flex items-center gap-3">
        <input type="checkbox" id="mostrar-claves" class="h-5 w-5 rounded border-black/25" />
        <span class="text-sm">Mostrar lo que escribo</span>
      </label>

      <button
        type="submit"
        class="rounded-full bg-primary px-8 py-4 font-bold text-charcoal transition-colors hover:bg-primary-dark hover:text-white disabled:opacity-60"
      >
        Guardar la contraseña nueva
      </button>
    </form>
  </section>
</AdminLayout>

<script>
  // Escribir a ciegas en un teléfono es la causa número uno de "no me anda la
  // contraseña". Que la puedan ver mientras la escriben evita el ida y vuelta.
  const toggle = document.getElementById('mostrar-claves') as HTMLInputElement | null;
  const fields = document.querySelectorAll<HTMLInputElement>('input[data-secret]');

  toggle?.addEventListener('change', () => {
    fields.forEach((field) => {
      field.type = toggle.checked ? 'text' : 'password';
    });
  });
</script>
