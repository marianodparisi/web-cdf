---
/**
 * Series de predicación. La actual va destacada; las anteriores en una lista
 * compacta que se despliega sólo al editar, con las primeras a la vista y el
 * resto detrás de "Ver todas". Los formularios mandan los mismos campos de
 * siempre a `/api/admin/series` (accion, indice, title, subtitle, …).
 */
import Field from '../../components/admin/Field.astro';
import ImageField from '../../components/admin/ImageField.astro';
import Modal from '../../components/admin/Modal.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSeries } from '../../lib/content/collections';
import { canEdit, denyRedirect, getSession } from '../../lib/admin-guard';

const session = getSession(Astro.locals);
if (!canEdit(session, 'series')) {
  return denyRedirect('No tenés acceso a las series.');
}

const series = await getSeries();
const [actual, ...anteriores] = series;
const VISIBLES = 5;

/** Sin portada o sin link: se marca "Incompleta" y nunca queda escondida en "Ver todas". */
const incompleta = (item: (typeof series)[number]) => !item.image || !item.href;
---

<AdminLayout title="Series de predicación" backHref="/admin" backLabel="Volver al panel" session={session}>
  <div class="adm-toolbar adm-toolbar--lead">
    <p class="adm-lead" style="margin: 0">
      La serie actual se muestra grande en el inicio. Las anteriores aparecen debajo, como archivo.
    </p>
    <button type="button" class="adm-btn adm-btn--gold" data-modal-open="nueva-serie">
      <span class="material-symbols-outlined">add</span> Agregar una serie
    </button>
  </div>

  <!-- ══════════ NUEVA SERIE ══════════ Modal: se crea completa, en su lugar. -->
  <Modal id="nueva-serie" title="Agregar una serie" subtitle="Se crea completa. Si la marcás como actual, pasa a ser la del inicio.">
    <form method="POST" action="/api/admin/series" enctype="multipart/form-data" class="adm-modal__form">
      <input type="hidden" name="accion" value="crear" />
      <div class="adm-modal__body">
        <div class="adm-grid2">
          <Field id="ns-title" name="title" label="Nombre de la serie" required placeholder="Restaurados" />
          <Field id="ns-subtitle" name="subtitle" label="Bajada" required placeholder="Serie octubre 2026" />
        </div>
        <Field id="ns-description" name="description" label="Descripción" rows={3} required />
        <Field id="ns-href" name="href" label="Link a la playlist de YouTube" type="url" required placeholder="https://www.youtube.com/playlist?list=..." />
        <ImageField id="ns-image" name="image" label="Portada" />
        <label class="adm-check-line">
          <input type="checkbox" name="actual" value="si" checked />
          <span>
            <strong>Hacerla la serie actual</strong>
            Se muestra grande en el inicio y la de ahora pasa a las anteriores.
          </span>
        </label>
      </div>
      <footer class="adm-modal__foot">
        <button type="button" class="adm-btn adm-btn--ghost" data-modal-close>Cancelar</button>
        <button type="submit" class="adm-btn adm-btn--gold">
          <span class="material-symbols-outlined">check</span> Crear la serie
        </button>
      </footer>
    </form>
  </Modal>

  {series.length === 0 && (
    <div class="adm-card adm-empty">
      <span class="material-symbols-outlined">video_library</span>
      <p>Todavía no hay series cargadas.</p>
    </div>
  )}

  <!-- ══════════ SERIE ACTUAL ══════════ -->
  {actual && (
    <form method="POST" action="/api/admin/series" enctype="multipart/form-data" class="adm-card adm-feature">
      <input type="hidden" name="indice" value="0" />
      <div class="adm-feature__top">
        <div class="adm-feature__cover">
          {actual.image ? <img src={actual.image} alt="" /> : <span class="material-symbols-outlined">image</span>}
        </div>
        <div class="adm-feature__info">
          <span class="adm-badge adm-badge--admin"><span class="material-symbols-outlined">star</span>Serie actual</span>
          <h2 class="adm-feature__title">{actual.title}</h2>
          <p class="adm-feature__sub">{actual.subtitle}</p>
          <div class="adm-feature__links">
            {actual.href && (
              <a class="adm-btn adm-btn--ghost adm-btn--sm" href={actual.href} target="_blank" rel="noopener noreferrer">
                <span class="material-symbols-outlined">play_circle</span> Ver la playlist
              </a>
            )}
            <a class="adm-btn adm-btn--ghost adm-btn--sm" href="/#series" target="_blank" rel="noopener">
              <span class="material-symbols-outlined">open_in_new</span> Ver en el inicio
            </a>
          </div>
        </div>
      </div>

      <details class="adm-fold adm-feature__edit">
        <summary class="adm-btn adm-btn--ghost">
          <span class="material-symbols-outlined">edit</span> Editar la serie actual
        </summary>
        <div class="adm-feature__form">
          <div class="adm-grid2">
            <Field id={`s0-title`} name="title" label="Nombre de la serie" value={actual.title} required />
            <Field id={`s0-subtitle`} name="subtitle" label="Bajada" value={actual.subtitle} required />
          </div>
          <Field id={`s0-description`} name="description" label="Descripción" value={actual.description} rows={3} required />
          <Field id={`s0-href`} name="href" label="Link a la playlist de YouTube" value={actual.href} type="url" required />
          <div class="adm-grid2">
            <ImageField id={`s0-image`} name="image" label="Portada" currentImage={actual.image} />
            <ImageField
              id="s0-mobile"
              name="mobileImage"
              label="Portada para celular"
              currentImage={actual.mobileImage}
              hint="Opcional. Si no cargás ninguna, se usa la portada normal."
            />
          </div>
          <div class="adm-actions">
            <button type="submit" name="accion" value="guardar" class="adm-btn adm-btn--gold">
              <span class="material-symbols-outlined">check</span> Guardar
            </button>
            <span class="adm-actions__spacer"></span>
            <button
              type="submit"
              name="accion"
              value="borrar"
              formnovalidate
              data-confirm="¿Seguro que querés borrar la serie actual?"
              onclick="return confirm(this.dataset.confirm)"
              class="adm-btn adm-btn--danger"
            >
              <span class="material-symbols-outlined">delete</span> Borrar
            </button>
          </div>
        </div>
      </details>
    </form>
  )}

  <!-- ══════════ ANTERIORES ══════════ -->
  {anteriores.length > 0 && (
    <section class="adm-section">
      <div class="adm-toolbar">
        <h2 class="adm-h2" style="margin: 0">Series anteriores <span class="adm-count">{anteriores.length}</span></h2>
      </div>

      <div class="adm-rows" data-more-list>
        {anteriores.map((item, i) => {
          const index = i + 1;
          return (
            <form
              method="POST"
              action="/api/admin/series"
              enctype="multipart/form-data"
              class:list={['adm-card adm-row-item', i >= VISIBLES && !incompleta(item) && 'is-extra']}
            >
              <input type="hidden" name="indice" value={String(index)} />
              <details class="adm-fold">
                <summary class="adm-row">
                  <span class="adm-row__thumb">
                    {item.image ? <img src={item.image} alt="" loading="lazy" /> : <span class="material-symbols-outlined">image</span>}
                  </span>
                  <span class="adm-row__text">
                    <span class="adm-row__title">
                      {item.title}
                      {incompleta(item) && <span class="adm-badge adm-badge--warn">Incompleta</span>}
                    </span>
                    <span class="adm-row__sub">{item.subtitle}</span>
                  </span>
                  <span class="adm-row__actions">
                    <button type="submit" name="accion" value="destacar" formnovalidate class="adm-btn adm-btn--ghost adm-btn--sm" title="Pasa a ser la serie del inicio">
                      <span class="material-symbols-outlined">star</span><span class="adm-hide-sm">Hacer actual</span>
                    </button>
                    <span class="adm-row__chev material-symbols-outlined">expand_more</span>
                  </span>
                </summary>
                <div class="adm-row__body">
                  <div class="adm-grid2">
                    <Field id={`s${index}-title`} name="title" label="Nombre de la serie" value={item.title} required />
                    <Field id={`s${index}-subtitle`} name="subtitle" label="Bajada" value={item.subtitle} required />
                  </div>
                  <Field id={`s${index}-description`} name="description" label="Descripción" value={item.description} rows={3} required />
                  <Field id={`s${index}-href`} name="href" label="Link a la playlist de YouTube" value={item.href} type="url" required />
                  <ImageField id={`s${index}-image`} name="image" label="Portada" currentImage={item.image} />
                  <div class="adm-actions">
                    <button type="submit" name="accion" value="guardar" class="adm-btn adm-btn--gold">
                      <span class="material-symbols-outlined">check</span> Guardar
                    </button>
                    <span class="adm-actions__spacer"></span>
                    <button
                      type="submit"
                      name="accion"
                      value="borrar"
                      formnovalidate
                      data-confirm={`¿Seguro que querés borrar "${item.title}"?`}
                      onclick="return confirm(this.dataset.confirm)"
                      class="adm-btn adm-btn--danger"
                    >
                      <span class="material-symbols-outlined">delete</span> Borrar
                    </button>
                  </div>
                </div>
              </details>
            </form>
          );
        })}
      </div>

      {anteriores.length > VISIBLES && (
        <button type="button" class="adm-btn adm-btn--ghost adm-more" data-more>
          <span class="material-symbols-outlined">expand_more</span> Ver todas ({anteriores.length})
        </button>
      )}
    </section>
  )}
</AdminLayout>
