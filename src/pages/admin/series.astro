---
import Field from '../../components/admin/Field.astro';
import ImageField from '../../components/admin/ImageField.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSeries } from '../../lib/content/collections';
import { canEdit, denyRedirect, getSession } from '../../lib/admin-guard';

const session = getSession(Astro.locals);
if (!canEdit(session, 'series')) {
  return denyRedirect('No tenés acceso a las series.');
}

const series = await getSeries();
---

<AdminLayout title="Series de predicación" backHref="/admin" backLabel="Volver al panel" session={session}>
  <p class="-mt-4 mb-8 text-charcoal/65">
    La primera de la lista es la serie actual y se muestra grande en el inicio. Las demás aparecen abajo,
    como series anteriores.
  </p>

  <form method="POST" action="/api/admin/series" enctype="multipart/form-data" class="mb-8">
    <input type="hidden" name="accion" value="crear" />
    <button
      type="submit"
      class="inline-flex items-center gap-2 rounded-full bg-charcoal px-6 py-3 font-bold text-white transition-colors hover:bg-primary hover:text-charcoal"
    >
      <span class="material-symbols-outlined text-xl">add</span>
      Agregar una serie nueva
    </button>
  </form>

  <div class="flex flex-col gap-6">
    {
      series.map((item, index) => (
        <form
          method="POST"
          action="/api/admin/series"
          enctype="multipart/form-data"
          class="rounded-2xl border border-black/10 bg-white p-6 sm:p-8"
        >
          <input type="hidden" name="indice" value={String(index)} />

          <div class="mb-6 flex flex-wrap items-center gap-3">
            {index === 0 ? (
              <span class="rounded-full bg-primary/15 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-wider text-primary-dark">
                Serie actual
              </span>
            ) : (
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-charcoal/45">
                Serie anterior
              </span>
            )}

            {index > 0 && (
              <button
                type="submit"
                name="accion"
                value="destacar"
                formnovalidate
                class="rounded-full border border-black/15 px-4 py-1.5 text-sm font-semibold transition-colors hover:bg-black/5"
              >
                Hacerla la serie actual
              </button>
            )}
          </div>

          <Field name="title" label="Nombre de la serie" value={item.title} required />
          <Field name="subtitle" label="Bajada" value={item.subtitle} required />
          <Field name="description" label="Descripción" value={item.description} rows={3} required />
          <Field
            name="href"
            label="Link a la playlist de YouTube"
            value={item.href}
            type="url"
            required
          />
          <ImageField name="image" label="Portada" currentImage={item.image} />

          {index === 0 && (
            <ImageField
              name="mobileImage"
              label="Portada para celular"
              currentImage={item.mobileImage}
              hint="Opcional. Solo la serie actual la usa, porque se muestra a lo ancho. Si no cargás ninguna, se usa la portada normal."
            />
          )}

          <div class="mt-2 flex flex-wrap items-center gap-3">
            <button
              type="submit"
              name="accion"
              value="guardar"
              class="rounded-full bg-primary px-8 py-4 font-bold text-charcoal transition-colors hover:bg-primary-dark hover:text-white disabled:opacity-60"
            >
              Guardar
            </button>
            <button
              type="submit"
              name="accion"
              value="borrar"
              formnovalidate
              onclick="return confirm('¿Seguro que querés borrar esta serie?')"
              class="rounded-full border border-red-600/30 px-6 py-3 text-sm font-bold text-red-700 transition-colors hover:bg-red-50"
            >
              Borrar
            </button>
          </div>
        </form>
      ))
    }
  </div>
</AdminLayout>
