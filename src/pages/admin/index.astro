---
/**
 * Inicio del panel: el estado del sitio en números, acciones rápidas que
 * abren directo el modal de alta (`/admin/series#nueva-serie`) y accesos a
 * cada sección. Todo filtrado por lo que esa persona puede editar.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAnnouncements, getDevotionals, getMinistries, getSeries } from '../../lib/content/collections';
import { canEdit, getSession } from '../../lib/admin-guard';
import { ministrySectionKey } from '../../lib/content/sections';

const session = getSession(Astro.locals);
const [ministries, devotionals, series, announcements] = await Promise.all([
  getMinistries(),
  getDevotionals(),
  getSeries(),
  getAnnouncements(),
]);

const editableMinistries = ministries.filter((ministry) => canEdit(session, ministrySectionKey(ministry.slug)));
const avisos = editableMinistries.filter((m) => m.noticeTitle?.trim());

const stats = [
  canEdit(session, 'devocionales') && {
    icon: 'menu_book',
    value: devotionals.length,
    label: devotionals.length === 1 ? 'devocional publicado' : 'devocionales publicados',
    detail: devotionals[0] ? `Esta semana: ${devotionals[0].title}` : 'Ninguno todavía',
    href: '/admin/devocionales',
  },
  canEdit(session, 'series') && {
    icon: 'video_library',
    value: series.length,
    label: series.length === 1 ? 'serie' : 'series',
    detail: series[0] ? `Actual: ${series[0].title}` : 'Ninguna todavía',
    href: '/admin/series',
  },
  canEdit(session, 'anuncios') && {
    icon: 'campaign',
    value: announcements.length,
    label: announcements.length === 1 ? 'anuncio en el inicio' : 'anuncios en el inicio',
    detail: announcements[0] ? `Primero: ${announcements[0].title}` : 'Ninguno',
    href: '/admin/anuncios',
  },
  editableMinistries.length > 0 && {
    icon: 'diversity_3',
    value: avisos.length,
    label: avisos.length === 1 ? 'aviso de ministerio activo' : 'avisos de ministerios activos',
    detail: `${editableMinistries.length} ${editableMinistries.length === 1 ? 'ministerio' : 'ministerios'} a tu cargo`,
    href: undefined,
  },
].filter(Boolean) as { icon: string; value: number; label: string; detail: string; href?: string }[];

const quick = [
  canEdit(session, 'devocionales') && { href: '/admin/devocionales#nuevo-devocional', icon: 'edit_note', label: 'Publicar devocional' },
  canEdit(session, 'series') && { href: '/admin/series#nueva-serie', icon: 'add_photo_alternate', label: 'Agregar serie' },
  canEdit(session, 'anuncios') && { href: '/admin/anuncios#nuevo', icon: 'campaign', label: 'Nuevo anuncio' },
  session.role === 'admin' && { href: '/admin/usuarios#nueva-persona', icon: 'person_add', label: 'Dar acceso' },
].filter(Boolean) as { href: string; icon: string; label: string }[];

const hasNothing = stats.length === 0;
---

<AdminLayout title={`Hola, ${session.username}`} session={session}>
  <p class="adm-lead">Así está el sitio hoy.</p>

  {hasNothing && (
    <div class="adm-card adm-empty">
      <span class="material-symbols-outlined">lock</span>
      <p>
        Todavía no tenés ninguna sección asignada. Pedile a la persona que administra el panel que te dé
        acceso.
      </p>
    </div>
  )}

  {stats.length > 0 && (
    <div class="adm-kpis">
      {stats.map((s) =>
        s.href ? (
          <a class="adm-card adm-kpi" href={s.href}>
            <span class="adm-kpi__icon material-symbols-outlined">{s.icon}</span>
            <strong>{s.value}</strong>
            <span class="adm-kpi__label">{s.label}</span>
            <span class="adm-kpi__detail">{s.detail}</span>
          </a>
        ) : (
          <div class="adm-card adm-kpi">
            <span class="adm-kpi__icon material-symbols-outlined">{s.icon}</span>
            <strong>{s.value}</strong>
            <span class="adm-kpi__label">{s.label}</span>
            <span class="adm-kpi__detail">{s.detail}</span>
          </div>
        ),
      )}
    </div>
  )}

  {quick.length > 0 && (
    <section class="adm-section">
      <p class="adm-eyebrow">Acciones rápidas</p>
      <div class="adm-quick">
        {quick.map((q) => (
          <a class="adm-quick__btn" href={q.href}>
            <span class="material-symbols-outlined">{q.icon}</span>
            {q.label}
          </a>
        ))}
      </div>
    </section>
  )}

  {editableMinistries.length > 0 && (
    <section class="adm-section">
      <p class="adm-eyebrow">Ministerios</p>
      <div class="adm-card adm-table">
        {editableMinistries.map((ministry) => (
          <a class="adm-table__row adm-table__row--link" href={`/admin/ministerios/${ministry.slug}`}>
            <div class="adm-table__main">
              <img class="adm-table__logo" src={ministry.image} alt="" />
              <span class="adm-row__text">
                <span class="adm-row__title">{ministry.name}</span>
                <span class="adm-row__sub">{ministry.area}</span>
              </span>
            </div>
            <span>
              {ministry.noticeTitle ? (
                <span class="adm-badge adm-badge--ok"><span class="material-symbols-outlined">campaign</span><span class="adm-hide-sm">{ministry.noticeTitle}</span></span>
              ) : (
                <span class="adm-muted adm-hide-sm">Sin aviso</span>
              )}
            </span>
            <span class="material-symbols-outlined adm-table__chev">chevron_right</span>
          </a>
        ))}
      </div>
    </section>
  )}
</AdminLayout>
