---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getMinistries } from '../../lib/content/collections';
import { canEdit, getSession } from '../../lib/admin-guard';
import { ministrySectionKey } from '../../lib/content/sections';

const session = getSession(Astro.locals);
const ministries = await getMinistries();

const tasks = [
  {
    section: 'devocionales',
    href: '/admin/devocionales',
    icon: 'menu_book',
    title: 'Devocionales y testimonios',
    description: 'Publicar el devocional de la semana o cargar un testimonio.',
  },
  {
    section: 'anuncios',
    href: '/admin/anuncios',
    icon: 'campaign',
    title: 'Anuncios del inicio',
    description: 'Los avisos que aparecen en la página principal.',
  },
  {
    section: 'series',
    href: '/admin/series',
    icon: 'video_library',
    title: 'Series de predicación',
    description: 'Cambiar la serie actual y las anteriores.',
  },
].filter((task) => canEdit(session, task.section));

const editableMinistries = ministries.filter((ministry) =>
  canEdit(session, ministrySectionKey(ministry.slug))
);

const hasNothing = tasks.length === 0 && editableMinistries.length === 0;
---

<AdminLayout title={`Hola, ${session.username}`} session={session}>
  <p class="adm-lead">¿Qué querés editar hoy?</p>

  {hasNothing && (
    <div class="adm-card" style="padding: 24px">
      <p style="margin: 0; color: var(--soft)">
        Todavía no tenés ninguna sección asignada. Pedile a la persona que administra el panel que te dé
        acceso.
      </p>
    </div>
  )}

  {tasks.length > 0 && (
    <section>
      <p class="adm-eyebrow">Contenido</p>
      <div class="adm-tiles">
        {tasks.map((task) => (
          <a href={task.href} class="adm-card adm-tile">
            <span class="adm-tile__icon"><span class="material-symbols-outlined">{task.icon}</span></span>
            <span class="adm-tile__title">{task.title}</span>
            <span class="adm-tile__text">{task.description}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {editableMinistries.length > 0 && (
    <section class="adm-section">
      <p class="adm-eyebrow">Ministerios</p>
      <div class="adm-mins">
        {editableMinistries.map((ministry) => (
          <a href={`/admin/ministerios/${ministry.slug}`} class="adm-card adm-min">
            <img src={ministry.image} alt="" />
            <span>
              <strong>{ministry.name}</strong>
              <span>
                {ministry.noticeTitle ? `Aviso: ${ministry.noticeTitle}` : ministry.area}
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {session.role === 'admin' && (
    <section class="adm-section">
      <p class="adm-eyebrow">Administración</p>
      <div class="adm-tiles">
        <a href="/admin/usuarios" class="adm-card adm-tile">
          <span class="adm-tile__icon"><span class="material-symbols-outlined">group</span></span>
          <span class="adm-tile__title">Personas con acceso</span>
          <span class="adm-tile__text">Dar acceso a alguien nuevo, elegir qué puede editar o sacarle el acceso.</span>
        </a>
      </div>
    </section>
  )}
</AdminLayout>
