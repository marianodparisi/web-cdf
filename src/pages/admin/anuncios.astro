---
import Field from '../../components/admin/Field.astro';
import ImageField from '../../components/admin/ImageField.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAnnouncements } from '../../lib/content/collections';
import { canEdit, denyRedirect, getSession } from '../../lib/admin-guard';

const session = getSession(Astro.locals);
if (!canEdit(session, 'anuncios')) {
  return denyRedirect('No tenés acceso a los anuncios.');
}

const announcements = await getAnnouncements();
---

<AdminLayout title="Anuncios del inicio" backHref="/admin" backLabel="Volver al panel" session={session}>
  <p class="-mt-4 mb-8 text-charcoal/65">
    Son los tres avisos de la página principal. Se editan de a uno y cada uno tiene su propio botón de
    guardar.
  </p>

  <div class="flex flex-col gap-6">
    {
      announcements.map((item, index) => (
        <form
          method="POST"
          action="/api/admin/anuncios"
          enctype="multipart/form-data"
          class="rounded-2xl border border-black/10 bg-white p-6 sm:p-8"
        >
          <input type="hidden" name="indice" value={String(index)} />

          <p class="mb-6 text-xs font-bold uppercase tracking-[0.2em] text-primary">
            Anuncio {index + 1}
          </p>

          <Field name="eyebrow" label="Etiqueta chica" value={item.eyebrow} hint="Va arriba del título, en dorado." required />
          <Field name="title" label="Título" value={item.title} required />
          <Field name="description" label="Descripción" value={item.description} rows={3} required />
          <Field
            name="href"
            label="A dónde lleva"
            value={item.href}
            hint="Puede ser una página del sitio, como /ministerios/kids, o un link completo a otro lado."
            required
          />
          <ImageField
            name="image"
            label="Flyer o foto"
            currentImage={item.image}
            hint="Se muestra entero, sin recortar, así no se pierde el texto del flyer."
          />

          <button
            type="submit"
            class="mt-2 rounded-full bg-primary px-8 py-4 font-bold text-charcoal transition-colors hover:bg-primary-dark hover:text-white disabled:opacity-60"
          >
            Guardar este anuncio
          </button>
        </form>
      ))
    }
  </div>
</AdminLayout>
