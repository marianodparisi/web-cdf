---
/**
 * Personas con acceso. Una fila por persona con lo que puede editar a la
 * vista; al tocarla se despliega la edición. Los formularios mandan los mismos
 * campos de siempre a `/api/admin/usuarios`, que es quien valida todo (último
 * admin, contraseña corta, usuario repetido).
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import SectionPicker from '../../components/admin/SectionPicker.astro';
import Modal from '../../components/admin/Modal.astro';
import { listAdminUsers } from '../../lib/admin-auth';
import { denyRedirect, getSession } from '../../lib/admin-guard';
import { getSectionCatalog } from '../../lib/content/sections';

const session = getSession(Astro.locals);
if (session.role !== 'admin') {
  return denyRedirect('Solo un administrador puede gestionar los accesos.');
}

const [users, catalog] = await Promise.all([listAdminUsers(), getSectionCatalog()]);
const labelOf = new Map(catalog.map((s) => [s.key, s.label]));

const admins = users.filter((u) => u.role === 'admin').length;
const neverIn = users.filter((u) => !u.lastLoginAt).length;

// Sin `timeZone`: el DATETIME viene sin zona y se muestra tal cual lo guardó la
// base, que es la hora que la persona tiene en la cabeza.
const dateFormatter = new Intl.DateTimeFormat('es-AR', { dateStyle: 'medium', timeStyle: 'short' });

const hueOf = (name: string) => [...name].reduce((sum, c) => sum + c.charCodeAt(0), 0) % 360;
---

<AdminLayout title="Personas con acceso" backHref="/admin" backLabel="Volver al panel" session={session}>
  <p class="adm-lead">
    Un administrador entra a todo. Un editor ve sólo las secciones que le marques: por ejemplo, quien lidera
    Kids puede entrar únicamente a Kids.
  </p>

  <div class="adm-stats">
    <div class="adm-card adm-stat"><strong>{users.length}</strong><span>personas con acceso</span></div>
    <div class="adm-card adm-stat"><strong>{admins}</strong><span>{admins === 1 ? 'administrador' : 'administradores'}</span></div>
    <div class="adm-card adm-stat"><strong>{neverIn}</strong><span>nunca entraron</span></div>
  </div>

  <!-- ══════════ NUEVA PERSONA ══════════ Modal. -->
  <Modal id="nueva-persona" title="Dar acceso a alguien nuevo" subtitle="Creá su usuario y elegí qué puede editar.">
    <form method="POST" action="/api/admin/usuarios" class="adm-modal__form">
      <input type="hidden" name="accion" value="crear" />
      <div class="adm-modal__body">

      <div class="adm-grid2">
        <div class="adm-field">
          <label class="adm-label" for="username">Usuario</label>
          <input id="username" name="username" required class="adm-input" autocomplete="off" placeholder="Ej: lucia.kids" />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="email">Email <small>(opcional)</small></label>
          <input id="email" name="email" type="email" class="adm-input" autocomplete="off" />
        </div>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="new-password">Contraseña</label>
        <p class="adm-help">Mínimo 8 caracteres. Generala y pasásela a la persona; después la puede cambiar ella.</p>
        <div class="adm-pass">
          <input id="new-password" name="password" type="text" minlength="8" required class="adm-input" autocomplete="new-password" />
          <button type="button" class="adm-btn adm-btn--ghost" data-gen-pass="new-password">
            <span class="material-symbols-outlined">key</span> Generar
          </button>
        </div>
      </div>

      <p class="adm-label">¿Qué puede editar?</p>
      <SectionPicker catalog={catalog} idPrefix="nuevo" />

      </div>
      <footer class="adm-modal__foot">
        <button type="button" class="adm-btn adm-btn--ghost" data-modal-close>Cancelar</button>
        <button type="submit" class="adm-btn adm-btn--gold">
          <span class="material-symbols-outlined">check</span> Crear el acceso
        </button>
      </footer>
    </form>
  </Modal>

  <!-- ══════════ LISTA ══════════ -->
  <div class="adm-toolbar">
    <h2 class="adm-h2" style="margin: 0">Accesos actuales</h2>
    <button type="button" class="adm-btn adm-btn--gold" data-modal-open="nueva-persona">
      <span class="material-symbols-outlined">person_add</span> Dar acceso a alguien nuevo
    </button>
    {users.length > 5 && (
      <label class="adm-search">
        <span class="material-symbols-outlined">search</span>
        <input class="adm-input" type="search" placeholder="Buscar por nombre o email" data-people-search aria-label="Buscar personas" />
      </label>
    )}
  </div>

  <div class="adm-card adm-table">
    <div class="adm-table__head adm-table__head--people">
      <span>Persona</span>
      <span class="adm-hide-sm">Puede editar</span>
      <span class="adm-hide-sm">Último ingreso</span>
      <span></span>
    </div>
    {users.map((user) => {
      const isMe = user.username === session.username;
      const chips = user.sections.map((key) => labelOf.get(key)).filter(Boolean) as string[];
      return (
        <div class="adm-table__row adm-table__row--people" data-person={`${user.username} ${user.email ?? ''}`.toLowerCase()}>
          <div class="adm-table__main">
            <span class="adm-avatar" style={`--h: ${hueOf(user.username)}`}>{user.username.slice(0, 2).toUpperCase()}</span>
            <span class="adm-row__text">
              <span class="adm-row__title">
                {user.username}
                {user.role === 'admin' ? (
                  <span class="adm-badge adm-badge--admin"><span class="material-symbols-outlined">shield_person</span>Admin</span>
                ) : (
                  <span class="adm-badge adm-badge--editor">Editor</span>
                )}
                {isMe && <span class="adm-badge adm-badge--you">Vos</span>}
              </span>
              <span class="adm-row__sub">{user.email ?? 'Sin email'}</span>
            </span>
          </div>
          <div class="adm-table__chips adm-hide-sm">
            {user.role === 'admin' ? (
              <span class="adm-chip">Todo</span>
            ) : chips.length === 0 ? (
              <span class="adm-muted">Nada asignado</span>
            ) : (
              <>
                {chips.slice(0, 3).map((label) => <span class="adm-chip">{label}</span>)}
                {chips.length > 3 && <span class="adm-chip">+{chips.length - 3}</span>}
              </>
            )}
          </div>
          <span class="adm-table__date adm-hide-sm">
            {user.lastLoginAt ? dateFormatter.format(user.lastLoginAt) : <span class="adm-muted">Nunca entró</span>}
          </span>
          <div class="adm-row__actions">
            <button type="button" class="adm-btn adm-btn--ghost adm-btn--sm" data-modal-open={`persona-${user.id}`}>
              <span class="material-symbols-outlined">edit</span><span class="adm-hide-sm">Editar</span>
            </button>
          </div>
        </div>
      );
    })}
  </div>

  {users.map((user) => {
    const isMe = user.username === session.username;
    return (
      <Modal id={`persona-${user.id}`} title={`Accesos de ${user.username}`} subtitle={user.email ?? undefined}>
        <form method="POST" action="/api/admin/usuarios" class="adm-modal__form">
          <input type="hidden" name="id" value={String(user.id)} />
          <div class="adm-modal__body">
            <SectionPicker catalog={catalog} role={user.role} selected={user.sections} idPrefix={`u${user.id}`} />
            <div class="adm-field">
              <label class="adm-label" for={`password-${user.id}`}>Cambiarle la contraseña <small>(opcional)</small></label>
              <p class="adm-help">Dejalo vacío para no tocarla.</p>
              <div class="adm-pass">
                <input id={`password-${user.id}`} name="password" type="text" minlength="8" class="adm-input" autocomplete="new-password" />
                <button type="button" class="adm-btn adm-btn--ghost" data-gen-pass={`password-${user.id}`}>
                  <span class="material-symbols-outlined">key</span> Generar
                </button>
              </div>
            </div>
          </div>
          <footer class="adm-modal__foot">
            {!isMe && (
              <button
                type="submit"
                name="accion"
                value="borrar"
                formnovalidate
                data-confirm={`¿Sacarle el acceso a ${user.username}?`}
                onclick="return confirm(this.dataset.confirm)"
                class="adm-btn adm-btn--danger adm-modal__left"
              >
                <span class="material-symbols-outlined">person_remove</span><span class="adm-hide-sm">Sacar el acceso</span>
              </button>
            )}
            <button type="button" class="adm-btn adm-btn--ghost" data-modal-close>Cancelar</button>
            <button type="submit" name="accion" value="guardar" class="adm-btn adm-btn--gold">
              <span class="material-symbols-outlined">check</span> Guardar
            </button>
          </footer>
        </form>
      </Modal>
    );
  })}
</AdminLayout>
