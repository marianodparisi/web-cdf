---
/**
 * Escribir o editar un devocional. El texto va en la columna ancha; foto,
 * tipo, video y el botón de guardar en una columna lateral que acompaña el
 * scroll, así guardar no exige bajar hasta el final de una nota larga.
 * Manda los mismos campos que antes a `/api/admin/devocionales`.
 */
import Field from '../../../components/admin/Field.astro';
import ImageField from '../../../components/admin/ImageField.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDevotionalBySlug, paragraphsToText } from '../../../lib/content/collections';
import { canEdit, denyRedirect, getSession } from '../../../lib/admin-guard';

const session = getSession(Astro.locals);
if (!canEdit(session, 'devocionales')) {
  return denyRedirect('No tenés acceso a los devocionales.');
}

const { slug } = Astro.params;
const isNew = slug === 'nuevo';
const post = isNew ? null : await getDevotionalBySlug(slug);

if (!isNew && !post) {
  return denyRedirect('Ese devocional ya no existe.');
}

const title = isNew ? 'Publicar un devocional' : 'Editar devocional';
const isTestimonio = post?.type === 'Testimonio';
---

<AdminLayout title={title} backHref="/admin/devocionales" backLabel="Volver a la lista" session={session}>
  <form
    method="POST"
    action="/api/admin/devocionales"
    enctype="multipart/form-data"
    data-warn-unsaved
    class="adm-editor"
  >
    <input type="hidden" name="accion" value="guardar" />
    <input type="hidden" name="slug" value={post?.slug ?? ''} />

    <div class="adm-card adm-editor__main">
      <Field name="title" label="Título" value={post?.title ?? ''} required />
      <Field
        name="weekLabel"
        label="Referencia"
        value={post?.weekLabel ?? ''}
        hint="La cita bíblica o la semana. Por ejemplo: Malaquías 1:6-7, o Semana 3 - Marzo."
        required
      />
      <Field
        name="excerpt"
        label="Resumen corto"
        value={post?.excerpt ?? ''}
        rows={3}
        hint="Dos o tres líneas. Es lo que se lee en la portada, antes de entrar a la nota."
        required
      />
      <Field
        name="content"
        label="El texto completo"
        value={post ? paragraphsToText(post.content) : ''}
        rows={18}
        hint="Dejá una línea en blanco entre párrafo y párrafo. Así se separan en el sitio."
        required
      />
    </div>

    <aside class="adm-editor__side">
      <div class="adm-card adm-editor__box adm-editor__save">
        <button type="submit" class="adm-btn adm-btn--gold">
          <span class="material-symbols-outlined">check</span> {isNew ? 'Publicar' : 'Guardar cambios'}
        </button>
        {post && (
          <a class="adm-btn adm-btn--ghost" href={`/devocional/${post.slug}`} target="_blank" rel="noopener noreferrer">
            <span class="material-symbols-outlined">open_in_new</span> Ver en el sitio
          </a>
        )}
        <a class="adm-editor__cancel" href="/admin/devocionales">Cancelar</a>
      </div>
      <div class="adm-card adm-editor__box">
        <p class="adm-label">¿Qué es?</p>
        <div class="adm-seg adm-seg--full" role="radiogroup" aria-label="Tipo">
          <label><input type="radio" name="type" value="Devocional" checked={!isTestimonio} /> Devocional</label>
          <label><input type="radio" name="type" value="Testimonio" checked={isTestimonio} /> Testimonio</label>
        </div>
      </div>

      <div class="adm-card adm-editor__box">
        <ImageField name="image" label="Foto" currentImage={post?.image} />
      </div>

      <div class="adm-card adm-editor__box">
        <Field
          name="videoUrl"
          label="Video de YouTube"
          value={post?.videoUrl ?? ''}
          type="url"
          hint="Si lo dejás vacío, no se muestra ningún video."
          placeholder="https://www.youtube.com/..."
        />
      </div>

    </aside>
  </form>

  {post && (
    <form
      method="POST"
      action="/api/admin/devocionales"
      class="adm-danger-zone"
      onsubmit="return confirm('¿Seguro que querés borrarlo? No se puede deshacer desde el panel.')"
    >
      <input type="hidden" name="accion" value="borrar" />
      <input type="hidden" name="slug" value={post.slug} />
      <div>
        <strong>Borrar este devocional</strong>
        <span>Deja de verse en el sitio.</span>
      </div>
      <button type="submit" class="adm-btn adm-btn--danger">
        <span class="material-symbols-outlined">delete</span> Borrar
      </button>
    </form>
  )}
</AdminLayout>
