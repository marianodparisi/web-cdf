---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDevotionals } from '../../../lib/content/collections';
import { canEdit, denyRedirect, getSession } from '../../../lib/admin-guard';

const session = getSession(Astro.locals);
if (!canEdit(session, 'devocionales')) {
  return denyRedirect('No tenés acceso a los devocionales.');
}

const posts = await getDevotionals();
---

<AdminLayout title="Devocionales y testimonios" backHref="/admin" backLabel="Volver al panel" session={session}>
  <p class="-mt-4 mb-8 text-charcoal/65">
    El primero de la lista es el que se muestra como devocional de la semana, en el inicio y arriba de todo
    en la sección Devocional.
  </p>

  <a
    href="/admin/devocionales/nuevo"
    class="mb-8 inline-flex items-center gap-2 rounded-full bg-charcoal px-6 py-3 font-bold text-white transition-colors hover:bg-primary hover:text-charcoal"
  >
    <span class="material-symbols-outlined text-xl">add</span>
    Publicar uno nuevo
  </a>

  <ul class="flex flex-col gap-3">
    {
      posts.map((post, index) => (
        <li class="flex items-center gap-4 rounded-2xl border border-black/10 bg-white p-4">
          <img src={post.image} alt="" class="h-16 w-16 shrink-0 rounded-xl border border-black/10 object-cover" />

          <div class="min-w-0 flex-1">
            {index === 0 && (
              <span class="mb-1 inline-block rounded-full bg-primary/15 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-wider text-primary-dark">
                Se muestra ahora
              </span>
            )}
            <p class="truncate font-semibold">{post.title}</p>
            <p class="truncate text-sm text-charcoal/55">
              {post.type} · {post.weekLabel}
            </p>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            {index > 0 && (
              <form method="POST" action="/api/admin/devocionales">
                <input type="hidden" name="accion" value="subir" />
                <input type="hidden" name="slug" value={post.slug} />
                <button
                  type="submit"
                  title="Mover arriba"
                  aria-label={`Mover ${post.title} hacia arriba`}
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-black/10 transition-colors hover:bg-black/5"
                >
                  <span class="material-symbols-outlined text-xl">arrow_upward</span>
                </button>
              </form>
            )}
            <a
              href={`/admin/devocionales/${post.slug}`}
              class="rounded-full bg-charcoal px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-primary hover:text-charcoal"
            >
              Editar
            </a>
          </div>
        </li>
      ))
    }
  </ul>

  {posts.length === 0 && <p class="text-charcoal/60">Todavía no hay ninguno publicado.</p>}
</AdminLayout>
