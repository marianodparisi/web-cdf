---
/**
 * Lista de devocionales y testimonios. El primero es el de la semana y va
 * destacado; el resto en lista, con filtro por tipo, buscador y "Ver más"
 * para que la pantalla no crezca sin fin. Reordenar sigue siendo "subir"
 * (`/api/admin/devocionales`, accion=subir).
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDevotionals } from '../../../lib/content/collections';
import { canEdit, denyRedirect, getSession } from '../../../lib/admin-guard';

const session = getSession(Astro.locals);
if (!canEdit(session, 'devocionales')) {
  return denyRedirect('No tenés acceso a los devocionales.');
}

const posts = await getDevotionals();
const [semana, ...resto] = posts;
const VISIBLES = 8;
const cuenta = (tipo: string) => resto.filter((p) => p.type === tipo).length;
---

<AdminLayout title="Devocionales y testimonios" backHref="/admin" backLabel="Volver al panel" session={session}>
  <div class="adm-toolbar adm-toolbar--lead">
    <p class="adm-lead" style="margin: 0">
      El primero de la lista es el de la semana: se ve en el inicio y arriba de todo en la sección Devocional.
    </p>
    <a href="/admin/devocionales/nuevo" class="adm-btn adm-btn--gold">
      <span class="material-symbols-outlined">add</span> Publicar uno nuevo
    </a>
  </div>

  {posts.length === 0 && (
    <div class="adm-card adm-empty">
      <span class="material-symbols-outlined">menu_book</span>
      <p>Todavía no hay ninguno publicado.</p>
    </div>
  )}

  <!-- ══════════ ESTA SEMANA ══════════ -->
  {semana && (
    <a href={`/admin/devocionales/${semana.slug}`} class="adm-card adm-feature adm-feature--link">
      <div class="adm-feature__top">
        <div class="adm-feature__cover">
          {semana.image ? <img src={semana.image} alt="" /> : <span class="material-symbols-outlined">image</span>}
        </div>
        <div class="adm-feature__info">
          <span class="adm-badge adm-badge--admin"><span class="material-symbols-outlined">star</span>Se muestra esta semana</span>
          <h2 class="adm-feature__title">{semana.title}</h2>
          <p class="adm-feature__sub">{semana.type} · {semana.weekLabel}</p>
          <p class="adm-feature__excerpt">{semana.excerpt}</p>
          <span class="adm-btn adm-btn--ghost adm-btn--sm" style="justify-self: start">
            <span class="material-symbols-outlined">edit</span> Editar
          </span>
        </div>
      </div>
    </a>
  )}

  <!-- ══════════ ANTERIORES ══════════ -->
  {resto.length > 0 && (
    <section class="adm-section" data-filter-scope>
      <div class="adm-toolbar">
        <div class="adm-seg" role="group" aria-label="Filtrar por tipo">
          <button type="button" class="is-on" data-filter="">Todos <span>{resto.length}</span></button>
          <button type="button" data-filter="Devocional">Devocionales <span>{cuenta('Devocional')}</span></button>
          <button type="button" data-filter="Testimonio">Testimonios <span>{cuenta('Testimonio')}</span></button>
        </div>
        {resto.length > 5 && (
          <label class="adm-search">
            <span class="material-symbols-outlined">search</span>
            <input class="adm-input" type="search" placeholder="Buscar por título" data-filter-search aria-label="Buscar" />
          </label>
        )}
      </div>

      <ul class="adm-rows" data-more-list>
        {resto.map((post, i) => (
          <li
            class:list={['adm-card adm-row adm-row--static', i >= VISIBLES && 'is-extra']}
            data-type={post.type}
            data-text={`${post.title} ${post.weekLabel}`.toLowerCase()}
          >
            <span class="adm-row__thumb adm-row__thumb--sq">
              {post.image ? <img src={post.image} alt="" loading="lazy" /> : <span class="material-symbols-outlined">image</span>}
            </span>
            <a class="adm-row__text" href={`/admin/devocionales/${post.slug}`}>
              <span class="adm-row__title">
                {post.title}
                <span class:list={['adm-badge', post.type === 'Testimonio' ? 'adm-badge--info' : 'adm-badge--editor']}>{post.type}</span>
              </span>
              <span class="adm-row__sub">{post.weekLabel}</span>
            </a>
            <span class="adm-row__actions">
              <form method="POST" action="/api/admin/devocionales">
                <input type="hidden" name="accion" value="subir" />
                <input type="hidden" name="slug" value={post.slug} />
                <button type="submit" class="adm-icon-btn" title="Subir un lugar" aria-label={`Subir ${post.title} un lugar`}>
                  <span class="material-symbols-outlined">arrow_upward</span>
                </button>
              </form>
              <a href={`/admin/devocionales/${post.slug}`} class="adm-btn adm-btn--ghost adm-btn--sm">
                <span class="material-symbols-outlined">edit</span><span class="adm-hide-sm">Editar</span>
              </a>
            </span>
          </li>
        ))}
      </ul>
      <p class="adm-none" hidden data-filter-none>No hay resultados con ese filtro.</p>

      {resto.length > VISIBLES && (
        <button type="button" class="adm-btn adm-btn--ghost adm-more" data-more>
          <span class="material-symbols-outlined">expand_more</span> Ver más ({resto.length - VISIBLES})
        </button>
      )}
    </section>
  )}
</AdminLayout>
