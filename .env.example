# Directorio de datos persistente (contenido, historial e imagenes subidas).
# Tiene que estar FUERA de dist/, que se borra en cada deploy.
CDF_DATA_DIR=./.data

# Sesiones del panel
AUTH_SECRET=cdf-local-dev-auth-secret-change-me

# Primer usuario admin. Se crea solo si no existe todavia.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# MySQL: usuarios y permisos del panel
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=web_cdf
MYSQL_USER=root
MYSQL_PASSWORD=

# YouTube: handle del canal para resolver el ultimo vivo (sin API key).
# Se usa la ruta /@handle/live, que devuelve el vivo en curso o el ultimo hecho.
YOUTUBE_HANDLE=@CorazóndeFuego
